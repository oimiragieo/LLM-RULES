LPT9

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
ENV/

# Dependency Locks (using pnpm, ignore npm/yarn locks)
package-lock.json
yarn.lock
# pnpm-lock.yaml  # Keep pnpm lock tracked

# Backup files
*.backup
*.bak
*.old
.claude/lib/_test-fixtures/backups/
# .env backups (contain secrets — never commit)
.claude/context/backups/

# Consolidated test directories (data/temp generated during tests)
tests/data/
tests/temp/
# Keep fixtures directory structure  (contains static test data)
!tests/fixtures/.gitkeep
tests/fixtures/hybrid-search-cli/
tests/fixtures/install-security-test/
tests/fixtures/outside-target/
tests/fixtures/code-indexing/hook-test/.claude/context/code-index/

# Old fragmented test directories (DEPRECATED - moved to tests/)
.test-data/
.test-temp/
test-fixtures/

# Archive folder (old .claude backup)
.claude.archive/

# Worktree isolation directories (agent-spawned isolated worktrees; never commit)
.claude/worktrees/

# Runtime PID/delegation artifacts (auto-generated by agent task delegation system)
.claude/context/memory/delegations.pid-*.json

# Context data stores (generated databases; not source-controlled)
.claude/context/data/memory.db
.claude/context/data/*.db

# Workflow runtime checkpoints (generated during test runs and workflow execution)
.claude/context/workflows/

# AI slop files (malformed absolute paths from agents)
# Agents using absolute paths like C:\dev\... create concatenated filenames
C:*
C\:*
*devprojectsagent-studio*
tests/lib/memory/.test-lancedb/

# Root-level debug/temp txt files from session analysis scripts
clean_errors.txt
reduced_log_5.txt
temp_debug_log_5.txt
test_out.txt
f1326443-clean.txt
*-clean.txt
*_clean.txt
temp_debug_*.txt

# Test temp directories with random suffixes
tests/lib/memory/.test-memory-contracts-overflow-*/
tests/lib/memory/.test-memory-contracts-*/

# FastEmbed test artifacts
.claude/data/test-fastembed-gpu-*

# Runtime memory index files (auto-regenerated, not source-controlled)
.claude/context/memory/agent-health.json
.claude/context/memory/codebase_map.json

# Scheduled tasks lock file (runtime artifact; not source-controlled)
.claude/scheduled_tasks.lock

# ProcessRegistry default checkpoint file (runtime artifact; generated when checkpoint() called without args)
.process-registry-checkpoint.json
