# Archive (cleanup items for potential restoration)
.claude/.archive/

# Personal Configuration (Not Team-Shared)
.claude/_cfg/settings.local.yaml
.claude/_cfg/settings.local.json
.claude/_cfg/.env
.claude/_cfg/agents/*-local.md
.claude/_cfg/workflows/*-local.yaml

# Claude Code Session Data
.claude/context/session.json
# Artifacts: ignore everything except vetted reference artifacts and catalogs
.claude/context/artifacts/**
!.claude/context/artifacts/.gitkeep
!.claude/context/artifacts/catalogs/
!.claude/context/artifacts/catalogs/**
!.claude/context/artifacts/reference/
!.claude/context/artifacts/reference/**
!.claude/context/artifacts/diagrams/
!.claude/context/artifacts/diagrams/**

# Runtime data (gitignored)
.claude/context/runtime/
.claude/context/analytics/
.claude/context/audit/
.claude/context/logs/
.claude/context/reports/
.claude/context/payloads/
.claude/context/tasks/
.claude/context/todos/
.claude/context/plans/
.claude/context/test-results/
.claude/context/self-healing/anomaly-log.jsonl
.claude/context/self-healing/anomaly-state.json
.claude/context/reflection-queue.jsonl

# Memory tier files (session-specific runtime data)
# Ignore contents but keep directory structure via .gitkeep
.claude/context/memory/stm/*
!.claude/context/memory/stm/.gitkeep
.claude/context/memory/mtm/*
!.claude/context/memory/mtm/.gitkeep
.claude/context/memory/ltm/*
!.claude/context/memory/ltm/.gitkeep
.claude/context/memory/sessions/*
!.claude/context/memory/sessions/.gitkeep
# ML runtime state (models, policies, session logs)
.claude/context/ml/*
!.claude/context/ml/.gitkeep
# Access tracking timestamp (runtime artifact)
.claude/context/memory/.access-tracking-timestamp
# Memory health metrics (generated on UserPromptSubmit)
.claude/context/memory/metrics/
# Legacy/orphan vector DBs (LanceDB uses .claude/data/lancedb)
.claude/context/memory/vectors.db
.claude/context/memory/vectors.db_placeholder

# Runtime state files (auto-generated during sessions)
.claude/context/memory/access-stats.json
.claude/context/metrics/
.claude/context/self-healing/loop-state.json
.claude/data/memory.db

# Metrics and staging files (auto-generated)
.claude/lib/utils/.claude/staging/metrics/
.claude/staging/*
!.claude/staging/.gitkeep
.claude/context/memory/open-findings.json
tests/lib/memory/.test-memory-soak-chaos-*/
tests/lib/memory/.stress-memory/.claude/context/memory/.tmp-*
tests/lib/memory/.stress-memory/
tests/lib/memory/.test-memory-contracts/
*.jsonl

# Memory and LanceDB data (runtime)
.claude/data/*.db
# LanceDB vector index (generated, excludes all transaction/version/data files)
.claude/context/data/lancedb/
# BM25 index (generated from code indexer)
.claude/context/data/lancedb/bm25-index.json
.claude/context/data/lancedb/bm25-index.json.backup

# Config data (version-controlled) - NEW PATTERNS
!.claude/context/config/
!.claude/context/config/**

# Legacy patterns (to be removed after cutover)
.claude/context/history/reasoning/**/*.json
.claude/context/history/gates/**/*.json
.claude/context/blackboard/*.json
.claude/context/runs/
.claude/context/cache/
# Local model cache (embedding models; too large for repo)
local_cache/
.claude/context/code-index/.indexing.lock
.claude/context/code-index/hybrid-search-daemon.json
.claude/context/rule-index-cache.json
.claude/context/skill-summaries.json

# Test run artifacts (unit/integration tests create timestamped dirs; avoid committing leftovers)
.claude/context/test-contextual-memory-*/
.claude/context/test-e2e-*/
.claude/data/test-contextual-memory-*.db
.claude/data/test-contextual-memory-integration-*.db
.claude/data/test-e2e-*.db
.claude/data/test-*.db

# SQLite WAL/shm (often locked; test and runtime artifacts)
*.db-shm
*.db-wal

# Memory test temp directories (tests/lib/memory/)
tests/lib/.test-memory/

# Context session files (runtime data)
context/sessions/

# Bare context/ directory (escape from test paths - should never exist at root)
/context/

# Local Settings
.claude/settings.local.json
.cursor/settings.local.json
.factory/

# Ralph (runtime/cache; .cursor/.ralph/progress.md and guardrails.md are tracked)
.cursor/.ralph/.iteration
.cursor/.ralph/tasks.yaml
.cursor/.ralph/.parser_fifo

# Environment Variables
.env
.env.local
.env.*.local
.env.minimal

# Secrets and Credentials
**/secrets/
**/*.key
**/*.pem
**/credentials.json

# Node Modules
node_modules/
.pnpm-store/

# Build Outputs
dist/
build/
out/
.next/
.nuxt/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

