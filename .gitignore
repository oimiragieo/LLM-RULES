Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test Coverage
coverage/
.nyc_output/

# Test Artifacts
test-results/

# Temporary Files
tmp/
temp/
.tmp/
.opencode.disabled/
.factory.disabled/
*.tmp
tmpclaude-*
.claude/tools/tmpclaude-*
.claude/context/tmp/*.txt
# Diagnostics runner (should live under .claude/context/, but ignore root spills)
DIAGNOSTICS_*.md
DIAGNOSTICS_*.json

