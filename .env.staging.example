# ============================================================================
# Agent-Studio Staging Environment Configuration
# ============================================================================
# This file configures staging environment with all Phase 5 ML features enabled
# Copy to .env.staging for local staging testing
# NOTE: .env.staging is gitignored and will NOT be committed
#
# Version: 2.2.2
# Last Updated: 2026-01-30 (Phase 5 ML Integration)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ENVIRONMENT SELECTION (CRITICAL)
# ----------------------------------------------------------------------------
AGENT_STUDIO_ENV=staging

# ----------------------------------------------------------------------------
# 16. PHASE 5 ML FEATURES (Pattern Recognition & Optimization)
# ----------------------------------------------------------------------------
# All ML features ENABLED in staging for integration testing
PATTERN_DETECTION_ENABLED=true
COST_PREDICTION_ENABLED=true
ADAPTIVE_EXECUTION_ENABLED=true
PERFORMANCE_PROFILING_ENABLED=true
PATTERN_LIBRARY_ENABLED=true

# Pattern detection thresholds (staging: relaxed for testing)
PATTERN_MIN_SUPPORT=0.05
PATTERN_MIN_CONFIDENCE=0.5

# Adaptive executor concurrency (staging: higher for load testing)
ADAPTIVE_MAX_CONCURRENCY=20

# Cost prediction budget alert (staging: higher threshold)
COST_BUDGET_ALERT_USD=50.00

# Performance profiler sampling (staging: more frequent)
PROFILER_SAMPLE_INTERVAL_MS=500

# Pattern library size (staging: larger for testing)
PATTERN_LIBRARY_MAX_SIZE=5000

# ----------------------------------------------------------------------------
# 15. HEAP MEMORY CONFIGURATION (Staging: 8GB)
# ----------------------------------------------------------------------------
# NODE_OPTIONS=--max-old-space-size=8192 (set at shell level)
HEAP_WARNING_THRESHOLD=70
HEAP_CRITICAL_THRESHOLD=85
HEAP_SHUTDOWN_THRESHOLD=95
MEMORY_MONITOR_INTERVAL_MS=5000
MEMORY_HISTORY_SIZE=200
MEMORY_SPAWN_THROTTLING=true

# ----------------------------------------------------------------------------
# OTHER STAGING DEFAULTS
# ----------------------------------------------------------------------------
# Error logging enabled
ERROR_LOGGING_ENABLED=true
ERROR_CAPTURE_HOOK=block
AGENT_TOOLS_VALIDATOR=block

# Reflection enabled
REFLECTION_ENABLED=true
REFLECTION_HOOK_MODE=block

# Safety hooks (relaxed for testing)
LOOP_PREVENTION_MODE=warn
ANOMALY_DETECTION_ENABLED=true

# Routing
REROUTER_MODE=suggest
PLAN_EVOLUTION_GUARD=warn

# Execution limits (higher for staging)
DEFAULT_MAX_TURNS=100
DEFAULT_MAX_DURATION_MS=3600000
DEFAULT_MAX_COST_USD=20.00
EXECUTION_LIMITS_ENABLED=true

# Event system enabled
EVENT_BUS_ENABLED=true
EVENT_PRIORITY_ENABLED=true

# Memory system (staged rollout)
MEMORY_SYSTEM_ENABLED=true
MEMORY_ROLLOUT_PERCENTAGE=50
MEMORY_EMBED_ON_EDIT=on
MEMORY_EMBED_ON_EDIT_TIMEOUT_MS=30000

# Observability (optional - requires Arize Phoenix)
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================================================
# STAGING DEPLOYMENT NOTES
# ============================================================================
# Setup:
#   1. Copy this file: cp .env.staging.example .env.staging
#   2. Initialize: node .claude/tools/cli/init-staging.cjs
#   3. Verify: node --test tests/staging-smoke.test.mjs
#   4. Run tests: npm test
#
# Phase 5 ML Features:
#   - All ML modules enabled for integration testing
#   - Relaxed thresholds for pattern detection
#   - Higher concurrency and cost budgets
#   - Frequent performance profiling sampling
#
# Expected Performance:
#   - Heap: 8GB (NODE_OPTIONS=--max-old-space-size=8192)
#   - Test suite: <5min for 1364+ tests
#   - Pass rate: >99% (1360+/1364 tests)
#   - OOM errors: 0 (memory leak fixes validated)
#
# See: .claude/docs/STAGING_ENVIRONMENT.md
# ============================================================================
