# ============================================================================
# 21. CODE INDEXING CONFIGURATION (Updated 2026-02-19)
# ============================================================================
# Semantic code indexing with BM25 + vector embeddings.
# Uses subprocess isolation to work around ONNX Runtime native memory leak.
#
# Quick start:
#   1. pnpm install
#   2. pnpm code:index:reindex   (builds BM25 + vector index, ~12 min with GPU)
#   3. pnpm search:code "query"  (hybrid search with semantic ranking)
#
# Dependencies:
#   - For fastembed (recommended): pnpm add fastembed
#   - For transformers: pnpm rebuild sharp (may need pnpm approve-builds)
#   - GPU (optional): NVIDIA GPU with CUDA for ~30% faster indexing
# ----------------------------------------------------------------------------

# Embedding engine for code indexing
# Values: transformers | fastembed | test | mock
# - transformers: Uses @xenova/transformers (slower, more memory, ~2GB)
# - fastembed: Uses fastembed (10x faster, less memory, ~500MB) - RECOMMENDED
# - test: Deterministic embeddings for testing (no ML dependencies)
# - mock: Disables embeddings entirely (search will fail)
# Default: fastembed
#
# CODE_INDEX_EMBEDDER=fastembed

# Debounce indexing to reduce frequency when files change rapidly (milliseconds)
# Prevents excessive reindexing during active development
# Default: 5000
#
# CODE_INDEX_DEBOUNCE_MS=10000

# Maximum file size to index (bytes). Files larger than this are skipped.
# Reduced from 1MB to 512KB to prevent memory spikes with large files
# Default: 524288 (512KB)
#
# CODE_INDEX_MAX_FILE_SIZE=524288

# Minimum tokens per chunk. Chunks smaller than this are skipped.
# Reduces noise from tiny code fragments
# Default: 10
#
# CODE_INDEX_MIN_TOKENS=10

# Batch size for embedding generation.
# Reduce if you experience OOM errors (try 16 or 8)
# Default: 32
#
# CODE_INDEX_EMBED_BATCH_SIZE=32

# Number of concurrent indexing workers.
# Auto-calculated based on available memory if unset.
# Set manually for systems with limited RAM (1-4 recommended)
# Default: (auto-calculated)
#
# CODE_INDEX_WORKERS=2

# Enable checkpointing to resume indexing after crash/interruption
# Creates checkpoint.json in code-index directory
# Default: true
#
# CODE_INDEX_ENABLE_CHECKPOINTS=true

# How often to save checkpoint (number of files)
# Default: 50
#
# CODE_INDEX_CHECKPOINT_INTERVAL=50

# Subprocess embedding isolation (ONNX Runtime memory leak workaround)
# Values: on | off
# Default: on
# ONNX Runtime's native memory arena never releases memory back to the OS
# (microsoft/onnxruntime#25325, qdrant/fastembed#570). The subprocess
# workaround runs embeddings in an isolated child process that is restarted
# every 50 batches, reclaiming all native memory on exit.
# Set to off only for single-query search (not bulk indexing).
# With subprocess: indexing uses ~200MB. Without: OOM at 32GB+.
#
# EMBED_SUBPROCESS=on

# How many embedding batches before restarting the subprocess worker.
# Lower = more frequent restarts (more memory reclaim, slightly slower).
# Higher = less overhead, but ONNX arena grows larger between restarts.
# Default: 50
#
# EMBED_SUBPROCESS_MAX_CALLS=50

# ============================================================================
# 22. EVENT BUS MEMORY LEAK PREVENTION (Added 2026-02-05)
# ============================================================================
# The EventBus can accumulate unlimited subscriptions in long sessions,
# eventually causing OOM. These limits prevent unbounded growth.
# ----------------------------------------------------------------------------

# Maximum subscriptions per event type.
# When exceeded, oldest subscription is evicted (LRU pattern)
# Default: 50
#
# EVENT_MAX_SUBSCRIPTIONS_PER_TYPE=50

# Maximum total subscriptions across all event types
# When exceeded, oldest subscription globally is evicted
# Default: 500
#
# EVENT_MAX_TOTAL_SUBSCRIPTIONS=500

# How often to clean up stale subscriptions (milliseconds)
# Stale = not accessed for EVENT_STALE_TIMEOUT_MS
# Default: 600000 (10 minutes)
#
# EVENT_CLEANUP_INTERVAL_MS=600000

# Timeout before a subscription is considered stale (milliseconds)
# Subscriptions idle longer than this are removed during cleanup
# Default: 3600000 (1 hour)
#
# EVENT_STALE_TIMEOUT_MS=3600000

# ============================================================================
# 23. MEMORY-SAFE HEAP THRESHOLDS (Added 2026-02-05)
# ============================================================================
# Reduced defaults for systems with <16GB RAM.
# These trigger earlier to prevent OOM before it's too late.
# ----------------------------------------------------------------------------

# Heap warning threshold (percentage)
# Warn when heap usage exceeds this percentage
# Default: 70 | Recommended for <16GB: 60
#
# HEAP_WARNING_THRESHOLD=60

# Heap critical threshold (percentage)
# Block new agent spawns when exceeded
# Default: 85 | Recommended for <16GB: 75
#
# HEAP_CRITICAL_THRESHOLD=75

# Heap shutdown threshold (percentage)
# Emergency shutdown when exceeded
# Default: 95 | Recommended for <16GB: 90
#
# HEAP_SHUTDOWN_THRESHOLD=90

# ============================================================================
# 24. HYBRID LAZY CODE SEARCH (Updated 2026-02-10)
# ============================================================================
# Current implementation: hybrid-search.cjs + hybrid-search-daemon.cjs
# - Text retrieval: ripgrep (instant, no batch index wait)
# - Optional semantic ranking: LanceDB embeddings
# - Recommended for repeated searches: daemon + prewarm
#
# IMPORTANT:
# - Several older HYBRID_* tuning vars are no longer read by runtime code.
# - Use only the variables below for current behavior.
# ----------------------------------------------------------------------------

# Enable semantic ranking (code default when unset: enabled)
# Values: on | off
# Recommended: on
#
# HYBRID_EMBEDDINGS=on

# Enable daemon transport (persistent process)
# Values: on | off
# Default when unset: on
# Recommended: on
#
# HYBRID_SEARCH_DAEMON=on

# Daemon bind host
# Default: 127.0.0.1
#
# HYBRID_DAEMON_HOST=127.0.0.1

# Daemon port
# Default: 47653
#
# HYBRID_DAEMON_PORT=47653

# Daemon request timeout in CLI (milliseconds)
# Default: 3000
#
# HYBRID_DAEMON_TIMEOUT_MS=3000

# Daemon idle auto-shutdown (milliseconds)
# Default: 600000 (10 minutes)
#
# HYBRID_DAEMON_IDLE_MS=600000

# Prewarm daemon on startup (rg path + LanceDB + semantic warm path)
# Values: true | false
# Default: false
# Recommended: true
#
# HYBRID_DAEMON_PREWARM=true

# Hybrid internal debug logging
# Values: true | false
# Default: false
#
# HYBRID_SEARCH_DEBUG=false

# Enable ast-grep structural refinement stage
# Values: on | off
# Default: on (runs only for structural-looking queries)
#
# HYBRID_AST_GREP_REFINEMENT=on

# Grep enforcement mode for PreToolUse fallback gate.
# Values: block | warn | off
# Default: block
# - block: deny broad Grep discovery; allow only advanced PCRE or single-file fallback
# - warn: allow but emit warning
# - off: disable enforcement
#
# HYBRID_GREP_ENFORCEMENT=block

# Optional binary path overrides for search tooling.
# Leave unset in normal usage: runtime auto-discovers binaries from:
# - @vscode/ripgrep / @ast-grep/cli
# - node_modules/.bin
# - Scoop shims on Windows (e.g., %USERPROFILE%\\scoop\\shims)
# - PATH fallbacks
#
# RG_BIN=C:\Users\<you>\scoop\shims\rg.exe
# AST_GREP_BIN=C:\Users\<you>\scoop\shims\ast-grep.exe
# RGA_BIN=C:\Users\<you>\scoop\shims\rga.exe
# FZF_BIN=C:\Users\<you>\scoop\shims\fzf.exe

# Force typed LanceDB filter columns
# Values: on | off
# Default heuristic: auto (typed for numeric filters, legacy for string filters)
# Only set to "on" when you explicitly want typed filtering behavior everywhere.
#
# LANCEDB_TYPED_FILTERS=off

# ============================================================================
# 26. SEARCH OPTIMIZATION (Added 2026-02-18)
# ============================================================================
# Semantic query cache and BM25 incremental update for faster repeated queries.
# Works with the hybrid search daemon (Section 24).
# ----------------------------------------------------------------------------

# Semantic query cache (caches queries by cosine similarity of embeddings)
# Values: on | off
# Default: on
# Kill switch: set to off to disable query caching entirely
#
SEARCH_CACHE_ENABLED=on

# Cache entry TTL (milliseconds)
# Default: 300000 (5 minutes)
#
# SEARCH_CACHE_TTL_MS=300000

# Cosine similarity threshold for semantic cache hit
# Higher = stricter matching (fewer cache hits, more accurate)
# Lower = looser matching (more cache hits, risk of stale results)
# Default: 0.95
#
# SEARCH_CACHE_SIMILARITY=0.95

# BM25 incremental update after file edits
# Values: on | off
# Default: on
# Kill switch: set to off to disable post-edit BM25 fast updates
# When disabled, BM25 index only updates on full reindex
#
BM25_INCREMENTAL_UPDATE=on

