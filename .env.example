# ============================================================================
# Agent-Studio Environment Variables
# ============================================================================
# Copy this file to .env and customize for your local environment
# NOTE: .env is gitignored and will NOT be committed
#
# Version: 2.2.7
# Last Updated: 2026-02-10 (Hybrid search daemon + prewarm defaults refreshed)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ENVIRONMENT SELECTION (CRITICAL)
# ----------------------------------------------------------------------------
# Controls which configuration file is loaded and which paths are used
# Values: development | staging | production
# Default: development
#
AGENT_STUDIO_ENV=development

# Fallback environment selector (used if AGENT_STUDIO_ENV not set)
# Values: development | production
# Default: development
#
# NODE_ENV=development

# ----------------------------------------------------------------------------
# 1a. RECOMMENDED PRODUCTIVITY DEFAULTS (LOCAL DEVELOPMENT)
# ----------------------------------------------------------------------------
# These defaults are tuned for the current codebase behavior and "best use"
# during normal local development. Keep them enabled unless debugging.
#
# Hybrid search semantic ranking (default in code if not "off")
HYBRID_EMBEDDINGS=on
#
# Use persistent search daemon for repeated queries
HYBRID_SEARCH_DAEMON=on
#
# Prewarm daemon on startup to reduce first-query latency
HYBRID_DAEMON_PREWARM=true
#
# MCP Connection Optimization (from tweakcc research 2026-03-19)
# Non-blocking MCP server connections — ~50% startup speedup
MCP_CONNECTION_NONBLOCKING=1
#
# Batch MCP server connections (default: 1 = sequential)
MCP_SERVER_CONNECTION_BATCH_SIZE=10

# ----------------------------------------------------------------------------
# 2. FEATURE FLAGS (Override config.yaml)
# ----------------------------------------------------------------------------
# Party Mode: Multi-agent collaboration framework
# Default: false (must be explicitly enabled)
#
# PARTY_MODE_ENABLED=false

# Party mode staged rollout percentage (0-100)
# Default: 0 (disabled)
#
# PARTY_ROLLOUT_PERCENTAGE=0

# Advanced Elicitation: Multi-method requirements gathering
# Default: false (must be explicitly enabled)
#
# ELICITATION_ENABLED=false

# Auto-compression for long sessions (Phase 3)
# Activates the compression-reminder.txt trigger in compression-trigger.cjs.
# When enabled, compression events write compression-reminder.txt to the runtime
# directory so the router checks it and spawns context-compressor. Without this
# flag the token-saver skill still works but must be invoked manually via
# Skill({ skill: 'token-saver-context-compression' }).
# Values: 1 (enabled) | 0 or unset (disabled)
# Default: 1 (enabled — recommended for long sessions)
# Thresholds enforced in CLAUDE.md Section 8:
#   80K tokens  → spawn context-compressor proactively
#   120K tokens → compression mandatory before new spawns
#   150K tokens → no new agent spawns until compression completes
#
AUTO_COMPRESSION_PHASE_3=1

# Feature D8: Configurable Context Thresholds
# Override the spawn-token-guard.cjs token thresholds for context management.
# spawn-token-guard writes compression-reminder.txt at WARN, blocks at BLOCK.
# Values: positive integer (token count)
# Defaults: WARN=80000, BLOCK=120000, RED=150000
#
# CONTEXT_THRESHOLD_WARN=80000
# CONTEXT_THRESHOLD_BLOCK=120000
# CONTEXT_THRESHOLD_RED=150000

# Smart Debug HITL (Human-In-The-Loop)
# smart-debug skill: when true, agent pauses at reproduction step and asks the human to
# trigger the bug manually. When false (default), agent auto-reproduces via tests/scripts.
# Values: true (enabled) | false (disabled)
# Default: false
#
SMART_DEBUG_HITL=false

# ----------------------------------------------------------------------------
# 3. REFLECTION HOOKS (Quality & Learning)
# ----------------------------------------------------------------------------
# Enable/disable all reflection hooks
# Default: true (enabled)
#
# REFLECTION_ENABLED=true

# Reflection hook enforcement mode
# Values: block | warn | off
# Default: block
#
# REFLECTION_HOOK_MODE=block
#
# Reflection queue processing on UserPromptSubmit (headless-safe)
# Values: on | off
# Default: on
#
# REFLECTION_QUEUE_PROCESS_ON_PROMPT=on
#
# Minimum interval between queue processing runs (ms)
# Default: 600000 (10 minutes)
#
# REFLECTION_QUEUE_PROCESS_INTERVAL_MS=600000
#
# Timeout for queue processing (ms)
# Default: 60000 (60 seconds)
#
# REFLECTION_QUEUE_PROCESS_TIMEOUT_MS=60000
#
# Max lines to retain in reflection-queue.jsonl
# Default: 5000
#
# REFLECTION_QUEUE_MAX_LINES=2000

# Step0 repetition guard tuning (advanced)
# Default repeat threshold: 3
# Default window: 300000 ms (5 minutes)
#
# REFLECTION_STEP0_REPEAT_THRESHOLD=3
# REFLECTION_STEP0_REPEAT_WINDOW_MS=300000

# ----------------------------------------------------------------------------
# 4. SAFETY HOOKS (Loop Prevention, Anomaly Detection)
# ----------------------------------------------------------------------------
# Loop prevention enforcement mode
# Values: block | warn | off
# Default: block
#
# LOOP_PREVENTION_MODE=block

# Max evolution suggestions before loop detected
# Default: 3
#
# LOOP_EVOLUTION_BUDGET=3

# Cooldown period after loop detection (milliseconds)
# Default: 60000 (1 minute)
#
# LOOP_COOLDOWN_MS=60000

# Max recursion depth before loop flagged
# Default: 5
#
# LOOP_DEPTH_LIMIT=5

# Pattern repetitions before flagged as loop
# Default: 3
#
# LOOP_PATTERN_THRESHOLD=3

# Allow operations if loop prevention hook fails
# Default: false (fail-secure)
#
# LOOP_PREVENTION_FAIL_OPEN=false

# ----------------------------------------------------------------------------
# 5. ANOMALY DETECTION
# ----------------------------------------------------------------------------
# Enable/disable anomaly detection
# Default: true
#
# ANOMALY_DETECTION_ENABLED=true

# Token usage anomaly threshold (multiplier of baseline)
# Default: 2
#
# ANOMALY_TOKEN_MULTIPLIER=2

# Duration anomaly threshold (multiplier of baseline)
# Default: 3
#
# ANOMALY_DURATION_MULTIPLIER=3

# Consecutive failures before alert
# Default: 3
#
# ANOMALY_FAILURE_COUNT=3

# Pattern repetitions before flagged
# Default: 2
#
# ANOMALY_PATTERN_REPS=2

# ----------------------------------------------------------------------------
# 6. ROUTING & ORCHESTRATION
# ----------------------------------------------------------------------------
# Heartbeat loop auto-start on first message (Step 0.5)
# Set false to disable automatic cron loop registration without editing CLAUDE.md
# Values: true | false
# Default: true
#
HEARTBEAT_AUTO_START=true

# Router identity reminder injected into every router-session prompt (UserPromptSubmit)
# Skips automatically for subagent sessions — safe to leave on always
# Values: on | off
# Default: on
#
ROUTER_IDENTITY_REMINDER=on

# Auto-rerouter behavior
# Values: suggest | block | off
# Default: suggest
#
# REROUTER_MODE=suggest

# Router duplicate-block suppression tuning (advanced)
# Default threshold: 3 repeated blocks
# Default window: 60000 ms
#
# ROUTER_BLOCK_DEDUPE_THRESHOLD=3
# ROUTER_BLOCK_DEDUPE_WINDOW_MS=60000

# Plan evolution guard mode
# Values: block | warn | off
# Default: block
#
# PLAN_EVOLUTION_GUARD=block

# Semantic routing fallback toggle
# Values: on | off
# Default: on
#
# SEMANTIC_ROUTING=on

# Context/mode selection (DEPRECATED - modes archived to .claude/config/_archive/ in Pipeline #10)
# AGENT_STUDIO_CONTEXT=
# AGENT_STUDIO_MODES=editing

# Context/mode tool guard (DEPRECATED - modes archived)
# Values: block | warn | off
# Default: warn
#
# CONTEXT_MODE_TOOL_GUARD=warn

# ----------------------------------------------------------------------------
# 6a. ENFORCEMENT MODES (Hooks)
# ----------------------------------------------------------------------------
# Enforcement defaults changed to "block" mode (Phase 1, Task 1.1, 2026-02-06)
# - PLANNER_FIRST_ENFORCEMENT: warn → block (prevent developer collapse)
# - SECURITY_REVIEW_ENFORCEMENT: warn → block (enforce security reviews)
# - SPAWN_PROMPT_VALIDATOR: warn → block (enforce valid spawn prompts)
#
PLANNER_FIRST_ENFORCEMENT=block
CREATOR_GUARD=block
SPAWN_PROMPT_VALIDATOR=block
ROUTER_WRITE_GUARD=block
SECURITY_REVIEW_ENFORCEMENT=block
RESEARCH_ENFORCEMENT=block
REFLECTION_STEP0_ENFORCEMENT=block
TASK_COMPLETION_GUARD=block
TASKLIST_FIRST_ENFORCEMENT=block
TASKUPDATE_FIRST_ENFORCEMENT=block
TASKUPDATE_FIRST_AUTOMARK=false
TASKUPDATE_FIRST_BOOTSTRAP=false

# Missing newly added enforcement hooks
CREATOR_GUARD_TEST_FORCE_THROW=false
HOOK_FAIL_OPEN_ACK=false
HOOK_FAIL_OPEN_SCOPE=local
WRITE_HOOK_FAIL_OPEN=false
MEMORY_DIRECT_WRITE_ENFORCEMENT=block
ROUTER_GIT_COMMIT_ENFORCEMENT=warn
ROUTING_GUARD_TEST_FORCE_THROW=false
# TaskUpdate-first advanced controls
# Values: block | warn | off, booleans, and numeric windows/thresholds
# Default: block with conservative thresholds
#
# TASKUPDATE_FIRST_MAX_VIOLATIONS=3
# TASKUPDATE_FIRST_WINDOW_MS=300000
# TASKUPDATE_FIRST_PREFLIGHT_TASKLIST_MAX=1
# TASKUPDATE_FIRST_SELF_HEAL=on

# TaskList-first advanced controls
# Values: on/off and numeric thresholds/windows
# Default: autoreroute on, conservative thresholds
#
# TASKLIST_FIRST_AUTOREROUTE=on
# TASKLIST_FIRST_AUTOREROUTE_THRESHOLD=2
# TASKLIST_FIRST_LOOP_BREAKER_THRESHOLD=3
# TASKLIST_FIRST_LOOP_BREAKER_WINDOW_MS=300000

# Router guard task checks toggle
# Values: on | off
# Default: on
#
# ROUTING_GUARD_TASK_CHECKS=on

# Config model validator enforcement mode
# Values: block | warn | off
# Default: block
#
# CONFIG_MODEL_VALIDATOR=block

# Read guard token threshold for mandatory chunked reads
# Values: positive integer
# Default: 8000
#
# READ_CHUNK_GUARD_TOKENS=8000

# Host (Cursor/Claude Code) max file read output tokens
# Read tool output exceeding this triggers MaxFileReadTokenExceededError.
# Aligns pre-tool read-safety window/block with host limit. Use offset/limit or Grep for large files.
# Values: positive integer
# Default: 25000 (or CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS if set)
#
# READ_HOST_MAX_FILE_READ_TOKENS=25000

# Read path token-saver enforcement
# Values: block | warn | off
# Default: warn
#
# READ_TOKEN_SAVER_ENFORCEMENT=warn

# Router enforcement (block = prevent violations, warn = log only, off = disabled)
# Values: block | warn | off
# Default: block
# Enforces Router bash command whitelist (ADR-030)
#
ROUTER_BASH_GUARD=block

# Specialist routing enforcement
# Values: block | warn | off
# Default: block
# Enforces specialist-first routing (prevent developer collapse)
#
SPECIALIST_ROUTING_ENFORCEMENT=block

# Intent-agent match enforcement
# Values: block | warn | off
# Default: block
# Validates spawned agent matches detected intent
#
INTENT_AGENT_MATCH=block

# Creator routing enforcement (Layer 1)
# Values: block | warn | off
# Default: warn
# Blocks non-creator spawns when creator intent detected
#
CREATOR_ROUTING_ENFORCEMENT=warn

# Creator compliance enforcement (Layer 3)
# Values: block | warn | off
# Default: warn
# Validates post-creation integration
#
CREATOR_COMPLIANCE_ENFORCEMENT=warn

# Creator schema enforcement (Layer 4)
SCHEMA_ENFORCEMENT=warn

# Agent guardrail enforcement modes
# Values: block | warn | off
# Default: warn
#
# AGENT_GUARDRAIL_ENFORCEMENT=warn
# AGENT_GIT_COMMIT_ENFORCEMENT=warn
# AGENT_FILE_ALLOWLIST_ENFORCEMENT=warn
# AGENT_EDIT_CHECKPOINT_ENFORCEMENT=warn

# Code simplifier architect-first enforcement
# Values: block | warn | off
# Default: warn
# Requires architect review before code-simplifier spawning
#
CODE_SIMPLIFIER_ARCHITECT_ENFORCEMENT=warn

# High-risk specialist architect-first enforcement
# Values: block | warn | off
# Default: warn
# Requires architect review before devops/devops-troubleshooter/chaos-engineer
#
HIGH_RISK_SPECIALIST_ARCHITECT_ENFORCEMENT=warn

# Task ownership guard
# Values: block | warn | off
# Default: warn
# Prevents agents from working on tasks they don't own
#
TASK_OWNERSHIP_GUARD=warn

# Task parallel ownership enforcement
# Values: block | warn | off
# Default: warn
# Requires task ownership for parallel agent work
#
TASK_PARALLEL_OWNERSHIP_REQUIRED=warn

# Router tool lockdown enforcement
# Values: block | warn | off
# Default: block
# Blocks router from using banned tools (Edit, Write, Bash, Glob, Grep, etc.)
#
ROUTER_TOOL_LOCKDOWN_ENFORCEMENT=block

# Pre-completion summary enforcement
# Values: block | warn | off
# Default: block (recommended — prevents reflection-blind completions)
# Requires metadata.summary (>20 chars, non-placeholder) on TaskUpdate(completed).
# 71% of agent completions lack required metadata; keep this at 'block' to enforce.
# Downgrade to 'warn' only during debugging or migration — never leave at 'off'.
#
PRE_COMPLETION_SUMMARY_ENFORCEMENT=block

# Task status transition enforcement
# Values: block | warn | off
# Default: block
# Enforces valid pending→in_progress→completed transitions
#
TASK_STATUS_ENFORCEMENT=block

# Task output enforcement (required output files must exist at completion)
# Values: block | warn | off
# Default: block
#
TASK_OUTPUT_ENFORCEMENT=block

# Reflection score enforcement (prevents fabricated scores without dataQuality field)
# Values: block | warn | off
# Default: warn (upgrade to block once all reflection agents include dataQuality)
#
REFLECTION_SCORE_ENFORCEMENT=warn

# Optional validator path overrides for ecosystem checks
# Default: built-in paths (auto-discovered)
#
# AGENT_SKILL_REFERENCE_VALIDATOR_PATH=.claude/tools/cli/validate-agent-skill-references.cjs
# SKILL_ECOSYSTEM_VALIDATOR_PATH=.claude/tools/cli/validate-skill-ecosystem.cjs
# CREATOR_ECOSYSTEM_VALIDATOR_PATH=.claude/tools/cli/validate-creator-ecosystem.cjs

# ----------------------------------------------------------------------------
# 7. SHELL COMMAND SECURITY (ADR-077)
# ----------------------------------------------------------------------------
# Project root directory (used by shell security validators)
# Default: auto-detected from cwd
# NOTE: Should be absolute path to prevent path traversal attacks
#
PROJECT_ROOT=C:\dev\projects\agent-studio

# Bash CWD Validator enforcement mode
# Values: block | warn | off
# Default: block
# Purpose: Ensures background Bash tasks initialize CWD to PROJECT_ROOT
# Prevents: Filesystem traversal, data exposure, resource exhaustion
#
BASH_CWD_VALIDATOR=block

# Shell Injection Validator enforcement mode
# Values: block | warn | off
# Default: block
# Purpose: Blocks dangerous shell patterns (rm -rf /, eval, etc.)
# Prevents: Arbitrary command execution, data destruction
#
SHELL_INJECTION_VALIDATOR=block

# Variable Quoting Validator enforcement mode
# Values: block | warn | off
# Default: warn
# Purpose: Detects unquoted variables in Bash commands
# Prevents: Word splitting, glob expansion, injection in dangerous contexts
#
VARIABLE_QUOTING_VALIDATOR=warn

# Shellcheck Validator enforcement mode (Phase 3)
# Values: block | warn | off
# Default: off (requires shellcheck installed)
# Purpose: Static analysis of shell commands
# Prevents: Syntax errors, portability issues, common bugs
#
# SHELLCHECK_VALIDATOR=off

# Command Allowlist Validator enforcement mode (Phase 3)
# Values: block | warn | off
# Default: warn
# Purpose: Restricts background tasks to approved commands
# Prevents: Unauthorized command execution
#
# COMMAND_ALLOWLIST_VALIDATOR=warn

# ----------------------------------------------------------------------------
# 8. SESSION & DEBUGGING
# ----------------------------------------------------------------------------
# Override session ID (useful for testing)
# Default: auto-generated
#
# CLAUDE_SESSION_ID=

# Enable verbose hook debugging logs
# Default: false
#
# DEBUG_HOOKS=false
# LOG_LEVEL=info

# Formatter script log level (scripts/format-tracked.mjs)
# Values: debug | info | warn | error
# Default: info
#
# FORMAT_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 8a. MODEL CLIENT (LLM runtime)
# ----------------------------------------------------------------------------
# Default model for model-client (used when no explicit model provided)
# Values: any valid model alias or full model ID
# Default: (unset, resolved from config/agent)
#
# MODEL_CLIENT_DEFAULT_MODEL=

# Agent type used to resolve default model when MODEL_CLIENT_DEFAULT_MODEL is unset
# Values: planner | developer | qa | architect | ...
# Default: planner
#
# MODEL_CLIENT_AGENT_TYPE=planner

# Max retries for model-client requests
# Default: 2
#
# MODEL_CLIENT_MAX_RETRIES=2

# Base retry backoff (ms)
# Default: 500
#
# MODEL_CLIENT_RETRY_BASE_MS=500

# ----------------------------------------------------------------------------
# 9. EXTERNAL INTEGRATIONS (Optional)
# ----------------------------------------------------------------------------
# Persistent OS-level scheduling for the env-backup heartbeat loop.
# When true, run `node .claude/tools/cli/setup-persistent-schedule.cjs` to
# register a daily Task Scheduler job (Windows) or crontab entry (Linux/Mac)
# that runs env-backup.cjs at 08:17 independently of any Claude session.
# Values: true | false
# Default: false
#
PERSISTENT_SCHEDULE=false

# Webhook authentication secret (if using webhooks)
# Default: null (webhooks disabled)
#
# WEBHOOK_SECRET=

# Anthropic API key (required for memory extraction/dedup/summaries)
#
# ANTHROPIC_API_KEY=

# OpenAI API key — used by: tts-generation (OpenAI TTS backend), transcription (cloud Whisper)
#
# OPENAI_API_KEY=

# ElevenLabs API key — used by: tts-generation (ElevenLabs voices, voice cloning)
# Get key: https://elevenlabs.io/app/settings/api-keys
#
# ELEVENLABS_API_KEY=

# Exa API key — used by: deep-research (enhanced semantic web search)
# Free tier available: https://exa.ai/
#
# EXA_API_KEY=

# HuggingFace token — used by: transcription (speaker diarization, --device insane only)
# Get token: https://hf.co/settings/tokens
#
# HF_TOKEN=

# Enable context editing via beta header (84% token reduction on long workflows)
# This header enables automatic clearing of stale tool results from context window
# Directly solves P0 context overflow issue (52 min work lost 2026-02-09)
# Default: context-management-2025-06-27
#
ANTHROPIC_BETA=context-management-2025-06-27

# External API endpoint (if using external services)
# Default: http://localhost:3000
#
# API_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 10. MEMORY SYSTEM (SQLite + LanceDB)
# ----------------------------------------------------------------------------
# Memory System Phased Rollout
# Enable/disable hybrid memory system (SQLite entity graph + embedded LanceDB semantic search)
# Default: false (must be explicitly enabled)
#
# MEMORY_SYSTEM_ENABLED=false

# Gradual rollout percentage for memory system (0-100)
# Default: 0 (disabled for all sessions)
# Recommended phases: 10 → 50 → 100
#
# MEMORY_ROLLOUT_PERCENTAGE=0

# Semantic search toggle used by ContextualMemory
# Values: on | off
# Default: on
#
# MEMORY_SEMANTIC_SEARCH=on

# Embedded LanceDB storage directory (local, no server required)
# Default: .claude/context/data/lancedb
#
# LANCEDB_URI=.claude/context/data/lancedb

# LanceDB table name for memory vectors
# Default: agent_memory
#
# LANCEDB_TABLE=agent_memory

# LanceDB table name for code index vectors
# Default: code_index
#
# LANCEDB_TABLE_CODE=code_index

# Embedding mode for LanceDB upserts/search
# Values: transformers | fastembed | test | off
# Default: transformers
#
# Notes:
# - transformers: uses @xenova/transformers local embeddings (requires sharp to be built)
# - fastembed: uses optional fastembed (pnpm add fastembed); faster batch indexing, 384-dim BGE small
# - test: stable deterministic embeddings for tests
# - off: disables embeddings (semantic search will fail)
#
# LANCEDB_EMBEDDING_MODE=transformers

# Embedding mode for code index only (overrides LANCEDB_EMBEDDING_MODE for code_index table only)
# Values: transformers | fastembed | test | off
# Default: (unset; uses LANCEDB_EMBEDDING_MODE)
#
# Use fastembed for faster code reindex: set LANCEDB_EMBEDDING_MODE_CODE=fastembed
# Requires optional dependency: pnpm add fastembed
#
# LANCEDB_EMBEDDING_MODE_CODE=

# Embedding model ID for @xenova/transformers (used when LANCEDB_EMBEDDING_MODE=transformers)
# Default: Xenova/all-MiniLM-L6-v2
#
# LANCEDB_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Auto-generate embeddings when memory files change
# Values: on | off
# Default: off
#
# MEMORY_EMBED_ON_EDIT=off

# Max time to spend on auto-embed per edit (milliseconds)
# Default: 60000
#
# MEMORY_EMBED_ON_EDIT_TIMEOUT_MS=60000

# Background sync worker interval (milliseconds)
# Default: 60000 (60 seconds)
# Periodic sync for memory files to SQLite and LanceDB
#
# MEMORY_SYNC_INTERVAL_MS=60000

# Retention + cold storage (keeps LTM bounded; archives older summaries)
# See: .claude/docs/MEMORY_SYSTEM.md
#
# MEMORY_LTM_MAX_SUMMARIES=50
# MEMORY_COLD_ENABLE=true
# MEMORY_COLD_ARCHIVE_AFTER_DAYS=
# MEMORY_COLD_DIR=.claude/context/memory/cold
# COLD_STORAGE_INDEX_MAX_CHARS=4000

# Access tracking rate limiting (milliseconds)
# Default: 300000 (5 minutes)
#
# MEMORY_ACCESS_TRACKING_MIN_INTERVAL_MS=300000
# MEMORY_ACCESS_TRACKING=on
# MEMORY_JSON_WRITE_ENFORCEMENT=block

# Auto-sync JSON memory on write (patterns/gotchas)
# Values: on | off
# Default: on
#
# MEMORY_AUTO_SYNC=on
#
# Allow PostToolUse hook to sync JSON memory files when edited directly
# Values: on | off
# Default: off
#
# MEMORY_HOOK_JSON_SYNC=off

# Limit recent messages passed to memory extraction
# Default: 40
#
# MEMORY_EXTRACTION_RECENT_MESSAGES_LIMIT=40
# MEMORY_EXTRACTION_RECENT_CHARS_LIMIT=8000
# MEMORY_EXTRACTION_LIST_LIMIT=12

# Optional: embed memory entries on write (slower)
# Values: on | off
# Default: off
#
# MEMORY_EMBED_ON_WRITE=off

# Timeout for embed-on-write (milliseconds)
# Default: 30000
#
# MEMORY_EMBED_ON_WRITE_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# 10a. SPAWN PROMPT / MEMORY RETRIEVAL
# ----------------------------------------------------------------------------
# Spawn prompt assembler hook toggle
# Values: on | off
# Default: on
#
# SPAWN_PROMPT_ASSEMBLER=on

# Allowed tools enricher toggle
# Values: on | off
# Default: on
#
# ALLOWED_TOOLS_ENRICHER=on

# Append semantic matches in spawn prompts
# Values: on | off
# Default: on
#
# SPAWN_PROMPT_SEMANTIC_MEMORY=on

# Append entity graph (SQLite) in spawn prompts
# Values: on | off
# Default: on
#
# SPAWN_PROMPT_ENTITY_GRAPH=on

# Intent analysis for memory retrieval
# Values: on | off
# Default: on (opt-out by setting to 'off' or '0')
#
# MEMORY_INTENT_ANALYSIS=on

# Query-driven memory block in spawn prompts (replaces semantic matches when on)
# Values: on | off
# Default: on (opt-out by setting to 'off' or '0')
#
# SPAWN_PROMPT_MEMORY_QUERY=on

# Maximum chars per memory injection section in spawn prompts (~900 tokens)
# MEMORY_INJECTION_MAX_CHARS=3600

# Global kill switch for async RAG-at-spawn retrieval
# Values: on | off
# Default: on
#
# RAG_AT_SPAWN=on

# RAG-at-spawn query result limit used by assembleSpawnPromptAsync(memoryQuery)
# Values: positive integer
# Default: 5
#
# RAG_AT_SPAWN_LIMIT=5

# Optional semantic threshold for RAG-at-spawn query results
# Values: number (0.0-1.0, memory-backend dependent)
# Default: unset (backend default)
#
# RAG_AT_SPAWN_THRESHOLD=0.6

# Max RAG items rendered in "Task-Relevant Memory (RAG)" subsection
# Values: positive integer
# Default: 5
#
# RAG_AT_SPAWN_MAX_ITEMS=5

# Max characters for "Task-Relevant Memory (RAG)" subsection
# Values: positive integer
# Default: 1800
#
# RAG_AT_SPAWN_MAX_CHARS=1800

# Spawn prompt memory mode
# Values: hybrid | observational
# Default: hybrid
#
# MEMORY_MODE=hybrid

# Observational memory kill switch
# Values: on | off
# Default: on
#
# OBSERVATIONAL_MEMORY_ENABLED=on

# Token budget for observational summary subsection (chars/4 estimate)
# Default: 400
#
# MEMORY_SUMMARY_BLOCK_MAX_TOKENS=400

# Token budget for recent observations subsection (chars/4 estimate)
# Default: 400
#
# MEMORY_RECENT_OBSERVATIONS_MAX_TOKENS=400

# Token budget for Tier B memory subsections (semantic/query/entity)
# Default: 400
#
# MEMORY_TIER_B_MAX_TOKENS=400

# Minimum severity included in open findings carryover section
# Values: critical | high | medium | low
# Default: high
#
# OPEN_FINDINGS_MIN_SEVERITY=high

# Auto-resolution mode for findings
# Values: lenient | strict
# Default: lenient (set strict in CI/staging rollout)
#
# OPEN_FINDINGS_RESOLUTION_MODE=lenient

# Minimum token overlap required for auto-resolution matching
# Default: 2
#
# OPEN_FINDINGS_RESOLUTION_MIN_OVERLAP=2

# Periodic findings trend snapshot interval (milliseconds)
# Used by post-tool metrics hook to record trend signal outside post-task events
# Default: 900000 (15 minutes)
#
# FINDINGS_TREND_SNAPSHOT_INTERVAL_MS=900000

# Compact observations into summary on SessionEnd
# Values: on | off
# Default: on
#
# OBSERVATIONS_COMPACT_ON_SESSION_END=on

# Max observations included when compacting summary on SessionEnd
# Default: 50
#
# OBSERVATIONS_COMPACT_MAX=50

# Observation recency decay rate used in scoring (per hour)
# Higher = prefer recent observations more aggressively
# Default: 0.02
#
# OBSERVATIONS_DECAY_PER_HOUR=0.02

# Enable contradiction supersedes tagging for observations
# Values: on | off
# Default: off (deferred until telemetry maturity)
#
# OBSERVATIONS_CONTRADICTION_ENABLED=off

# Max age (days) for contradiction supersedes matching
# Older observations are ignored for supersedes tagging
# Default: 90
#
# OBSERVATIONS_CONTRADICTION_MAX_AGE_DAYS=90

# ----------------------------------------------------------------------------
# 10b. MEMORY SCHEDULER
# ----------------------------------------------------------------------------
# Max history entries retained per scheduler job
# Default: 30
#
# MEMORY_SCHEDULER_HISTORY_LIMIT=30

# ----------------------------------------------------------------------------
# 11. EVENT SYSTEM (Event-Driven Orchestration)
# ----------------------------------------------------------------------------
# Enable/disable EventBus (event-driven agent coordination)
# Default: true (enabled)
# When disabled, hooks/agents will not emit events
#
# EVENT_BUS_ENABLED=true

# Enable/disable priority-based event handling
# Default: true (enabled)
# When enabled, HIGH priority events processed before NORMAL/LOW
#
# EVENT_PRIORITY_ENABLED=true

# Event retention period (milliseconds)
# Default: 3600000 (1 hour)
# Events older than this are cleaned up to prevent memory leaks
#
# EVENT_RETENTION_MS=3600000

# Max event listeners per event type
# Default: 100
# Prevents memory leaks from unlimited listener registration
#
# EVENT_MAX_LISTENERS=100

# Event bus sink (JSONL file)
# Values: on | off
# Default: on
#
# EVENT_BUS_SINK=on
#
# Max lines to retain in event-bus.jsonl
# Default: 2000
#
# EVENT_BUS_MAX_LINES=2000

# Hook metrics log size cap (hook-metrics.jsonl)
# Default: 2000
#
# HOOK_METRICS_MAX_LINES=2000

# Error metrics log size cap (error-metrics.jsonl)
# Default: 2000
#
# ERROR_METRICS_MAX_LINES=2000

# Execution limit events log size cap (execution-limit-events.jsonl)
# Default: 2000
#
# EXECUTION_LIMIT_EVENTS_MAX_LINES=2000

# User prompt results log size cap (user-prompt-results.jsonl)
# Default: 2000
#
# USER_PROMPT_RESULTS_MAX_LINES=2000

# Anomaly log size cap (anomaly-log.jsonl)
# Default: 2000
#
# ANOMALY_LOG_MAX_LINES=2000

# ----------------------------------------------------------------------------
# 12. AGENT EXECUTION LIMITS (Safety & Cost Control)
# ----------------------------------------------------------------------------
# Default max turns for agent execution
# Default: 50 (can be overridden per-agent in spawn params)
# Prevents infinite loops and runaway agents
#
# DEFAULT_MAX_TURNS=50

# Default max duration in milliseconds
# Default: 1800000 (30 minutes)
# Prevents long-running agents from blocking resources
#
# DEFAULT_MAX_DURATION_MS=1800000

# Default max cost in USD
# Default: 5.00
# Prevents unexpected API cost overruns
#
# DEFAULT_MAX_COST_USD=5.00

# Warning threshold (0.0-1.0)
# Default: 0.8 (80%)
# Emits AGENT_LIMIT_WARNING event when this threshold is reached
#
# EXECUTION_LIMIT_WARNING_THRESHOLD=0.8

# Timeout action when limits exceeded
# Values: warn | terminate | pause
# Default: terminate
# - warn: Log warning and continue
# - terminate: Stop agent execution immediately
# - pause: Pause and wait for manual intervention
#
# EXECUTION_TIMEOUT_ACTION=terminate

# Enable execution limit monitoring
# Default: true (enabled)
# When disabled, limits are not enforced (use for debugging only)
#
# EXECUTION_LIMITS_ENABLED=true

# ----------------------------------------------------------------------------
# 13. ERROR LOGGING CONFIGURATION (Production Quality)
# ----------------------------------------------------------------------------
# Enable/disable error logging system
# Default: true (enabled)
# Captures all agent errors with sensitive data masking
#
# ERROR_LOGGING_ENABLED=true

# Error capture hook enforcement mode
# Values: block | warn | off
# Default: block
# - block: Prevents invalid error logging (production-safe)
# - warn: Logs warnings but continues (development)
# - off: Disables error logging (not recommended)
#
# ERROR_CAPTURE_HOOK=block

# Agent tools validator enforcement mode
# Values: block | warn | off
# Default: block
# - block: Prevents agents from using invalid tools
# - warn: Logs warnings for tool misuse
# - off: Disables tool validation
#
# AGENT_TOOLS_VALIDATOR=block

# Enable reflection error summary extraction
# Default: true (enabled)
# Integrates error data into daily reflection cycle
#
# REFLECT_ERROR_SUMMARY=true

# Error log retention period (days)
# Default: 7 (active errors)
# How long to keep error logs before archiving
#
# ERROR_RETENTION_DAYS=7

# Error archive retention period (days)
# Default: 30 (archived errors)
# Total retention including archived logs
#
# ERROR_ARCHIVE_RETENTION_DAYS=30

# Error log storage location
# Default: .claude/context/artifacts/error-reports/
# Directory where error logs are stored
#
# ERROR_LOG_LOCATION=.claude/context/artifacts/error-reports/

# ----------------------------------------------------------------------------
# 14. HEAP MEMORY CONFIGURATION (Memory Safeguards)
# ----------------------------------------------------------------------------
# Heap memory configuration for Node.js processes.
# Prevents OOM crashes during multi-agent orchestration.
#
# Recommended values by environment:
#   - development: 4096 (4GB) - sufficient for most dev workflows
#   - staging: 8192 (8GB) - allows testing with larger agent swarms
#   - production: 12288 (12GB) - handles enterprise-scale orchestration
#
# To configure, set NODE_OPTIONS before running claude:
#   export NODE_OPTIONS="--max-old-space-size=8192"
#
# Or in package.json scripts:
#   "start": "NODE_OPTIONS=--max-old-space-size=8192 node ..."
#
# Note: This is a comment-only section. NODE_OPTIONS should be set
# at the shell level, not in .env (Node reads NODE_OPTIONS before dotenv).
#
# NODE_OPTIONS=--max-old-space-size=8192

# Heap warning threshold (percentage of heap limit)
# Default: 70 (70%)
# When heap usage exceeds this, emit warnings and consider pausing spawns
#
HEAP_WARNING_THRESHOLD=70

# Heap critical threshold (percentage of heap limit)
# Default: 85 (85%)
# When heap usage exceeds this, pause agent spawning until memory recovers
#
HEAP_CRITICAL_THRESHOLD=85

# Heap shutdown threshold (percentage of heap limit)
# Default: 95 (95%)
# When heap usage exceeds this, trigger emergency cleanup and GC
# Agent spawning is blocked until heap drops below critical threshold
#
HEAP_SHUTDOWN_THRESHOLD=95

# Memory monitor polling interval (milliseconds)
# Default: 5000 (5 seconds)
# How frequently to check heap usage
#
MEMORY_MONITOR_INTERVAL_MS=5000

# Memory monitor history size
# Default: 100
# Number of memory snapshots to retain for trend analysis
#
MEMORY_HISTORY_SIZE=100

# Enable memory-based spawn throttling
# Default: true
# When enabled, routing-guard will pause spawns at critical threshold
#
MEMORY_SPAWN_THROTTLING=true

# Task cleanup retention period (milliseconds)
# Default: 1800000 (30 minutes)
# How long to retain completed tasks before cleanup
#
TASK_CLEANUP_RETENTION_MS=1800000

# Task cleanup interval (milliseconds)
# Default: 60000 (1 minute)
# How frequently to run task cleanup
#
TASK_CLEANUP_INTERVAL_MS=60000

# Task cleanup batch size
# Default: 100
# Maximum tasks to clean up per interval
#
TASK_CLEANUP_BATCH_SIZE=100

# ----------------------------------------------------------------------------
# 15. PHASE 5 ML FEATURES (Pattern Recognition & Optimization)
# ----------------------------------------------------------------------------
# Enable/disable ML pattern detection
# Default: false (must be explicitly enabled)
# Detects workflow patterns using N-grams, anomaly detection, clustering
#
# PATTERN_DETECTION_ENABLED=false

# Enable/disable ML cost prediction
# Default: false (must be explicitly enabled)
# Predicts LLM costs using token estimation and model pricing
#
# COST_PREDICTION_ENABLED=false

# Enable/disable adaptive execution optimization
# Default: false (must be explicitly enabled)
# Optimizes execution based on learned patterns (parallelization, batching, caching)
#
# ADAPTIVE_EXECUTION_ENABLED=false

# Enable/disable performance profiling
# Default: false (must be explicitly enabled)
# Tracks execution metrics for bottleneck detection
#
# PERFORMANCE_PROFILING_ENABLED=false

# Enable/disable pattern library persistence
# Default: false (must be explicitly enabled)
# Stores learned patterns for future optimization
#
# PATTERN_LIBRARY_ENABLED=false

# Pattern detection minimum support threshold (0.0-1.0)
# Default: 0.1 (10%)
# Minimum frequency for pattern to be considered significant
#
# PATTERN_MIN_SUPPORT=0.1

# Pattern detection minimum confidence threshold (0.0-1.0)
# Default: 0.6 (60%)
# Minimum confidence for pattern recommendation
#
# PATTERN_MIN_CONFIDENCE=0.6

# Adaptive executor max concurrency
# Default: 10
# Maximum parallel tasks for adaptive execution
#
# ADAPTIVE_MAX_CONCURRENCY=10

# Cost prediction budget alert threshold (USD)
# Default: 10.00
# Emit warning when session cost exceeds this threshold
#
# COST_BUDGET_ALERT_USD=10.00

# Performance profiler sampling interval (milliseconds)
# Default: 1000 (1 second)
# How frequently to sample performance metrics
#
# PROFILER_SAMPLE_INTERVAL_MS=1000

# Pattern library max stored patterns
# Default: 1000
# Maximum patterns to retain in library (LRU eviction)
#
# PATTERN_LIBRARY_MAX_SIZE=1000

# ML automation mode (gates retraining + persistence)
# Values: off | log | enforce
# Default: off
#
# off: ingest-only; does not retrain when threshold is hit
# log: retrain + persist (advice-only logging)
# enforce: retrain + persist; may apply config in future (currently same as log)
#
# ML_AUTOMATION_MODE=off

# Verbose ML debug logging
# Default: false
#
# ML_DEBUG=false

# Retraining threshold (sessions ingested before retrain)
# Default: 10
#
# ML_RETRAIN_THRESHOLD=10

# Training window (how many recent sessions to use for training rebuild)
# Default: 200
#
# ML_TRAINING_WINDOW=200

# Cap ML session log size (lines) to keep disk usage bounded
# Default: 2000
#
# ML_SESSION_LOG_MAX_LINES=2000

# Optional overrides for where ML state is persisted.
# Defaults to `.claude/context/ml/*` (required for hook execution across processes).
#
# ML_MODEL_PATH=.claude/context/ml/pattern-model.json
# ML_POLICY_PATH=.claude/context/ml/optimization-policies.json
# ML_FEEDBACK_STATE_PATH=.claude/context/ml/feedback-loop-state.json
# ML_SESSIONS_LOG_PATH=.claude/context/ml/sessions.jsonl

# ----------------------------------------------------------------------------
# 16. WORKER RUNTIME (Optional)
# ----------------------------------------------------------------------------
# Enable worker loop
# Values: 1 | true | 0 | false
# Default: off
#
# WORKER_ENABLED=false

# Run one tick then exit
# Values: 1 | true | 0 | false
# Default: off
#
# WORKER_ONCE=false

# Worker tick interval (milliseconds)
# Default: 60000
#
# WORKER_INTERVAL_MS=60000

# Worker backoff base/max (milliseconds)
# Defaults: 30000 / 300000
#
# WORKER_BACKOFF_BASE_MS=30000
# WORKER_BACKOFF_MAX_MS=300000

# Worker metrics/events toggles
# Values: on | off
# Defaults: on
#
# WORKER_METRICS=on
# WORKER_EVENTS=on

# Worker metrics line cap
# Default: 1000
#
# WORKER_METRICS_MAX_LINES=1000

# Worker project root override
# Default: auto-detected
#
# WORKER_PROJECT_ROOT=

# Worker tasks list (comma-separated)
# Default: maintenance,index,reflection
#
# WORKER_TASKS=maintenance,index,reflection

# ----------------------------------------------------------------------------
# 17. OBSERVABILITY / SCHEDULER
# ----------------------------------------------------------------------------
# Scheduler tick on UserPromptSubmit
# Values: on | off
# Default: off
#
# SCHEDULER_TICK_ON_PROMPT=off

# ----------------------------------------------------------------------------
# 18. ROUTING & STATE MANAGEMENT
# ----------------------------------------------------------------------------
# State staleness threshold (milliseconds)
# Default: 300000 (5 minutes)
# How long before workflow state is considered stale
#
# STATE_STALE_THRESHOLD_MS=300000

# Tool scope validator mode
# Values: block | warn | off
# Default: warn
# Validates tools are in allowed set for agent
#
# TOOL_SCOPE_VALIDATOR=warn

# Documentation routing guard mode
# Values: block | warn | off
# Default: warn
# Routes documentation tasks to technical-writer
#
# DOCUMENTATION_ROUTING_GUARD=warn

# CLAUDE.md enforcement mode
# Values: block | warn | off
# Default: warn
# Validates compliance with CLAUDE.md framework rules
#
# CLAUDE_MD_ENFORCEMENT=warn

# Integration enforcement mode
# Values: block | warn | off
# Default: warn
# Validates post-creation artifact integration
#
# INTEGRATION_ENFORCEMENT=warn

# Spawn size validator mode
# Values: block | warn | off
# Default: warn
# Validates spawn prompt size is within limits
#
# SPAWN_SIZE_VALIDATOR=warn

# Spawn size audit log toggle
# Values: on | off
# Default: off
# Logs spawn size violations to audit log
#
# SPAWN_SIZE_AUDIT_LOG=off

# Max write size (characters)
# Default: 500000 (500KB)
# Maximum characters allowed in Write tool calls
#
# MAX_WRITE_SIZE_CHARS=500000

# Read chunk guard (bytes)
# Default: 262144 (256KB)
# Caps large read responses to avoid context blowups.
#
# READ_CHUNK_GUARD_BYTES=262144

# Track analytics validator mode
# Values: block | warn | off
# Default: off
# Validates analytics tracking compliance
#
# TRACK_ANALYTICS_VALIDATOR=off

# No track enforcement mode
# Values: block | warn | off
# Default: off
# Enforces no-tracking directives
#
# NO_TRACK_ENFORCEMENT=off

# Agent preset override
# Default: (unset)
# Override agent role/preset for session
#
# AGENT_PRESET=

# Creator workflow toggle
# Values: on | off
# Default: on
# Enables creator workflow integration
#
# CREATOR_WORKFLOW=on

# Creator state TTL (milliseconds)
# Default: 3600000 (1 hour)
# How long to retain creator state
#
# CREATOR_STATE_TTL_MS=3600000

# Auto companion spawn toggle
# Values: on | off
# Default: off
# Automatically spawns companion artifacts
#
# AUTO_COMPANION_SPAWN=off

# Evolution state guard mode
# Values: block | warn | off
# Default: warn
# Validates evolution state transitions
#
# EVOLUTION_STATE_GUARD=warn

# Evolution trigger detection toggle
# Values: on | off
# Default: on
# Detects when evolution workflow should trigger
#
# EVOLUTION_TRIGGER_DETECTION=on

# Evolution audit mode
# Values: on | off
# Default: on
# Audits evolution workflow executions
#
# EVOLUTION_AUDIT=on

# Security trigger mode
# Values: block | warn | off
# Default: warn
# Triggers security reviews for sensitive code
#
# SECURITY_TRIGGER=warn

# Security trigger debug logging
# Values: on | off
# Default: off
#
# SECURITY_TRIGGER_DEBUG=off

# Supply Chain Security — External Content Guard (SEC-EXT-007)
# Enforcement mode for fetches from unverified external sources
# Options: warn (log only) | block (exit 2, reject tool) | off (disabled)
EXTERNAL_CONTENT_GUARD_MODE=warn

# Registry consistency check toggle
# Values: on | off
# Default: on
# Validates agent registry consistency
#
# REGISTRY_CONSISTENCY_CHECK=on

# Registry consistency gate mode
# Values: block | warn | off
# Default: warn
# Gates execution on registry inconsistencies
#
# REGISTRY_CONSISTENCY_GATE=warn

# Agent registry path override
# Default: .claude/context/agent-registry.json
#
# AGENT_REGISTRY_PATH=

# Routing prototypes cache toggle
# Values: on | off
# Default: on
# Caches routing decision prototypes
#
# ROUTING_PROTOTYPES_CACHE=on

# Allowed tools enricher toggle (duplicate - see Section 10a)
# Already defined in Section 10a
# ALLOWED_TOOLS_ENRICHER=on

# Allow unregistered commands
# Values: on | off
# Default: off
# Allows commands not in command catalog
#
# ALLOW_UNREGISTERED_COMMANDS=off

# Agent health hook mode
# Values: block | warn | off
# Default: off
# Monitors agent health metrics
#
# AGENT_HEALTH_HOOK=off

# Intent feedback path override
# Default: .claude/context/runtime/intent-feedback.jsonl
#
# INTENT_FEEDBACK_PATH=

# Anomaly distance threshold (standard deviations)
# Default: 3
# Distance threshold for anomaly detection
#
# ANOMALY_DISTANCE_THRESHOLD=3

# Violation metrics max lines
# Default: 2000
#
# VIOLATION_METRICS_MAX_LINES=2000

# Violation metrics rate limit (ms)
# Default: 60000 (1 minute)
#
# VIOLATION_METRICS_RATE_LIMIT=60000

# Spawn log max lines
# Default: 2000
#
# SPAWN_LOG_MAX_LINES=2000

# State cache debug logging
# Values: on | off
# Default: off
#
# STATE_CACHE_DEBUG=off

# Router debug logging
# Values: on | off
# Default: off
