#   HYBRID_DAEMON_PREWARM=true
#
# ============================================================================
# CLI COMMANDS REFERENCE
# ============================================================================
#
# Code Search:
#   pnpm search:code "query"      - Hybrid code search (ripgrep + embeddings)
#   pnpm search:structure          - Show project structure + mermaid diagram
#   pnpm search:file path 1 50     - Get file content with line numbers
#
# Full Code Index (with semantic embeddings):
#   pnpm code:index:reindex        - Build BM25 + vector index (~12 min with GPU)
#                                    Uses subprocess isolation to prevent ONNX OOM
#
# See also: IMPLEMENTATION_GUIDE.md for troubleshooting
# ============================================================================

# ============================================================
# Telegram Bot Control (telegram-polling skill)
# ============================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Your bot's username (set after bot creation in @BotFather)
TELEGRAM_BOT_USERNAME=Agent_studio_bot
# Your personal Telegram user ID (get from @userinfobot)
TELEGRAM_OWNER_ID=your_numeric_telegram_user_id
# Optional: owner @username (no @ prefix)
TELEGRAM_OWNER_USERNAME=YourTelegramUsername
# Numeric Telegram user_id for inline mentions
TELEGRAM_OWNER_CHAT_ID=
# Comma-separated Telegram user IDs allowed to use the bot (include your owner ID)
# If empty or missing, ALL commands are silently blocked (fail-closed)
TELEGRAM_ALLOWED_USERS=your_numeric_telegram_user_id
# Full path to claude CLI binary — needed when cron/heartbeat runs outside interactive shell
# Run `where claude` (Windows) or `which claude` (Mac/Linux) to find the path
# If not set, script auto-detects via where/which at startup
CLAUDE_CLI_PATH=
# Optional: comma-separated chat IDs to monitor (leave empty for DM-only)
TELEGRAM_CHAT_IDS=

# ============================================================
# Heartbeat Research Loops
# ============================================================
# Comma-separated ArXiv search keywords for Loop 7 (arxiv-monitor skill)
ARXIV_KEYWORDS=multi-agent systems,LLM reasoning,autonomous agents,RAG,tool use
# Max papers returned per keyword per run
# Default: 10
ARXIV_MAX_RESULTS=10
# Days to look back for new papers
# Default: 7
ARXIV_LOOKBACK_DAYS=7
# JSON array of web topics for Loop 7 (exa-monitor skill)
EXA_MONITOR_TOPICS=["Claude AI updates","agent frameworks","LLM tooling","AI safety"]
# Max results per topic per run
# Default: 5
EXA_MAX_RESULTS=5
# Let Exa optimize the query automatically
# Default: true
EXA_AUTOPROMPT=true
EXTERNAL_CONTENT_GUARD_FAIL_OPEN=false

# ============================================================================
# P0 Features (2026-03-16 EPIC Upgrade)
# ============================================================================

# Adversarial Review: force code-reviewer to find issues or re-analyze (default: false — opt-in)
ADVERSARIAL_REVIEW=false

# Project Context: auto-inject project-context.md into spawn prompts (default: on)
PROJECT_CONTEXT_INJECTION=on

# Project Context: max characters to inject (default: 2048)
PROJECT_CONTEXT_CHAR_LIMIT=2048

# Task Output Guardrails: enforcement mode (default: warn)
TASK_GUARDRAIL_ENFORCEMENT=warn

# Worktree Preflight Check: enforcement mode (default: block)
WORKTREE_PREFLIGHT_ENFORCEMENT=block

# ccusage Status Line: show token usage + cost on every prompt (default: on)
# Set to "off" to suppress the status line entirely.
# Requires ccusage CLI (npx ccusage@1) to be reachable for live data.
# When CCUSAGE_DISABLED=true the status line is silently skipped.
# CCUSAGE_STATUSLINE=off
