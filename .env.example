# ROUTER_DEBUG=off

# Metrics debug logging
# Values: on | off
# Default: off
#
# METRICS_DEBUG=off

# Platform debug logging
# Values: on | off
# Default: off
#
# PLATFORM_DEBUG=off

# Memory debug logging
# Values: on | off
# Default: off
#
# MEMORY_DEBUG=off

# Code index debug logging
# Values: on | off
# Default: off
#
# CODE_INDEX_DEBUG=off

# Debug health hook logging
# Values: on | off
# Default: off
#
# DEBUG_HEALTH_HOOK=off

# Debug error capture logging
# Values: on | off
# Default: off
#
# DEBUG_ERROR_CAPTURE=off

# Debug error writer logging
