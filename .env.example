#   CODE_INDEX_MAX_FILE_SIZE=524288
#   CODE_INDEX_EMBEDDER=fastembed
#   HEAP_CRITICAL_THRESHOLD=75
#   HYBRID_EMBEDDINGS=on
#   HYBRID_SEARCH_DAEMON=on
