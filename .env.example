# ============================================================================
# Agent-Studio Environment Variables
# ============================================================================
# Copy this file to .env and customize for your local environment
# NOTE: .env is gitignored and will NOT be committed
#
# Version: 2.2.3
# Last Updated: 2026-02-01 (LanceDB + ML persistence + retention)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ENVIRONMENT SELECTION (CRITICAL)
# ----------------------------------------------------------------------------
# Controls which configuration file is loaded and which paths are used
# Values: development | staging | production
# Default: development
#
AGENT_STUDIO_ENV=development

# Fallback environment selector (used if AGENT_STUDIO_ENV not set)
# Values: development | production
# Default: development
#
# NODE_ENV=development

# ----------------------------------------------------------------------------
# 2. FEATURE FLAGS (Override config.yaml)
# ----------------------------------------------------------------------------
# Party Mode: Multi-agent collaboration framework
# Default: false (must be explicitly enabled)
#
# PARTY_MODE_ENABLED=false

# Advanced Elicitation: Multi-method requirements gathering
# Default: false (must be explicitly enabled)
#
# ELICITATION_ENABLED=false

# ----------------------------------------------------------------------------
# 3. REFLECTION HOOKS (Quality & Learning)
# ----------------------------------------------------------------------------
# Enable/disable all reflection hooks
# Default: true (enabled)
#
# REFLECTION_ENABLED=true

# Reflection hook enforcement mode
# Values: block | warn | off
# Default: block
#
# REFLECTION_HOOK_MODE=block

# ----------------------------------------------------------------------------
# 4. SAFETY HOOKS (Loop Prevention, Anomaly Detection)
# ----------------------------------------------------------------------------
# Loop prevention enforcement mode
# Values: block | warn | off
# Default: block
#
# LOOP_PREVENTION_MODE=block

# Max evolution suggestions before loop detected
# Default: 3
#
# LOOP_EVOLUTION_BUDGET=3

# Cooldown period after loop detection (milliseconds)
# Default: 60000 (1 minute)
#
# LOOP_COOLDOWN_MS=60000

# Max recursion depth before loop flagged
# Default: 5
#
# LOOP_DEPTH_LIMIT=5

# Pattern repetitions before flagged as loop
# Default: 3
#
# LOOP_PATTERN_THRESHOLD=3

# Allow operations if loop prevention hook fails
# Default: false (fail-secure)
#
# LOOP_PREVENTION_FAIL_OPEN=false

# ----------------------------------------------------------------------------
# 5. ANOMALY DETECTION
# ----------------------------------------------------------------------------
# Enable/disable anomaly detection
# Default: true
#
# ANOMALY_DETECTION_ENABLED=true

# Token usage anomaly threshold (multiplier of baseline)
# Default: 2
#
# ANOMALY_TOKEN_MULTIPLIER=2

# Duration anomaly threshold (multiplier of baseline)
# Default: 3
#
# ANOMALY_DURATION_MULTIPLIER=3

# Consecutive failures before alert
# Default: 3
#
# ANOMALY_FAILURE_COUNT=3

# Pattern repetitions before flagged
# Default: 2
#
# ANOMALY_PATTERN_REPS=2

# ----------------------------------------------------------------------------
# 6. ROUTING & ORCHESTRATION
# ----------------------------------------------------------------------------
# Auto-rerouter behavior
# Values: suggest | block | off
# Default: suggest
#
# REROUTER_MODE=suggest

# Plan evolution guard mode
# Values: block | warn | off
# Default: block
#
# PLAN_EVOLUTION_GUARD=block

# ----------------------------------------------------------------------------
# 7. SHELL COMMAND SECURITY (ADR-077)
# ----------------------------------------------------------------------------
# Project root directory (used by shell security validators)
# Default: auto-detected from cwd
# NOTE: Should be absolute path to prevent path traversal attacks
#
PROJECT_ROOT=C:\dev\projects\agent-studio

# Bash CWD Validator enforcement mode
# Values: block | warn | off
# Default: block
# Purpose: Ensures background Bash tasks initialize CWD to PROJECT_ROOT
# Prevents: Filesystem traversal, data exposure, resource exhaustion
#
BASH_CWD_VALIDATOR=block

# Shell Injection Validator enforcement mode
# Values: block | warn | off
# Default: block
# Purpose: Blocks dangerous shell patterns (rm -rf /, eval, etc.)
# Prevents: Arbitrary command execution, data destruction
#
SHELL_INJECTION_VALIDATOR=block

# Variable Quoting Validator enforcement mode
# Values: block | warn | off
# Default: warn
# Purpose: Detects unquoted variables in Bash commands
# Prevents: Word splitting, glob expansion, injection in dangerous contexts
#
VARIABLE_QUOTING_VALIDATOR=warn

# Shellcheck Validator enforcement mode (Phase 3)
# Values: block | warn | off
# Default: off (requires shellcheck installed)
# Purpose: Static analysis of shell commands
# Prevents: Syntax errors, portability issues, common bugs
#
# SHELLCHECK_VALIDATOR=off

# Command Allowlist Validator enforcement mode (Phase 3)
# Values: block | warn | off
# Default: warn
# Purpose: Restricts background tasks to approved commands
# Prevents: Unauthorized command execution
#
# COMMAND_ALLOWLIST_VALIDATOR=warn

# ----------------------------------------------------------------------------
# 8. SESSION & DEBUGGING
# ----------------------------------------------------------------------------
# Override session ID (useful for testing)
# Default: auto-generated
#
# CLAUDE_SESSION_ID=

# Enable verbose hook debugging logs
# Default: false
#
# DEBUG_HOOKS=false

# ----------------------------------------------------------------------------
# 9. EXTERNAL INTEGRATIONS (Optional)
# ----------------------------------------------------------------------------
# Webhook authentication secret (if using webhooks)
# Default: null (webhooks disabled)
#
# WEBHOOK_SECRET=

# External API endpoint (if using external services)
# Default: http://localhost:3000
#
# API_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 10. MEMORY SYSTEM (SQLite + LanceDB)
# ----------------------------------------------------------------------------
# Memory System Phased Rollout
# Enable/disable hybrid memory system (SQLite entity graph + embedded LanceDB semantic search)
# Default: false (must be explicitly enabled)
#
# MEMORY_SYSTEM_ENABLED=false

# Gradual rollout percentage for memory system (0-100)
# Default: 0 (disabled for all sessions)
# Recommended phases: 10 → 50 → 100
#
# MEMORY_ROLLOUT_PERCENTAGE=0

# Semantic search toggle used by ContextualMemory
# Values: on | off
# Default: on
#
# MEMORY_SEMANTIC_SEARCH=on

# Embedded LanceDB storage directory (local, no server required)
# Default: .claude/data/lancedb
#
# LANCEDB_URI=.claude/data/lancedb

# LanceDB table name for memory vectors
# Default: agent_memory
#
# LANCEDB_TABLE=agent_memory

# Embedding mode for LanceDB upserts/search
# Values: transformers | test | off
# Default: transformers
#
# Notes:
# - transformers: uses @xenova/transformers local embeddings (requires sharp to be built)
# - test: stable deterministic embeddings for tests
# - off: disables embeddings (semantic search will fail)
#
# LANCEDB_EMBEDDING_MODE=transformers

# Embedding model ID for @xenova/transformers
# Default: Xenova/all-MiniLM-L6-v2
#
# LANCEDB_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Background sync worker interval (milliseconds)
# Default: 60000 (60 seconds)
# Periodic sync for memory files to SQLite and LanceDB
#
# MEMORY_SYNC_INTERVAL_MS=60000

# Retention + cold storage (keeps LTM bounded; archives older summaries)
# See: .claude/docs/MEMORY_SYSTEM.md
#
# MEMORY_LTM_MAX_SUMMARIES=50
# MEMORY_COLD_ENABLE=true
# MEMORY_COLD_ARCHIVE_AFTER_DAYS=
# MEMORY_COLD_DIR=.claude/context/memory/cold

# ----------------------------------------------------------------------------
# 11. EVENT SYSTEM (Event-Driven Orchestration)
# ----------------------------------------------------------------------------
# Enable/disable EventBus (event-driven agent coordination)
# Default: true (enabled)
# When disabled, hooks/agents will not emit events
#
# EVENT_BUS_ENABLED=true

# Enable/disable priority-based event handling
# Default: true (enabled)
# When enabled, HIGH priority events processed before NORMAL/LOW
#
# EVENT_PRIORITY_ENABLED=true

# Event retention period (milliseconds)
# Default: 3600000 (1 hour)
# Events older than this are cleaned up to prevent memory leaks
#
# EVENT_RETENTION_MS=3600000

# Max event listeners per event type
# Default: 100
# Prevents memory leaks from unlimited listener registration
#
# EVENT_MAX_LISTENERS=100

# ----------------------------------------------------------------------------
# 12. AGENT EXECUTION LIMITS (Safety & Cost Control)
# ----------------------------------------------------------------------------
# Default max turns for agent execution
# Default: 50 (can be overridden per-agent in spawn params)
# Prevents infinite loops and runaway agents
#
# DEFAULT_MAX_TURNS=50

# Default max duration in milliseconds
# Default: 1800000 (30 minutes)
# Prevents long-running agents from blocking resources
#
# DEFAULT_MAX_DURATION_MS=1800000

# Default max cost in USD
# Default: 5.00
# Prevents unexpected API cost overruns
#
# DEFAULT_MAX_COST_USD=5.00

# Warning threshold (0.0-1.0)
# Default: 0.8 (80%)
# Emits AGENT_LIMIT_WARNING event when this threshold is reached
#
# EXECUTION_LIMIT_WARNING_THRESHOLD=0.8

# Timeout action when limits exceeded
# Values: warn | terminate | pause
# Default: terminate
# - warn: Log warning and continue
# - terminate: Stop agent execution immediately
# - pause: Pause and wait for manual intervention
#
# EXECUTION_TIMEOUT_ACTION=terminate

# Enable execution limit monitoring
# Default: true (enabled)
# When disabled, limits are not enforced (use for debugging only)
#
# EXECUTION_LIMITS_ENABLED=true

# ----------------------------------------------------------------------------
# 13. ERROR LOGGING CONFIGURATION (Production Quality)
# ----------------------------------------------------------------------------
# Enable/disable error logging system
# Default: true (enabled)
# Captures all agent errors with sensitive data masking
#
# ERROR_LOGGING_ENABLED=true

# Error capture hook enforcement mode
# Values: block | warn | off
# Default: block
# - block: Prevents invalid error logging (production-safe)
# - warn: Logs warnings but continues (development)
# - off: Disables error logging (not recommended)
#
# ERROR_CAPTURE_HOOK=block

# Agent tools validator enforcement mode
# Values: block | warn | off
# Default: block
# - block: Prevents agents from using invalid tools
# - warn: Logs warnings for tool misuse
# - off: Disables tool validation
#
# AGENT_TOOLS_VALIDATOR=block

# Enable reflection error summary extraction
# Default: true (enabled)
# Integrates error data into daily reflection cycle
#
# REFLECT_ERROR_SUMMARY=true

# Error log retention period (days)
# Default: 7 (active errors)
# How long to keep error logs before archiving
#
# ERROR_RETENTION_DAYS=7

# Error archive retention period (days)
# Default: 30 (archived errors)
# Total retention including archived logs
#
# ERROR_ARCHIVE_RETENTION_DAYS=30

# Error log storage location
# Default: .claude/context/artifacts/error-reports/
# Directory where error logs are stored
#
# ERROR_LOG_LOCATION=.claude/context/artifacts/error-reports/

# ----------------------------------------------------------------------------
# 14. HEAP MEMORY CONFIGURATION (Memory Safeguards)
# ----------------------------------------------------------------------------
# Heap memory configuration for Node.js processes.
# Prevents OOM crashes during multi-agent orchestration.
#
# Recommended values by environment:
#   - development: 4096 (4GB) - sufficient for most dev workflows
#   - staging: 8192 (8GB) - allows testing with larger agent swarms
#   - production: 12288 (12GB) - handles enterprise-scale orchestration
#
# To configure, set NODE_OPTIONS before running claude:
#   export NODE_OPTIONS="--max-old-space-size=8192"
#
# Or in package.json scripts:
#   "start": "NODE_OPTIONS=--max-old-space-size=8192 node ..."
#
# Note: This is a comment-only section. NODE_OPTIONS should be set
# at the shell level, not in .env (Node reads NODE_OPTIONS before dotenv).
#
# NODE_OPTIONS=--max-old-space-size=8192

# Heap warning threshold (percentage of heap limit)
# Default: 70 (70%)
# When heap usage exceeds this, emit warnings and consider pausing spawns
#
HEAP_WARNING_THRESHOLD=70

# Heap critical threshold (percentage of heap limit)
# Default: 85 (85%)
# When heap usage exceeds this, pause agent spawning until memory recovers
#
HEAP_CRITICAL_THRESHOLD=85

# Heap shutdown threshold (percentage of heap limit)
# Default: 95 (95%)
# When heap usage exceeds this, trigger emergency cleanup and GC
# Agent spawning is blocked until heap drops below critical threshold
#
HEAP_SHUTDOWN_THRESHOLD=95

# Memory monitor polling interval (milliseconds)
# Default: 5000 (5 seconds)
# How frequently to check heap usage
#
MEMORY_MONITOR_INTERVAL_MS=5000

# Memory monitor history size
# Default: 100
# Number of memory snapshots to retain for trend analysis
#
MEMORY_HISTORY_SIZE=100

# Enable memory-based spawn throttling
# Default: true
# When enabled, routing-guard will pause spawns at critical threshold
#
MEMORY_SPAWN_THROTTLING=true

# Task cleanup retention period (milliseconds)
# Default: 1800000 (30 minutes)
# How long to retain completed tasks before cleanup
#
TASK_CLEANUP_RETENTION_MS=1800000

# Task cleanup interval (milliseconds)
# Default: 60000 (1 minute)
# How frequently to run task cleanup
#
TASK_CLEANUP_INTERVAL_MS=60000

# Task cleanup batch size
# Default: 100
# Maximum tasks to clean up per interval
#
TASK_CLEANUP_BATCH_SIZE=100

# ----------------------------------------------------------------------------
# 15. PHASE 5 ML FEATURES (Pattern Recognition & Optimization)
# ----------------------------------------------------------------------------
# Enable/disable ML pattern detection
# Default: false (must be explicitly enabled)
# Detects workflow patterns using N-grams, anomaly detection, clustering
#
# PATTERN_DETECTION_ENABLED=false

# Enable/disable ML cost prediction
# Default: false (must be explicitly enabled)
# Predicts LLM costs using token estimation and model pricing
#
# COST_PREDICTION_ENABLED=false

# Enable/disable adaptive execution optimization
# Default: false (must be explicitly enabled)
# Optimizes execution based on learned patterns (parallelization, batching, caching)
#
# ADAPTIVE_EXECUTION_ENABLED=false

# Enable/disable performance profiling
# Default: false (must be explicitly enabled)
# Tracks execution metrics for bottleneck detection
#
# PERFORMANCE_PROFILING_ENABLED=false

# Enable/disable pattern library persistence
# Default: false (must be explicitly enabled)
# Stores learned patterns for future optimization
#
# PATTERN_LIBRARY_ENABLED=false

# Pattern detection minimum support threshold (0.0-1.0)
# Default: 0.1 (10%)
# Minimum frequency for pattern to be considered significant
#
# PATTERN_MIN_SUPPORT=0.1

# Pattern detection minimum confidence threshold (0.0-1.0)
# Default: 0.6 (60%)
# Minimum confidence for pattern recommendation
#
# PATTERN_MIN_CONFIDENCE=0.6

# Adaptive executor max concurrency
# Default: 10
# Maximum parallel tasks for adaptive execution
#
# ADAPTIVE_MAX_CONCURRENCY=10

# Cost prediction budget alert threshold (USD)
# Default: 10.00
# Emit warning when session cost exceeds this threshold
#
# COST_BUDGET_ALERT_USD=10.00

# Performance profiler sampling interval (milliseconds)
# Default: 1000 (1 second)
# How frequently to sample performance metrics
#
# PROFILER_SAMPLE_INTERVAL_MS=1000

# Pattern library max stored patterns
# Default: 1000
# Maximum patterns to retain in library (LRU eviction)
#
# PATTERN_LIBRARY_MAX_SIZE=1000

# ML automation mode (gates retraining + persistence)
# Values: off | log | enforce
# Default: off
#
# off: ingest-only; does not retrain when threshold is hit
# log: retrain + persist (advice-only logging)
# enforce: retrain + persist; may apply config in future (currently same as log)
#
# ML_AUTOMATION_MODE=off

# Verbose ML debug logging
# Default: false
#
# ML_DEBUG=false

# Retraining threshold (sessions ingested before retrain)
# Default: 10
#
# ML_RETRAIN_THRESHOLD=10

# Training window (how many recent sessions to use for training rebuild)
# Default: 200
#
# ML_TRAINING_WINDOW=200

# Cap ML session log size (lines) to keep disk usage bounded
# Default: 2000
#
# ML_SESSION_LOG_MAX_LINES=2000

# Optional overrides for where ML state is persisted.
# Defaults to `.claude/context/ml/*` (required for hook execution across processes).
#
# ML_MODEL_PATH=.claude/context/ml/pattern-model.json
# ML_POLICY_PATH=.claude/context/ml/optimization-policies.json
# ML_FEEDBACK_STATE_PATH=.claude/context/ml/feedback-loop-state.json
# ML_SESSIONS_LOG_PATH=.claude/context/ml/sessions.jsonl

# ============================================================================
# STAGING ENVIRONMENT NOTES (Sections 1-15)
# ============================================================================
# When AGENT_STUDIO_ENV=staging:
# - Uses .claude/config.staging.yaml instead of config.yaml
# - Data paths: .claude/staging/* (isolated from development)
# - All features enabled by default for testing
# - Relaxed monitoring thresholds (2x production)
# - Verbose logging enabled
#
# Configuration Sections:
# 1. Environment Selection (CRITICAL)
# 2. Feature Flags (Party Mode, Elicitation)
# 3. Reflection Hooks (Quality & Learning)
# 4. Safety Hooks (Loop Prevention, Anomaly Detection)
# 5. Anomaly Detection
# 6. Routing & Orchestration
# 7. Shell Command Security (ADR-077)
# 8. Session & Debugging
# 9. External Integrations (Optional)
# 10. Memory System (SQLite + LanceDB)
# 11. Event System (Event-Driven Orchestration)
# 12. Agent Execution Limits (Safety & Cost Control)
# 13. Error Logging Configuration (Production Quality)
# 14. Heap Memory Configuration (Memory Safeguards)
# 15. Phase 5 ML Features (Pattern Recognition & Optimization)
#
# Setup staging:
#   1. Set AGENT_STUDIO_ENV=staging
#   2. Run: node .claude/tools/cli/init-staging.cjs
#   3. Verify: node --test tests/staging-smoke.test.mjs
#
# See: .claude/docs/STAGING_ENVIRONMENT.md
# ============================================================================
