{
  "name": "agent-studio",
  "version": "2.0.0",
  "description": "Multi-platform agent configuration bundle for Claude Code, Cursor IDE, and Factory Droid",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node .claude/scripts/ensure-routing-prototypes.cjs",
    "format": "node scripts/format-tracked.mjs --write",
    "format:check": "node scripts/format-tracked.mjs --check",
    "integration:headless": "node .claude/tools/run-agent-framework-integration-headless.mjs",
    "integration:headless:json": "node .claude/tools/run-agent-framework-integration-headless.mjs --json --expected-agents core --timeout-ms 90000 --store-payloads --denial-test",
    "worker:summary": "node .claude/tools/cli/worker-metrics-summary.cjs",
    "metrics:spawn:summary": "node .claude/tools/cli/spawn-assembly-metrics-summary.cjs --hours 24",
    "metrics:spawn:ci": "node .claude/tools/cli/spawn-assembly-metrics-summary.cjs --hours 24 --assert-max-p95-ms 300 --assert-max-burn-rate 900 --assert-min-compactness 60 --json",
    "metrics:routing:summary": "node .claude/tools/cli/router-churn-summary.cjs --hours 24",
    "metrics:routing:ci": "node .claude/tools/cli/router-churn-summary.cjs --hours 24 --require-data true --assert-max-block-rate 70 --assert-max-repeated-blocks 8 --json",
    "metrics:runtime:summary": "node .claude/tools/cli/runtime-health-summary.cjs --hours 24",
    "metrics:runtime:ci": "node .claude/tools/cli/runtime-health-summary.cjs --hours 24 --require-data true --assert-max-p95-ms 400 --assert-max-heap-mb 512 --json",
    "metrics:memory:slo:summary": "node .claude/tools/cli/memory-slo-summary.cjs --json",
    "metrics:memory:slo:ci": "node .claude/tools/cli/memory-slo-summary.cjs --require-data true --assert-max-write-p95-ms 120 --assert-max-lock-wait-p95-ms 40 --assert-max-parse-failure-rate 0.02 --assert-max-churn-rate 0.8 --json",
    "metrics:memory-cache:summary": "node .claude/tools/cli/memory-cache-stability-summary.cjs --hours 24",
    "metrics:memory-cache:ci": "node .claude/tools/cli/memory-cache-stability-summary.cjs --hours 24 --require-data true --assert-max-churn-rate 0.75 --assert-min-stable-rate 0.25 --json",
    "metrics:findings:summary": "node .claude/tools/cli/open-findings-summary.cjs --json",
    "metrics:findings:ci": "node .claude/tools/cli/open-findings-summary.cjs --json --assert-max-open-critical 0 --assert-max-open-high 5",
    "metrics:findings:trend:summary": "node .claude/tools/cli/open-findings-trend-summary.cjs --json --days 7",
    "metrics:findings:trend:ci": "node .claude/tools/cli/open-findings-trend-summary.cjs --json --days 7 --require-data true --assert-max-open-delta 10",
    "metrics:ci": "pnpm metrics:spawn:ci && pnpm metrics:routing:ci && pnpm metrics:runtime:ci && pnpm metrics:memory:slo:ci && pnpm metrics:memory-cache:ci",
    "validate": "node --max-old-space-size=4096 --expose-gc scripts/validate-config.mjs && node --max-old-space-size=4096 --expose-gc scripts/validate-model-names.mjs",
    "validate:full": "pnpm validate && node --max-old-space-size=4096 --expose-gc scripts/validate-workflow.mjs && node --max-old-space-size=4096 --expose-gc scripts/validate-all-references.mjs && pnpm validate:cujs && pnpm validate:index && pnpm index-rules && pnpm validate:schemas && pnpm validate:commands",
    "validate:verbose": "node --max-old-space-size=4096 --expose-gc scripts/validate-config.mjs --verbose && node --max-old-space-size=4096 --expose-gc scripts/validate-model-names.mjs --verbose",
    "validate:sync": "node scripts/validation/validate-sync.mjs",
    "validate:models": "node --max-old-space-size=4096 --expose-gc scripts/validate-model-names.mjs",
    "validate:workflow": "node --max-old-space-size=4096 --expose-gc scripts/validate-workflow.mjs",
    "validate:references": "node --max-old-space-size=4096 --expose-gc scripts/validate-all-references.mjs",
    "validate:schemas": "node .claude/tools/validate-latest-integration-artifacts.mjs --json",
    "validate:cujs": "node --max-old-space-size=4096 --expose-gc .claude/tools/cuj-validator-unified.mjs --doctor",
    "validate:cuj": "node --max-old-space-size=4096 --expose-gc .claude/tools/cuj-validator-unified.mjs",
    "validate:cujs:e2e": "node --max-old-space-size=4096 --expose-gc .claude/tools/cuj-validator-unified.mjs --mode full",
    "validate:cujs:dry-run": "node --max-old-space-size=4096 --expose-gc .claude/tools/cuj-validator-unified.mjs --mode dry-run",
    "validate:routing": "node .claude/scripts/validate-routing-consistency.cjs",
    "context:reset": "node scripts/reset-context.cjs",
    "validate:index": "node scripts/validate-index.mjs",
    "validate:index-version": "node scripts/validate-rule-index-paths.mjs --check-version",
    "validate:index-paths": "node scripts/validate-rule-index-paths.mjs",
    "validate:all": "pnpm validate:full",
    "test:version-validation": "node scripts/test-version-validation.mjs",
    "install-agents": "node scripts/install.mjs",
    "index-rules": "node scripts/generate-rule-index.mjs",
    "index-rules:prebuilt": "node scripts/generate-prebuilt-rule-index.mjs",
    "cuj:doctor": "node --max-old-space-size=4096 --expose-gc .claude/tools/cuj-validator-unified.mjs --mode doctor",
    "cuj:doctor:json": "node --max-old-space-size=4096 --expose-gc .claude/tools/cuj-validator-unified.mjs --mode doctor --format json",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.{mjs,cjs}\"",
    "test:staging:smoke": "node --test tests/staging-smoke.test.mjs",
    "test:staging": "cross-env AGENT_STUDIO_ENV=staging node --test --test-concurrency=1 tests/*.test.mjs",
    "test:hooks": "echo 'Hook tests archived - see .claude.archive/.claude.old/tests/'",
    "test:hooks:memory": "echo 'Hook tests archived - see .claude.archive/.claude.old/tests/'",
    "test:hooks:stress": "echo 'Hook tests archived - see .claude.archive/.claude.old/tests/'",
    "test:unit": "node --test --test-concurrency=1 tests/unit/**/*.test.mjs tests/unit/**/*.test.cjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:tools": "node --test --test-concurrency=1 \".claude/tools/**/*.test.mjs\" \".claude/tools/**/*.test.cjs\"",
    "test:framework": "node --test --test-concurrency=1 .claude/hooks/**/*.test.cjs .claude/lib/**/*.test.cjs tests/hooks/*.test.cjs tests/lib/agents/*.test.cjs tests/lib/config/*.test.cjs tests/lib/qa/*.test.cjs tests/lib/plan/*.test.cjs tests/lib/memory/*.test.cjs tests/lib/monitoring/*.test.cjs tests/lib/routing/*.test.cjs tests/lib/spawn/*.test.cjs tests/lib/text-processing/*.test.cjs tests/lib/tools/*.test.cjs tests/lib/scheduler/*.test.cjs",
    "test:framework:hooks": "node --test --test-concurrency=1 .claude/hooks/**/*.test.cjs",
    "test:framework:lib": "node --test --test-concurrency=1 tests/lib/**/*.test.cjs",
    "test:memory:ci": "node --test tests/lib/memory/observations.test.cjs tests/hooks/spawn-prompt-memory-mode.test.cjs tests/hooks/unified-reflection-handler.test.cjs",
    "test:code-indexing": "node --test --test-concurrency=1 tests/code-indexing/ripgrep-integration.test.cjs tests/code-indexing/ast-grep-wrapper.test.cjs tests/code-indexing/merkle-tree.test.cjs tests/code-indexing/incremental-indexing.test.cjs tests/code-indexing/search-tools-integration.test.cjs tests/code-indexing/vector-store-lancedb.test.cjs tests/hooks/code-index-updater.test.cjs",
    "test:all": "pnpm test && pnpm test:framework && pnpm test:tools",
    "test:ci": "node --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.{mjs,cjs}\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage tests/*.test.mjs",
    "test:a2a": "echo 'A2A tests archived - see .claude.archive/.claude.old/tests/a2a-framework/'",
    "test:a2a:verbose": "echo 'A2A tests archived - see .claude.archive/.claude.old/tests/a2a-framework/'",
    "test:a2a:ci": "echo 'A2A tests archived - see .claude.archive/.claude.old/tests/a2a-framework/'",
    "lint": "eslint . --ext .js,.cjs,.mjs --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs --fix",
    "lint:staged": "eslint --ext .js,.cjs,.mjs",
    "manifest:generate": "node .claude/tools/cli/generate-tool-manifest.cjs",
    "manifest:validate": "node .claude/tools/cli/generate-tool-manifest.cjs --validate",
    "memory:init": "node .claude/tools/cli/init-memory-db.cjs",
    "memory:sync-json": "node .claude/tools/cli/sync-memory-json.cjs",
    "memory:migrate-legacy": "node .claude/tools/cli/migrate-legacy-sessions.cjs",
    "memory:weekly": "node .claude/lib/memory/memory-scheduler.cjs weekly",
    "memory:daily": "node .claude/lib/memory/memory-scheduler.cjs daily",
    "memory:status": "node .claude/lib/memory/memory-scheduler.cjs status",
    "memory:health": "node .claude/lib/memory/memory-manager.cjs health",
    "memory:dashboard": "node .claude/lib/memory/memory-dashboard.cjs",
    "memory:embeddings": "node .claude/tools/cli/generate-embeddings.cjs",
    "memory:reindex": "node .claude/tools/cli/generate-embeddings.cjs --reindex",
    "memory:extract": "node .claude/tools/cli/memory-extract.cjs",
    "memory:dashboard:budget": "node .claude/tools/cli/memory-dashboard.cjs",
    "routing:prototypes": "node .claude/tools/cli/generate-routing-prototypes.cjs",
    "routing:status": "node .claude/scripts/quick-status.cjs",
    "skills:index": "node .claude/tools/cli/generate-skill-index.cjs",
    "skills:validate": "node .claude/tools/cli/generate-skill-index.cjs --validate",
    "agents:registry": "node .claude/tools/cli/generate-agent-registry.cjs",
    "agents:registry:validate": "node .claude/tools/cli/generate-agent-registry.cjs --validate",
    "agents:catalog": "node .claude/tools/cli/generate-agent-catalog.cjs",
    "gen:agent-registry": "node .claude/tools/cli/generate-agent-registry.cjs",
    "gen:skill-index": "node .claude/tools/cli/generate-skill-index.cjs",
    "gen:tool-manifest": "node .claude/tools/cli/generate-tool-manifest.cjs",
    "gen:all-registries": "npm run gen:tool-manifest && npm run gen:skill-index && npm run gen:agent-registry",
    "validator:test": "node --test tests/hooks/pre-spawn-tool-validator.test.cjs",
    "test:ml": "node --test --test-concurrency=1 tests/ml/*.test.cjs",
    "code:index:reindex": "node --max-old-space-size=32768 .claude/tools/cli/index-codebase.cjs index",
    "search:code": "node .claude/tools/cli/hybrid-search.cjs",
    "search:structure": "node .claude/tools/cli/hybrid-search.cjs --structure",
    "search:file": "node .claude/tools/cli/hybrid-search.cjs --file",
    "search:daemon:start": "node -e \"const {spawn}=require('node:child_process'); const p=spawn(process.execPath,['.claude/tools/cli/hybrid-search-daemon.cjs'],{detached:true,stdio:'ignore',windowsHide:true}); p.unref(); console.log('hybrid-search-daemon started');\"",
    "search:daemon:status": "node .claude/tools/cli/hybrid-search.cjs --daemon status",
    "search:daemon:prewarm": "node .claude/tools/cli/hybrid-search.cjs --daemon prewarm",
    "search:daemon:stop": "node .claude/tools/cli/hybrid-search.cjs --daemon stop",
    "validate:commands": "node .claude/tools/validate-commands.mjs",
    "verify:debug-log": "node .claude/tools/cli/verify-debug-log-remediation.mjs",
    "verify:deps": "node scripts/verify-dependencies.mjs",
    "verify:hooks": "node .claude/scripts/verify-hook-modules.cjs",
    "test:count": "node scripts/testing/count-all-tests.mjs",
    "gpu:check": "node .claude/tools/cli/check-gpu.cjs",
    "graph:bootstrap": "node .claude/tools/cli/bootstrap-artifact-graph.cjs",
    "graph:health": "node .claude/tools/cli/bootstrap-artifact-graph.cjs --dry-run",
    "graph:dashboard": "node .claude/tools/cli/integration-health-dashboard.cjs",
    "detect:orphans": "node .claude/tools/_archive/detect-orphans.mjs",
    "verify:git-notes": "node .claude/tools/cli/git-notes-verify.cjs",
    "assess:ecosystem": "node .claude/tools/analysis/ecosystem-assessor/assess-ecosystem.mjs"
  },
  "keywords": [
    "claude",
    "cursor",
    "factory",
    "ai",
    "agents",
    "llm",
    "rules"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.40.5",
    "@jest/globals": "^30.2.0",
    "@lancedb/lancedb": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "fastembed": "^2.1.0",
    "glob": "^13.0.0",
    "js-yaml": "^4.1.1",
    "piscina": "^5.1.4",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.34.5",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "optionalDependencies": {
    "onnxruntime-node-gpu": "^1.14.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.7"
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@vscode/ripgrep": "^1.17.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
