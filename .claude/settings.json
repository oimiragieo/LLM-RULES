{
  "max_tokens": 60000,
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "rag_enabled": true,
  "rag_threshold": 0.7,
  "auto_context_pruning": true,
  "mcpServers": {},
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/startup/startup-failopen-audit.cjs"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/user-prompt-unified.cjs"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/handover-detector.cjs"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session/session-budget-watchdog.cjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/pre-tool-unified.cjs"
          }
        ]
      },
      {
        "matcher": "Bash|Glob|Grep|Edit|Write|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/router-tool-lockdown.cjs"
          }
        ]
      },
      {
        "matcher": "WebFetch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/external-content-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/bash-pretool-bundle.cjs"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/hybrid-search-enforcer.cjs"
          }
        ]
      },
      {
        "matcher": "Glob|Grep|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/write-pretool-bundle.cjs"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/conflict-detector.cjs"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/validate-skill-invocation.cjs"
          }
        ]
      },
      {
        "matcher": "TaskList",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/reflection-step0-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/heartbeat-step05-check.cjs"
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          }
        ]
      },
      {
        "matcher": "TaskOutput",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/spawn-token-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/task-pretool-orchestrator.cjs"
          }
        ]
      },
      {
        "matcher": "TaskCreate|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/finish-only-guard.cjs"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validation/taskupdate-contract-validator.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validation/pre-completion-validation.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/quality-gate-validator.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/metrics/post-tool-metrics-unified.cjs"
          }
        ]
      },
      {
        "matcher": "Task|TaskList|TaskOutput|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/post-task-unified.cjs"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/workflow/post-completion-chain.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/reflection-cleanup.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/quality/artifact-scoring-ledger-hook.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/workflow/post-creation-integration.cjs",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/workflow/workflow-watchdog-hook.cjs",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/cleanup/worktree-auto-cleanup.cjs",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Task|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validation/subagent-citation-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/bypass-audit-hook.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/memory/sync-memory-index.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/agent-registry-auto-refresh.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/code-index-updater.cjs"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session/post-edit-scanner.cjs"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session/analysis-paralysis-guard.cjs"
          }
        ]
      },
      {
        "matcher": "MemoryRecord",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/memory/sync-memory-index.cjs"
          }
        ]
      },
      {
        "matcher": "Task|TaskUpdate|Bash|MemoryRecord",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/unified-reflection-handler.cjs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/metrics/post-tool-metrics-unified.cjs"
          }
        ]
      },
      {
        "matcher": "Task|TaskUpdate|Bash|MemoryRecord",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/unified-reflection-handler.cjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lifecycle/session-end-memory-promotion.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/unified-reflection-handler.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/reflection-queue-processor.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/tools/cli/sanitize-debug-log.cjs --in-place"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session/pre-compact.cjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validation/check-console-log.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session/pre-compact.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/tools/cli/sanitize-debug-log.cjs --in-place"
          }
        ]
      }
    ]
  }
}
