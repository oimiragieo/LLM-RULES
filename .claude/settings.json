{
  "max_tokens": 60000,
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "rag_enabled": true,
  "rag_threshold": 0.7,
  "auto_context_pruning": true,
  "mcpServers": {},
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/force-step0-execution.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session/state-reset.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session/drift-detector.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/user-prompt-unified.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session/user-prompt-orchestrator.cjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/pre-tool-unified.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/bash-pretool-bundle.cjs"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/hybrid-search-enforcer.cjs"
          }
        ]
      },
      {
        "matcher": "Glob|Grep|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/unified-creator-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/safety/unified-pre-write-hook.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/evolution-state-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/research-enforcement.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/quality-gate-validator.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session/adaptive-quality-gate.cjs"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/conflict-detector.cjs"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety/validate-skill-invocation.cjs"
          }
        ]
      },
      {
        "matcher": "TaskList",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/reflection-step0-guard.cjs"
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          }
        ]
      },
      {
        "matcher": "TaskOutput",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/spawn-prompt-assembler.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/pre-task-unified.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/routing-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/safety/spawn-prompt-validator.cjs"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validation/pre-completion-validation.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validation/creator-compliance-validator.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/evolution/quality-gate-validator.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/metrics/post-tool-metrics-unified.cjs"
          }
        ]
      },
      {
        "matcher": "Task|TaskList",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/routing/post-task-unified.cjs"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/workflow/post-completion-chain.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/workflow/post-creation-integration.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/memory/sync-memory-index.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/routing/code-index-updater.cjs"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session/post-edit-scanner.cjs"
          }
        ]
      },
      {
        "matcher": "MemoryRecord",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/memory/sync-memory-index.cjs"
          }
        ]
      },
      {
        "matcher": "Task|TaskUpdate|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/unified-reflection-handler.cjs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/metrics/post-tool-metrics-unified.cjs"
          }
        ]
      },
      {
        "matcher": "Task|TaskUpdate|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/unified-reflection-handler.cjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/unified-reflection-handler.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/reflection/reflection-queue-processor.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/tools/cli/sanitize-debug-log.cjs --in-place"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validation/check-console-log.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session/pre-compact.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/tools/cli/sanitize-debug-log.cjs --in-place"
          }
        ]
      }
    ]
  }
}
