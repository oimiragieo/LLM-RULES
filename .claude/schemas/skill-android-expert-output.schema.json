{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Android Expert Output",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "output": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "const": "Kotlin"
        },
        "framework": {
          "type": "string",
          "enum": [
            "Jetpack Compose",
            "XML Views",
            "Combined"
          ]
        },
        "androidVersion": {
          "type": "string",
          "description": "Minimum Android API level (e.g., '24')"
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "componentType": {
                "type": "string",
                "enum": [
                  "composable",
                  "viewmodel",
                  "repository",
                  "entity",
                  "usecase",
                  "di",
                  "other"
                ]
              },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecture": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "MVVM",
                "MVI",
                "MVP",
                "Other"
              ]
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-android-expert-output.schema.json"
}
