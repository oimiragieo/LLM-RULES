{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://llm-rules.com/schemas/project-analysis.schema.json",
  "title": "Project Analysis",
  "version": "1.0.0",
  "description": "Schema for brownfield project analysis output generated by project-analyzer skill",
  "type": "object",
  "required": ["analysis_id", "project_type", "analyzed_at", "stats", "frameworks", "structure"],
  "properties": {
    "analysis_id": {
      "type": "string",
      "pattern": "^analysis-[a-z0-9-]+$",
      "description": "Unique identifier for this analysis run",
      "maxLength": 100
    },
    "project_type": {
      "type": "string",
      "enum": [
        "frontend",
        "backend",
        "fullstack",
        "library",
        "cli",
        "mobile",
        "monorepo",
        "microservices",
        "serverless",
        "unknown"
      ],
      "description": "Primary project classification"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when analysis was performed"
    },
    "project_root": {
      "type": "string",
      "description": "Absolute path to project root directory",
      "maxLength": 500
    },
    "stats": {
      "type": "object",
      "required": ["total_files", "total_lines", "languages"],
      "description": "Quantitative project statistics",
      "additionalProperties": false,
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of source files"
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0,
          "description": "Total lines of code across all files"
        },
        "languages": {
          "type": "object",
          "description": "Lines of code per language",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "file_types": {
          "type": "object",
          "description": "Count of files by extension",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "directories": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of directories"
        },
        "avg_file_size_lines": {
          "type": "number",
          "minimum": 0,
          "description": "Average lines per file"
        },
        "largest_files": {
          "type": "array",
          "maxItems": 10,
          "description": "Top 10 largest files by line count",
          "items": {
            "type": "object",
            "required": ["path", "lines"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative file path",
                "maxLength": 500
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "description": "Detected frameworks and libraries",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["name", "category", "confidence"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Framework or library name",
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "description": "Detected version (if available)",
            "maxLength": 50
          },
          "category": {
            "type": "string",
            "enum": [
              "framework",
              "ui-library",
              "state-management",
              "testing",
              "build-tool",
              "database",
              "orm",
              "api",
              "auth",
              "logging",
              "monitoring",
              "utility",
              "other"
            ],
            "description": "Category of the dependency"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Detection confidence (0-1)"
          },
          "source": {
            "type": "string",
            "enum": [
              "package.json",
              "requirements.txt",
              "go.mod",
              "Cargo.toml",
              "pom.xml",
              "build.gradle",
              "imports",
              "config"
            ],
            "description": "How the framework was detected"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "required": ["root_directories", "entry_points"],
      "description": "Project structure analysis",
      "additionalProperties": false,
      "properties": {
        "root_directories": {
          "type": "array",
          "description": "Top-level directories",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["name", "purpose"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "source",
                  "tests",
                  "config",
                  "docs",
                  "build",
                  "scripts",
                  "assets",
                  "public",
                  "vendor",
                  "unknown"
                ]
              },
              "file_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "entry_points": {
          "type": "array",
          "description": "Application entry points",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["path", "type"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500
              },
              "type": {
                "type": "string",
                "enum": ["main", "index", "app", "server", "handler", "cli", "test", "config"]
              }
            }
          }
        },
        "architecture_pattern": {
          "type": "string",
          "enum": [
            "mvc",
            "mvvm",
            "layered",
            "hexagonal",
            "clean-architecture",
            "microservices",
            "serverless",
            "monolith",
            "modular",
            "flat",
            "unknown"
          ],
          "description": "Detected architectural pattern"
        },
        "module_system": {
          "type": "string",
          "enum": ["esm", "commonjs", "umd", "amd", "mixed", "none"],
          "description": "JavaScript/TypeScript module system"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Dependency analysis",
      "additionalProperties": false,
      "properties": {
        "production": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of production dependencies"
        },
        "development": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of development dependencies"
        },
        "outdated": {
          "type": "array",
          "description": "Outdated dependencies",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["name", "current", "latest"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 100 },
              "current": { "type": "string", "maxLength": 50 },
              "latest": { "type": "string", "maxLength": 50 },
              "breaking": { "type": "boolean" }
            }
          }
        },
        "vulnerabilities": {
          "type": "array",
          "description": "Known security vulnerabilities",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["package", "severity"],
            "additionalProperties": false,
            "properties": {
              "package": { "type": "string", "maxLength": 100 },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "advisory": { "type": "string", "maxLength": 2000 }
            }
          }
        }
      }
    },
    "code_quality": {
      "type": "object",
      "description": "Code quality indicators",
      "additionalProperties": false,
      "properties": {
        "linting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configured": { "type": "boolean" },
            "tool": { "type": "string", "maxLength": 100 },
            "issues_count": { "type": "integer", "minimum": 0 }
          }
        },
        "formatting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configured": { "type": "boolean" },
            "tool": { "type": "string", "maxLength": 100 }
          }
        },
        "testing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "framework": { "type": "string", "maxLength": 100 },
            "test_files": { "type": "integer", "minimum": 0 },
            "coverage_configured": { "type": "boolean" },
            "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "type_safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "typescript": { "type": "boolean" },
            "strict_mode": { "type": "boolean" },
            "type_coverage": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "patterns_detected": {
      "type": "array",
      "description": "Common patterns and anti-patterns detected",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["pattern", "type", "locations"],
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Name of the pattern",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": ["good-practice", "anti-pattern", "neutral"]
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "locations": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "maxLength": 500 }
          },
          "recommendation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "tech_debt": {
      "type": "object",
      "description": "Technical debt indicators",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall tech debt score (0=no debt, 100=severe)"
        },
        "indicators": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["category", "severity", "description"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "outdated-deps",
                  "missing-tests",
                  "dead-code",
                  "complexity",
                  "documentation",
                  "security",
                  "performance",
                  "accessibility"
                ]
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "description": { "type": "string", "maxLength": 1000 },
              "remediation_effort": {
                "type": "string",
                "enum": ["trivial", "minor", "moderate", "major", "massive"]
              }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Prioritized improvement recommendations",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["priority", "category", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "performance",
              "maintainability",
              "testing",
              "documentation",
              "architecture",
              "dependencies"
            ]
          },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "effort": {
            "type": "string",
            "enum": ["trivial", "minor", "moderate", "major", "massive"]
          },
          "impact": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Analysis metadata",
      "additionalProperties": false,
      "properties": {
        "analyzer_version": { "type": "string", "maxLength": 50 },
        "analysis_duration_ms": { "type": "integer", "minimum": 0 },
        "files_analyzed": { "type": "integer", "minimum": 0 },
        "files_skipped": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
