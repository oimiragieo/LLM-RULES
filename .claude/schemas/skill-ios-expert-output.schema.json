{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iOS Expert Output",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "output": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "const": "Swift"
        },
        "framework": {
          "type": "string",
          "enum": [
            "SwiftUI",
            "UIKit",
            "Combined"
          ]
        },
        "iosVersion": {
          "type": "string",
          "description": "Minimum iOS version (e.g., '17.0')"
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "componentType": {
                "type": "string",
                "enum": [
                  "view",
                  "viewmodel",
                  "model",
                  "service",
                  "utility",
                  "other"
                ]
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectStructure": {
          "type": "object",
          "properties": {
            "folders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-ios-expert-output.schema.json"
}
