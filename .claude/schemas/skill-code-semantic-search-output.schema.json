{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-code-semantic-search-output.schema.json",
  "title": "Code Semantic Search Skill Output",
  "description": "Validates output from code-semantic-search skill - Semantic code search with relevance scores",
  "type": "object",
  "required": [
    "output",
    "status"
  ],
  "properties": {
    "output": {
      "type": "object",
      "description": "Semantic search results",
      "required": [
        "results",
        "relevanceScores",
        "query"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "snippet",
              "relevanceScore"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "lineStart": {
                "type": "number",
                "minimum": 1
              },
              "lineEnd": {
                "type": "number",
                "minimum": 1
              },
              "snippet": {
                "type": "string",
                "minLength": 10
              },
              "relevanceScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Semantic relevance score (0-1)"
              },
              "context": {
                "type": "string"
              },
              "matchType": {
                "type": "string",
                "enum": [
                  "semantic",
                  "hybrid",
                  "structural"
                ]
              }
            }
          },
          "description": "Search results sorted by relevance"
        },
        "relevanceScores": {
          "type": "object",
          "required": [
            "minimum",
            "maximum",
            "average"
          ],
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maximum": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "average": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "median": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "Relevance score distribution"
        },
        "query": {
          "type": "object",
          "required": [
            "text",
            "mode"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 3
            },
            "mode": {
              "type": "string",
              "enum": [
                "hybrid",
                "semantic-only",
                "structural-only"
              ]
            },
            "language": {
              "type": "string"
            },
            "filters": {
              "type": "object",
              "properties": {
                "fileTypes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "directories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "searchMetadata": {
          "type": "object",
          "properties": {
            "totalResults": {
              "type": "number",
              "minimum": 0
            },
            "filesScanned": {
              "type": "number",
              "minimum": 0
            },
            "searchDurationMs": {
              "type": "number",
              "minimum": 0
            },
            "embeddingModel": {
              "type": "string"
            },
            "indexUsed": {
              "type": "boolean"
            }
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "description",
              "occurrences"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "occurrences": {
                "type": "number",
                "minimum": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Common patterns found in results"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false
}
