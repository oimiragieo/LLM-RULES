{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-k8s-manifest-generator-output.schema.json",
  "title": "K8s Manifest Generator Skill Output",
  "description": "Output schema for Kubernetes manifest generation with best practices and security standards",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number"
            },
            "kubernetesVersion": {
              "type": "string"
            },
            "agent": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
