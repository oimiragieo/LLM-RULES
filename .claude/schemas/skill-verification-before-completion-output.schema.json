{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude-code.anthropic.com/schemas/skill-verification-before-completion-output.schema.json",
  "title": "Verification Before Completion Skill Output",
  "description": "Validates output from verification-before-completion skill - Evidence-based completion gates",
  "type": "object",
  "required": ["skillName", "version", "timestamp", "output"],
  "properties": {
    "skillName": {
      "type": "string",
      "const": "verification-before-completion",
      "description": "Must be 'verification-before-completion' to verify correct skill was used"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Skill version (semantic versioning)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of execution"
    },
    "output": {
      "type": "object",
      "description": "Verification results",
      "required": ["evidence", "gates", "verdict"],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim", "command", "output", "verified"],
            "properties": {
              "claim": {
                "type": "string",
                "description": "Claim being verified"
              },
              "command": {
                "type": "string",
                "description": "Command executed for verification"
              },
              "output": {
                "type": "string",
                "description": "Command output proving claim"
              },
              "verified": {
                "type": "boolean",
                "description": "Whether claim was verified"
              },
              "exitCode": {
                "type": "number",
                "description": "Command exit code"
              }
            }
          },
          "description": "Evidence gathered for verification"
        },
        "gates": {
          "type": "object",
          "required": ["testsPass", "lintClean", "formatClean"],
          "properties": {
            "testsPass": {
              "type": "object",
              "required": ["passed", "evidence"],
              "properties": {
                "passed": { "type": "boolean" },
                "evidence": { "type": "string" },
                "failureCount": { "type": "number", "minimum": 0 }
              }
            },
            "lintClean": {
              "type": "object",
              "required": ["passed", "evidence"],
              "properties": {
                "passed": { "type": "boolean" },
                "evidence": { "type": "string" },
                "errorCount": { "type": "number", "minimum": 0 }
              }
            },
            "formatClean": {
              "type": "object",
              "required": ["passed", "evidence"],
              "properties": {
                "passed": { "type": "boolean" },
                "evidence": { "type": "string" },
                "filesChanged": { "type": "number", "minimum": 0 }
              }
            },
            "buildSucceeds": {
              "type": "object",
              "properties": {
                "passed": { "type": "boolean" },
                "evidence": { "type": "string" },
                "exitCode": { "type": "number" }
              }
            },
            "regressionTestVerified": {
              "type": "object",
              "properties": {
                "redGreenCycleVerified": { "type": "boolean" },
                "evidence": { "type": "string" }
              }
            }
          }
        },
        "verdict": {
          "type": "object",
          "required": ["readyForCompletion", "reasoning"],
          "properties": {
            "readyForCompletion": {
              "type": "boolean",
              "description": "Whether work can be marked complete"
            },
            "reasoning": {
              "type": "string",
              "minLength": 10,
              "description": "Explanation of verdict"
            },
            "blockers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Reasons preventing completion"
            }
          }
        },
        "requirementsChecklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement", "verified"],
            "properties": {
              "requirement": { "type": "string" },
              "verified": { "type": "boolean" },
              "evidence": { "type": "string" }
            }
          },
          "description": "Requirements verification checklist"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
