{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Svelte Expert Output",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "svelte-expert"
    },
    "version": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "TypeScript",
            "JavaScript"
          ]
        },
        "framework": {
          "const": "Svelte"
        },
        "svelteVersion": {
          "type": "string",
          "description": "Svelte version (e.g., '5')"
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "componentType": {
                "type": "string",
                "enum": [
                  "component",
                  "page",
                  "layout",
                  "store",
                  "server-load"
                ]
              },
              "runes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Svelte 5 runes used"
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routing": {
          "type": "object",
          "properties": {
            "sveltekit": {
              "type": "boolean"
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-svelte-expert-output.schema.json"
}
