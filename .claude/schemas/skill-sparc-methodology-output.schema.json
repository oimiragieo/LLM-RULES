{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-sparc-methodology-output.schema.json",
  "title": "SPARC Methodology Output",
  "description": "Schema for SPARC development methodology tracking",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "currentPhase": {
          "type": "string",
          "enum": [
            "specification",
            "architecture",
            "refinement",
            "review",
            "completion"
          ],
          "description": "Current SPARC phase"
        },
        "phases": {
          "type": "object",
          "properties": {
            "specification": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "complete"
                  ]
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "successMetrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "architecture": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "complete"
                  ]
                },
                "components": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "interfaces": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "refinement": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "complete"
                  ]
                },
                "tddCycles": {
                  "type": "number",
                  "minimum": 0
                },
                "testsPassing": {
                  "type": "boolean"
                },
                "coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "review": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "complete"
                  ]
                },
                "codeReview": {
                  "type": "boolean"
                },
                "securityReview": {
                  "type": "boolean"
                },
                "performanceReview": {
                  "type": "boolean"
                }
              }
            },
            "completion": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "complete"
                  ]
                },
                "integrationTesting": {
                  "type": "boolean"
                },
                "documentationComplete": {
                  "type": "boolean"
                },
                "deploymentReady": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "qualityGates": {
          "type": "object",
          "properties": {
            "allTestsPassing": {
              "type": "boolean"
            },
            "coverageTarget": {
              "type": "boolean"
            },
            "securityClean": {
              "type": "boolean"
            },
            "performanceBaseline": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "currentPhase",
        "phases",
        "qualityGates"
      ]
    }
  },
  "additionalProperties": false
}
