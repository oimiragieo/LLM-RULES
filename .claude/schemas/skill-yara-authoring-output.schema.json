{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-yara-authoring-output",
  "title": "yara-authoring Skill Output",
  "description": "Output schema for: YARA-X detection rule authoring with expert judgment, linting, atom analysis, and best practices. Teaches how to think like an expert YARA author for malware detection, threat hunting, and indicator-of-compromise identification using YARA-X (the Rust-based successor to legacy YARA).",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status"
    },
    "output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of skill execution"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "INFO"
                ]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "message"
            ]
          }
        },
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary"
      ]
    }
  },
  "required": [
    "status",
    "output"
  ]
}
