{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-scientific-skills-output.json",
  "title": "Scientific Skills Output",
  "description": "Validation schema for scientific-skills skill output",
  "type": "object",
  "required": ["status", "output"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "workflow_type": {
          "type": "string",
          "enum": [
            "database_query",
            "bioinformatics_analysis",
            "cheminformatics_analysis",
            "data_analysis",
            "literature_review",
            "machine_learning",
            "visualization",
            "multi_step_workflow"
          ],
          "description": "Type of scientific workflow executed"
        },
        "category": {
          "type": "string",
          "enum": [
            "scientific-databases",
            "bioinformatics",
            "cheminformatics",
            "machine-learning",
            "data-analysis",
            "scientific-writing"
          ],
          "description": "Scientific domain category"
        },
        "skills_invoked": {
          "type": "array",
          "description": "Sub-skills that were used (from the 139 available)",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "databases_accessed": {
          "type": "array",
          "description": "Scientific databases queried",
          "items": {
            "type": "object",
            "required": ["database_name", "query_count"],
            "properties": {
              "database_name": {
                "type": "string",
                "description": "Name of the database (e.g., PubMed, ChEMBL, UniProt)"
              },
              "query_count": {
                "type": "integer",
                "minimum": 1,
                "description": "Number of queries executed"
              },
              "results_count": {
                "type": "integer",
                "minimum": 0,
                "description": "Total results retrieved"
              }
            },
            "additionalProperties": false
          }
        },
        "analysis_results": {
          "type": "object",
          "description": "Results from computational analysis",
          "properties": {
            "method": {
              "type": "string",
              "description": "Analysis method used (e.g., 'single-cell RNA-seq', 'molecular docking')"
            },
            "input_data": {
              "type": "object",
              "description": "Description of input data",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Data type (e.g., 'protein sequences', 'chemical structures')"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Number of input items"
                },
                "source": {
                  "type": "string",
                  "description": "Source of the data"
                }
              },
              "additionalProperties": false
            },
            "output_data": {
              "type": "object",
              "description": "Analysis outputs",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Output type"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of output items"
                },
                "file_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths to generated output files"
                }
              },
              "additionalProperties": false
            },
            "statistics": {
              "type": "object",
              "description": "Statistical summary of results",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "literature_results": {
          "type": "object",
          "description": "Results from literature review",
          "properties": {
            "articles_found": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of articles identified"
            },
            "articles_reviewed": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of articles analyzed"
            },
            "key_findings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key findings from the literature"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "authors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "year": {
                    "type": "integer"
                  },
                  "doi": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "visualizations_generated": {
          "type": "array",
          "description": "Visualization outputs",
          "items": {
            "type": "object",
            "required": ["type", "file_path"],
            "properties": {
              "type": {
                "type": "string",
                "description": "Visualization type (e.g., 'heatmap', 'UMAP', 'molecular structure')"
              },
              "file_path": {
                "type": "string",
                "description": "Path to the generated visualization"
              },
              "description": {
                "type": "string",
                "description": "What the visualization shows"
              }
            },
            "additionalProperties": false
          }
        },
        "code_generated": {
          "type": "object",
          "description": "Code generated for analysis",
          "properties": {
            "language": {
              "type": "string",
              "enum": ["python", "R", "julia"],
              "description": "Programming language"
            },
            "file_path": {
              "type": "string",
              "description": "Path to generated code file"
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required libraries/packages"
            }
          },
          "additionalProperties": false
        },
        "execution_time_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Total execution time in seconds"
        },
        "summary": {
          "type": "string",
          "description": "Executive summary of the scientific workflow results"
        }
      },
      "additionalProperties": false,
      "required": ["workflow_type", "category", "skills_invoked"]
    }
  },
  "additionalProperties": false
}
