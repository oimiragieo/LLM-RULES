{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Execution Snapshot",
  "description": "Captures execution state for workflow continuation after interruption",
  "type": "object",
  "properties": {
    "workflow_id": { "type": "string" },
    "current_step": { "type": "integer", "minimum": 0 },
    "total_steps": { "type": "integer", "minimum": 1 },
    "steps_completed": { "type": "array", "items": { "type": "string" } },
    "last_task_metadata": { "type": "object" },
    "key_findings": { "type": "array", "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date-time" },
    "resumable": { "type": "boolean", "default": true }
  },
  "required": ["workflow_id", "current_step", "total_steps", "steps_completed", "timestamp"]
}
