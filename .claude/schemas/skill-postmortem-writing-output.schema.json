{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-postmortem-writing-output.schema.json",
  "title": "Postmortem Writing Skill Output",
  "description": "Output schema for blameless postmortems with root cause analysis, timelines, and action items",
  "type": "object",
  "required": [
    "skillName",
    "timestamp",
    "result"
  ],
  "properties": {
    "skillName": {
      "type": "string",
      "const": "postmortem-writing"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object",
      "required": [
        "incident",
        "timeline",
        "rootCause"
      ],
      "properties": {
        "incident": {
          "type": "object",
          "required": [
            "title",
            "severity",
            "startTime",
            "endTime"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "P0",
                "P1",
                "P2",
                "P3",
                "P4"
              ]
            },
            "startTime": {
              "type": "string",
              "format": "date-time"
            },
            "endTime": {
              "type": "string",
              "format": "date-time"
            },
            "duration": {
              "type": "string"
            },
            "impact": {
              "type": "object",
              "properties": {
                "usersAffected": {
                  "type": "integer"
                },
                "servicesAffected": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "revenueImpact": {
                  "type": "number"
                }
              }
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "timestamp",
              "event"
            ],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "event": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              }
            }
          }
        },
        "rootCause": {
          "type": "object",
          "required": [
            "proximateCause",
            "rootCause"
          ],
          "properties": {
            "proximateCause": {
              "type": "string"
            },
            "rootCause": {
              "type": "string"
            },
            "contributingFactors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fiveWhys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "whatWentWell": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "whatWentPoorly": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actionItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "owner",
              "type",
              "priority",
              "dueDate"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "prevent",
                  "detect",
                  "correct"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  "P4"
                ]
              },
              "dueDate": {
                "type": "string",
                "format": "date"
              },
              "trackingTicket": {
                "type": "string"
              }
            }
          }
        },
        "lessonsLearned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "mttr": {
              "type": "number",
              "description": "Mean Time To Recover (minutes)"
            },
            "mttd": {
              "type": "number",
              "description": "Mean Time To Detect (minutes)"
            },
            "customersImpacted": {
              "type": "integer"
            },
            "incidentCost": {
              "type": "number"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
