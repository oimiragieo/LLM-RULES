{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-task-management-protocol-output.schema.json",
  "title": "Task Management Protocol Skill Output",
  "description": "Validates output from task-management-protocol skill invocation - task synchronization and context handoff",
  "type": "object",
  "required": ["output", "status"],
  "properties": {
    "output": {
      "type": "object",
      "description": "Task management protocol execution results",
      "required": ["taskId", "operation", "metadata"],
      "properties": {
        "taskId": {
          "type": "string",
          "description": "Task ID that was operated on"
        },
        "operation": {
          "type": "string",
          "enum": [
            "session_start",
            "progress_update",
            "discovery",
            "blocker",
            "subtask_creation",
            "completion",
            "handoff"
          ],
          "description": "Type of task operation performed"
        },
        "metadata": {
          "type": "object",
          "description": "Task handoff metadata structure",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["not_started", "in_progress", "blocked", "completed"],
              "description": "Current task status"
            },
            "progress": {
              "type": "string",
              "description": "Progress indicator (e.g., '60%', '3/5 steps')"
            },
            "discoveredFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files discovered during work"
            },
            "discoveries": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key discoveries made during execution"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Patterns identified during work"
            },
            "blocker": {
              "type": "string",
              "description": "Description of blocking issue"
            },
            "blockerType": {
              "type": "string",
              "enum": ["dependency", "permission", "information", "external"],
              "description": "Type of blocker encountered"
            },
            "needsFrom": {
              "type": "string",
              "description": "Who can resolve the blocker"
            },
            "summary": {
              "type": "string",
              "description": "Concise summary of completed work"
            },
            "filesModified": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files modified during work"
            },
            "filesCreated": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files created during work"
            },
            "outputArtifacts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Output artifacts produced"
            },
            "currentState": {
              "type": "string",
              "description": "Detailed current state for handoff"
            },
            "immediateNextStep": {
              "type": "string",
              "description": "The very next action to take"
            },
            "keyFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key files for continuation"
            },
            "keyDecisions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key decisions made during work"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time",
              "description": "Last update timestamp"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Completion timestamp"
            },
            "pausedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Session pause timestamp"
            }
          },
          "additionalProperties": true
        },
        "descriptionUpdated": {
          "type": "boolean",
          "description": "Whether task description was updated"
        },
        "unlockedTasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task IDs that were unlocked by completion"
        },
        "subtasksCreated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Subtask IDs created during execution"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false
}
