{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-dry-principle-output.schema.json",
  "title": "DRY Principle Skill Output",
  "description": "Validates output from dry-principle skill - Don't Repeat Yourself analysis",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "timestamp",
    "output"
  ],
  "properties": {
    "skillName": {
      "type": "string",
      "const": "dry-principle",
      "description": "Must be 'dry-principle' to verify correct skill was used"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Skill version (semantic versioning)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of execution"
    },
    "output": {
      "type": "object",
      "description": "DRY analysis results",
      "required": [
        "duplicates",
        "refactoringSuggestions"
      ],
      "properties": {
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "occurrences",
              "locations"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "code_block",
                  "function",
                  "logic",
                  "constants",
                  "configuration"
                ]
              },
              "occurrences": {
                "type": "number",
                "minimum": 2,
                "description": "Number of times pattern is duplicated"
              },
              "locations": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "lineStart"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "lineStart": {
                      "type": "number",
                      "minimum": 1
                    },
                    "lineEnd": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                },
                "description": "Locations where duplication occurs"
              },
              "similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage similarity between duplicates"
              },
              "snippet": {
                "type": "string",
                "description": "Example of duplicated code"
              }
            }
          },
          "description": "Duplicated code patterns found"
        },
        "refactoringSuggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "priority",
              "strategy",
              "description"
            ],
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "extract_function",
                  "extract_constant",
                  "extract_class",
                  "parameterize",
                  "use_inheritance",
                  "use_composition"
                ]
              },
              "description": {
                "type": "string"
              },
              "affectedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimatedReduction": {
                "type": "number",
                "minimum": 0,
                "description": "Estimated lines of code reduction"
              },
              "rationale": {
                "type": "string"
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          },
          "description": "Refactoring suggestions to eliminate duplication"
        },
        "summary": {
          "type": "object",
          "properties": {
            "totalDuplicates": {
              "type": "number",
              "minimum": 0
            },
            "duplicatedLines": {
              "type": "number",
              "minimum": 0
            },
            "percentageDuplicated": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "filesAffected": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "dryScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall DRY compliance score (100 = no duplication)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
