{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "llm-judge-evaluation",
  "title": "LLM-as-Judge Evaluation",
  "description": "Structured evaluation format for LLM-as-judge scoring with evidence citations",
  "type": "object",
  "properties": {
    "evaluation_id": { "type": "string" },
    "evaluator": { "type": "string", "description": "Agent that performed the evaluation" },
    "target": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "agent_type": { "type": "string" },
        "output_summary": { "type": "string" }
      },
      "required": ["task_id"]
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["accuracy", "groundedness", "coherence", "completeness", "helpfulness"]
          },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["supports", "contradicts", "neutral"] },
                "source": { "type": "string", "description": "File path or reference" },
                "excerpt": { "type": "string", "maxLength": 200 },
                "relevance": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["type", "source"]
            }
          },
          "reasoning": { "type": "string", "description": "Explanation for the score" }
        },
        "required": ["name", "score", "weight"]
      },
      "minItems": 1
    },
    "composite_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Weighted average of dimension scores"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "marginal"],
      "description": "Overall verdict based on composite score threshold"
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7
    },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["evaluation_id", "target", "dimensions", "composite_score", "verdict"]
}
