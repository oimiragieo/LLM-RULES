{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact Manifest Schema",
  "description": "Schema for artifact manifest documents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {
      "type": "string",
      "maxLength": 50,
      "description": "Version of the manifest format"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["name", "version"]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "description": "Unique identifier for the artifact"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Human-readable name"
          },
          "type": {
            "type": "string",
            "enum": ["document", "code", "design", "test", "deployment", "data", "configuration"],
            "description": "Type of artifact"
          },
          "path": {
            "type": "string",
            "maxLength": 500,
            "description": "Relative path to the artifact"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Description of the artifact"
          },
          "version": {
            "type": "string",
            "maxLength": 50,
            "description": "Version of the artifact"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "modified": {
            "type": "string",
            "format": "date-time",
            "description": "Last modification timestamp"
          },
          "author": {
            "type": "string",
            "maxLength": 100,
            "description": "Author/creator of the artifact"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "review", "approved", "published", "archived"],
            "description": "Current status of the artifact"
          },
          "tags": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Tags for categorization"
          },
          "dependencies": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "description": "IDs of artifacts this one depends on"
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata specific to the artifact type"
          },
          "checksum": {
            "type": "string",
            "maxLength": 100,
            "description": "Checksum for integrity verification"
          },
          "size": {
            "type": "number",
            "description": "Size in bytes"
          }
        },
        "required": ["id", "name", "type", "path"]
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 100,
            "description": "Source artifact ID"
          },
          "to": {
            "type": "string",
            "maxLength": 100,
            "description": "Target artifact ID"
          },
          "type": {
            "type": "string",
            "enum": ["depends-on", "references", "implements", "tests", "deploys", "contains"],
            "description": "Type of relationship"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Description of the relationship"
          }
        },
        "required": ["from", "to", "type"]
      },
      "description": "Relationships between artifacts"
    },
    "workflows": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "steps": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                },
                "artifacts": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "description": "Artifact IDs involved in this step"
                },
                "inputs": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "outputs": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              },
              "required": ["id", "name"]
            }
          }
        },
        "required": ["id", "name", "steps"]
      },
      "description": "Workflows that produce or consume artifacts"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string",
          "maxLength": 100,
          "description": "Tool that generated this manifest"
        },
        "environment": {
          "type": "string",
          "maxLength": 100,
          "description": "Environment where manifest was generated"
        }
      }
    }
  },
  "required": ["manifestVersion", "project", "artifacts"]
}
