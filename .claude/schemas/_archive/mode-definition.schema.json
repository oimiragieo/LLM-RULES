{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.ai/schemas/mode-definition.schema.json",
  "title": "ModeDefinition",
  "type": "object",
  "required": ["name", "prompt"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "prompt": { "type": "string" },
    "excluded_tools": { "type": "array", "items": { "type": "string" } },
    "included_optional_tools": { "type": "array", "items": { "type": "string" } }
  }
}
