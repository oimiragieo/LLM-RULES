{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.ai/schemas/context-definition.schema.json",
  "title": "ContextDefinition",
  "type": "object",
  "required": ["name", "prompt"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "prompt": { "type": "string" },
    "excluded_tools": { "type": "array", "items": { "type": "string" } },
    "included_optional_tools": { "type": "array", "items": { "type": "string" } },
    "tool_description_overrides": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "single_project": { "type": "boolean" }
  }
}
