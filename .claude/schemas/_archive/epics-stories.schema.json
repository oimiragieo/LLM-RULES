{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epics and Stories Schema",
  "description": "Schema for epics and their associated stories",
  "type": "object",
  "properties": {
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "stories": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "title"]
      }
    }
  },
  "required": ["epics"]
}
