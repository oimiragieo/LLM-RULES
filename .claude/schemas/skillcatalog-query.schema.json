{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://claude-code.anthropic.com/schemas/skillcatalog-query",
  "title": "SkillCatalog Query",
  "description": "Schema for validating skill catalog query parameters",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "Filter by skill domain (e.g., 'testing', 'security', 'devops')",
      "examples": [
        "testing",
        "security",
        "devops",
        "documentation",
        "planning",
        "architecture"
      ]
    },
    "category": {
      "type": "string",
      "description": "Filter by skill category (e.g., 'core-development', 'planning-architecture')",
      "examples": [
        "core-development",
        "planning-architecture",
        "security",
        "devops-infrastructure",
        "languages",
        "frameworks",
        "mobile",
        "data-database",
        "documentation",
        "git-version-control",
        "code-style-linting",
        "creator-tools",
        "memory-context",
        "validation-quality",
        "specialized-patterns"
      ]
    },
    "agentType": {
      "type": "string",
      "enum": [
        "developer",
        "qa",
        "architect",
        "planner",
        "researcher",
        "technical-writer",
        "code-reviewer",
        "security-architect",
        "devops",
        "frontend-pro",
        "backend-pro",
        "python-pro",
        "typescript-pro",
        "nodejs-pro",
        "react-pro",
        "nextjs-pro",
        "data-engineer",
        "database-architect"
      ],
      "description": "Filter by agent type to get recommended skills for that agent"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Filter by tags (AND logic - skill must have ALL specified tags)",
      "examples": [
        ["async", "performance"],
        ["react", "typescript"],
        ["testing", "tdd"]
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10,
      "description": "Maximum number of results to return (1-50)"
    },
    "includeRecommended": {
      "type": "boolean",
      "default": true,
      "description": "If true, sort recommended skills for agentType first"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "domain": "testing",
      "limit": 5
    },
    {
      "category": "security",
      "agentType": "security-architect"
    },
    {
      "tags": ["async", "performance"],
      "limit": 10
    },
    {
      "domain": "devops",
      "category": "devops-infrastructure",
      "agentType": "devops",
      "limit": 20
    }
  ]
}
