{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.local/schemas/error-log-entry.json",
  "title": "Agent Studio Error Log Entry",
  "description": "Schema for error log entries in the error logging system",
  "type": "object",
  "required": [
    "errorId",
    "timestamp",
    "category",
    "severity",
    "source",
    "message"
  ],
  "properties": {
    "errorId": {
      "type": "string",
      "pattern": "^ERR-[A-Z0-9]{8}$",
      "description": "Unique error identifier (ERR-XXXXXXXX format)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of error occurrence"
    },
    "category": {
      "type": "string",
      "enum": [
        "EXECUTION_ERROR",
        "HOOK_FAILURE",
        "TOOL_FAILURE",
        "VALIDATION_ERROR",
        "MEMORY_ERROR",
        "SECURITY_VIOLATION",
        "TIMEOUT_ERROR",
        "RESOURCE_ERROR"
      ],
      "description": "Error classification category"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "description": "Error severity level"
    },
    "source": {
      "type": "object",
      "required": ["component", "location"],
      "properties": {
        "component": {
          "type": "string",
          "description": "Component that generated the error (hook, tool, agent)"
        },
        "location": {
          "type": "string",
          "description": "File path or module name"
        },
        "function": {
          "type": "string",
          "description": "Function name if available"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number if available"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "description": "Contextual information for debugging",
      "properties": {
        "agentName": {
          "type": "string",
          "description": "Name of the agent that encountered the error"
        },
        "taskId": {
          "type": "string",
          "description": "Associated task ID if available"
        },
        "toolName": {
          "type": "string",
          "description": "Tool being invoked when error occurred"
        },
        "phase": {
          "type": "string",
          "enum": ["pre_tool_use", "tool_execution", "post_tool_use", "task_execution"],
          "description": "Execution phase when error occurred"
        },
        "recoveryAttempt": {
          "type": "boolean",
          "description": "Whether recovery was attempted"
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "description": "Correlation identifiers for tracing",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Claude Code session identifier"
        },
        "traceId": {
          "type": "string",
          "description": "OpenTelemetry trace ID if available"
        },
        "spanId": {
          "type": "string",
          "description": "OpenTelemetry span ID if available"
        },
        "parentErrorId": {
          "type": "string",
          "pattern": "^ERR-[A-Z0-9]{8}$",
          "description": "ID of parent error (for error cascades)"
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "string",
      "description": "Human-readable error message (sanitized)"
    },
    "stack": {
      "type": "array",
      "description": "Stack trace frames (max 3, sanitized)",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "object",
      "description": "Impact assessment",
      "properties": {
        "taskBlocked": {
          "type": "boolean",
          "description": "Whether the error blocked task completion"
        },
        "userVisible": {
          "type": "boolean",
          "description": "Whether the error was visible to the user"
        },
        "dataLoss": {
          "type": "boolean",
          "description": "Whether data loss occurred"
        },
        "recoverable": {
          "type": "boolean",
          "description": "Whether the error is recoverable"
        }
      },
      "additionalProperties": false
    },
    "maskedInput": {
      "type": "object",
      "description": "Masked tool input parameters (no sensitive data)",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
