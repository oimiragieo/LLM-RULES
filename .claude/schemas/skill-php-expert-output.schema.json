{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PHP Expert Output",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "php-expert"
    },
    "version": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "const": "PHP"
        },
        "framework": {
          "type": "string",
          "enum": [
            "Laravel",
            "Symfony",
            "WordPress",
            "Drupal",
            "Other"
          ]
        },
        "phpVersion": {
          "type": "string",
          "description": "PHP version (e.g., '8.3')"
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "classType": {
                "type": "string",
                "enum": [
                  "controller",
                  "model",
                  "service",
                  "middleware",
                  "migration",
                  "other"
                ]
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "composer": {
          "type": "object",
          "properties": {
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-php-expert-output.schema.json"
}
