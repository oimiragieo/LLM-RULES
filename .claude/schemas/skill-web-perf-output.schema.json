{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-web-perf-output",
  "title": "web-perf Skill Output",
  "description": "Output schema for: Structured 5-phase web performance audit workflow with Core Web Vitals thresholds and actionable optimization recommendations. Use when auditing website performance, diagnosing slow page loads, optimizing Core Web Vitals scores, or reviewing frontend performance patterns. Covers Webpack, Vite, Next.js, and Nuxt optimization.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status"
    },
    "output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of skill execution"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": ["severity", "message"]
          }
        },
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["summary"]
    }
  },
  "required": ["status", "output"]
}
