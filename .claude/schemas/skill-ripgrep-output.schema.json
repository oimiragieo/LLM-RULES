{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-ripgrep-output.schema.json",
  "title": "Ripgrep Skill Output",
  "description": "Validates output from ripgrep skill - Fast code search results",
  "type": "object",
  "required": [
    "output",
    "status"
  ],
  "properties": {
    "output": {
      "type": "object",
      "description": "Ripgrep search results",
      "required": [
        "matches",
        "files",
        "patterns"
      ],
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "line",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "number",
                "minimum": 1
              },
              "column": {
                "type": "number",
                "minimum": 1
              },
              "content": {
                "type": "string"
              },
              "context": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "after": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "description": "Search matches found"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files containing matches"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "matchCount"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "matchCount": {
                "type": "number",
                "minimum": 0
              },
              "fileCount": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "Patterns searched and their match counts"
        },
        "searchMetadata": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "fileTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "directoryFilters": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludePatterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "caseSensitive": {
              "type": "boolean"
            },
            "regexMode": {
              "type": "boolean"
            },
            "pcre2Mode": {
              "type": "boolean"
            }
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "totalMatches",
            "filesMatched"
          ],
          "properties": {
            "totalMatches": {
              "type": "number",
              "minimum": 0
            },
            "filesMatched": {
              "type": "number",
              "minimum": 0
            },
            "filesScanned": {
              "type": "number",
              "minimum": 0
            },
            "searchDurationMs": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false
}
