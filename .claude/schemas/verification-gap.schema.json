{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification Gap Schema",
  "description": "Structured format for QA gap reporting",
  "type": "object",
  "properties": {
    "gap_id": { "type": "string", "pattern": "^G[0-9]+$" },
    "category": {
      "type": "string",
      "enum": [
        "missing_test",
        "missing_artifact",
        "broken_link",
        "lint_error",
        "truth_violation",
        "missing_doc"
      ]
    },
    "description": { "type": "string" },
    "severity": { "type": "string", "enum": ["blocker", "warning", "info"] },
    "suggested_fix": { "type": "string" }
  },
  "required": ["gap_id", "category", "description", "severity"]
}
