{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-code.anthropic.com/schemas/workflow-definition",
  "title": "Workflow Definition Schema",
  "description": "Schema for validating Claude Code workflow definition files",
  "type": "object",
  "required": [
    "name",
    "steps"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Workflow name in lowercase-with-hyphens format",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Description of what the workflow does"
    },
    "category": {
      "type": "string",
      "enum": [
        "rapid",
        "enterprise",
        "operations"
      ],
      "description": "Workflow category"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Simple step name",
            "maxLength": 100
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "unevaluatedProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Step identifier",
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "description": "Step description",
                "maxLength": 500
              },
              "agent": {
                "type": "string",
                "description": "Agent to execute this step",
                "maxLength": 100
              },
              "skills": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 100
                },
                "description": "Skills to load for this step"
              },
              "inputs": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "description": "Required inputs for this step"
              },
              "outputs": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "description": "Outputs produced by this step"
              },
              "validation": {
                "type": "object",
                "unevaluatedProperties": false,
                "properties": {
                  "schema": {
                    "type": "string",
                    "description": "Schema to validate step output",
                    "maxLength": 200
                  },
                  "required": {
                    "type": "boolean",
                    "description": "Whether validation is required to proceed"
                  }
                },
                "description": "Validation configuration for step outputs"
              },
              "condition": {
                "type": "string",
                "description": "Condition for executing this step",
                "maxLength": 500
              },
              "parallel": {
                "type": "boolean",
                "description": "Whether this step can run in parallel with previous"
              }
            }
          }
        ]
      },
      "description": "Workflow steps"
    },
    "hooks": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "entry": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "description": "Hooks to run when workflow starts"
        },
        "exit": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "description": "Hooks to run when workflow completes"
        },
        "error": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "description": "Hooks to run on workflow error"
        }
      },
      "description": "Workflow lifecycle hooks"
    },
    "agents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "description": "Agents that can execute this workflow"
    },
    "timeout": {
      "type": "integer",
      "minimum": 0,
      "description": "Workflow timeout in seconds"
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Number of retries on failure"
    }
  },
  "examples": [
    {
      "name": "fix",
      "steps": [
        "reproduce",
        "fix",
        "verify"
      ]
    },
    {
      "name": "code-review",
      "description": "Comprehensive code review workflow",
      "category": "enterprise",
      "steps": [
        {
          "id": "analyze",
          "description": "Analyze the code changes",
          "agent": "developer",
          "skills": [
            "code-analyzer"
          ]
        },
        {
          "id": "review",
          "description": "Review for quality and security",
          "agent": "architect",
          "skills": [
            "code-analyzer"
          ]
        },
        {
          "id": "approve",
          "description": "Final approval",
          "agent": "architect"
        }
      ],
      "hooks": {
        "entry": [
          "review-start-logger"
        ],
        "exit": [
          "review-complete-notifier"
        ]
      }
    }
  ],
  "additionalProperties": false
}
