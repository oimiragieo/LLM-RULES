{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-container-expert-output.schema.json",
  "title": "Container Expert Skill Output",
  "description": "Output schema for container expert skill including Docker, Kubernetes, Helm, and service mesh configurations",
  "type": "object",
  "required": ["status", "output"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number"
            },
            "filesAnalyzed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "agent": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
