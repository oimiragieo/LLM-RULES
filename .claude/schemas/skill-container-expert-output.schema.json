{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-container-expert-output.schema.json",
  "title": "Container Expert Skill Output",
  "description": "Output schema for container expert skill including Docker, Kubernetes, Helm, and service mesh configurations",
  "type": "object",
  "required": [
    "skillName",
    "timestamp",
    "result"
  ],
  "properties": {
    "skillName": {
      "type": "string",
      "const": "container-expert"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dockerfile",
            "compose",
            "k8s-manifest",
            "helm-chart",
            "istio-config",
            "knative-service"
          ]
        },
        "dockerConfig": {
          "type": "object",
          "properties": {
            "baseImage": {
              "type": "string"
            },
            "multiStage": {
              "type": "boolean"
            },
            "nonRootUser": {
              "type": "boolean"
            },
            "healthCheck": {
              "type": "boolean"
            },
            "optimizations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "k8sConfig": {
          "type": "object",
          "properties": {
            "resourceLimits": {
              "type": "boolean"
            },
            "probes": {
              "type": "object",
              "properties": {
                "liveness": {
                  "type": "boolean"
                },
                "readiness": {
                  "type": "boolean"
                }
              }
            },
            "securityContext": {
              "type": "object"
            }
          }
        },
        "istioConfig": {
          "type": "object",
          "properties": {
            "trafficManagement": {
              "type": "boolean"
            },
            "mutualTLS": {
              "type": "boolean"
            },
            "circuitBreaker": {
              "type": "boolean"
            }
          }
        },
        "knativeConfig": {
          "type": "object",
          "properties": {
            "autoScaling": {
              "type": "boolean"
            },
            "scaleToZero": {
              "type": "boolean"
            },
            "minScale": {
              "type": "integer"
            },
            "maxScale": {
              "type": "integer"
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "recommendation"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "recommendation": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "securityFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue",
              "severity"
            ],
            "properties": {
              "issue": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "remediation": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number"
        },
        "filesAnalyzed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
