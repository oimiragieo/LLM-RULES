{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/rule-definition.schema.json",
  "title": "Rule Definition Schema",
  "description": "Schema for validating Claude Code rule file metadata (.claude/rules/*.md). Rules are always-loaded behavioral guidelines injected into every agent context.",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Rule name matching the filename (without .md extension)",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "What behavior this rule governs or enforces"
    },
    "category": {
      "type": "string",
      "enum": [
        "code-quality",
        "security",
        "testing",
        "workflow",
        "architecture",
        "memory",
        "hooks",
        "git",
        "performance",
        "documentation",
        "agents",
        "workspace",
        "safety"
      ],
      "description": "Rule category for organization"
    },
    "scope": {
      "type": "string",
      "enum": ["all-agents", "core-agents", "specialized-agents", "orchestrators", "router"],
      "default": "all-agents",
      "description": "Which agent types this rule applies to"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50,
      "description": "Loading priority (lower = loaded earlier)"
    },
    "enforcement": {
      "type": "string",
      "enum": ["mandatory", "advisory", "informational"],
      "default": "advisory",
      "description": "How strictly this rule must be followed"
    },
    "related_hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "description": "Hook files that enforce this rule programmatically"
    }
  }
}
