{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prd-generator Output Schema",
  "description": "Output structure for prd-generator skill execution",
  "type": "object",
  "required": [
    "prdFile",
    "featureName",
    "hypothesisStatement",
    "phases",
    "validationResult"
  ],
  "properties": {
    "prdFile": {
      "type": "string",
      "description": "Path to generated PRD file",
      "pattern": "^\\.claude/context/artifacts/specs/[a-z0-9-]+-prd-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$"
    },
    "featureName": {
      "type": "string",
      "description": "Feature name derived from problem statement"
    },
    "hypothesisStatement": {
      "type": "string",
      "description": "Key hypothesis with measurable outcome"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "description",
          "status",
          "depends"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked"
            ]
          },
          "parallel": {
            "type": "boolean"
          },
          "depends": {
            "type": "string",
            "description": "Comma-separated phase numbers"
          },
          "planLink": {
            "type": "string",
            "description": "Link to implementation plan"
          }
        }
      }
    },
    "validationResult": {
      "type": "object",
      "required": [
        "isValid",
        "missingSections"
      ],
      "properties": {
        "isValid": {
          "type": "boolean"
        },
        "missingSections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moscowBreakdown": {
      "type": "object",
      "properties": {
        "must": {
          "type": "integer",
          "minimum": 1
        },
        "should": {
          "type": "integer"
        },
        "could": {
          "type": "integer"
        },
        "wont": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-prd-generator-output.schema.json"
}
