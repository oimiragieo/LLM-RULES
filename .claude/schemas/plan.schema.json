{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan Schema",
  "description": "Schema for project planning documents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Plan title"
    },
    "version": {
      "type": "string",
      "maxLength": 50,
      "description": "Plan version"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Plan creation date"
    },
    "author": {
      "type": "string",
      "maxLength": 200,
      "description": "Plan author"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 50,
      "description": "Plan objectives"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inScope": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": ["name", "date"]
          },
          "maxItems": 50
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in-progress", "completed", "blocked"]
          },
          "assignee": {
            "type": "string",
            "maxLength": 200
          },
          "estimatedHours": {
            "type": "number"
          }
        },
        "required": ["id", "title"]
      },
      "maxItems": 500
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "probability": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "impact": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "mitigation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "maxItems": 50
    }
  },
  "required": ["title", "objectives"]
}
