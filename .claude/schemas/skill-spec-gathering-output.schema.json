{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec Gathering Output",
  "description": "Validates output from spec-gathering skill",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "spec-gathering"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "output": {
      "type": "object",
      "required": [
        "featureOverview",
        "userStories",
        "functionalRequirements",
        "nonFunctionalRequirements",
        "acceptanceCriteria",
        "edgeCases",
        "assumptions",
        "outOfScope"
      ],
      "properties": {
        "featureOverview": {
          "type": "string",
          "minLength": 50,
          "maxLength": 500,
          "description": "2-3 sentence overview of what the feature does"
        },
        "userStories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "goal",
              "benefit",
              "acceptanceCriteria"
            ],
            "properties": {
              "role": {
                "type": "string",
                "description": "User role or persona"
              },
              "goal": {
                "type": "string",
                "description": "What the user wants to do"
              },
              "benefit": {
                "type": "string",
                "description": "Why the user wants this"
              },
              "acceptanceCriteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "given",
                    "when",
                    "then"
                  ],
                  "properties": {
                    "given": {
                      "type": "string",
                      "description": "Context/precondition"
                    },
                    "when": {
                      "type": "string",
                      "description": "Action performed"
                    },
                    "then": {
                      "type": "string",
                      "description": "Expected outcome"
                    }
                  }
                }
              }
            }
          }
        },
        "functionalRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^FR-\\d+$",
                "description": "Functional requirement ID"
              },
              "description": {
                "type": "string",
                "minLength": 20,
                "description": "What the system must do"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "must",
                  "should",
                  "may"
                ]
              }
            }
          }
        },
        "nonFunctionalRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "requirement",
              "measurement",
              "priority"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "performance",
                  "security",
                  "scalability",
                  "availability",
                  "usability"
                ]
              },
              "requirement": {
                "type": "string",
                "description": "The NFR"
              },
              "measurement": {
                "type": "string",
                "description": "How to measure compliance"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "must",
                  "should",
                  "may"
                ]
              }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "Testable condition for feature completion"
          }
        },
        "edgeCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scenario",
              "expectedBehavior"
            ],
            "properties": {
              "scenario": {
                "type": "string",
                "description": "Edge case scenario"
              },
              "expectedBehavior": {
                "type": "string",
                "description": "How system should handle this"
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "description": "Explicit assumption about scope or constraints"
          }
        },
        "outOfScope": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "description": "What this feature does NOT include"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "description"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "external-service",
                  "internal-service",
                  "library",
                  "infrastructure"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
