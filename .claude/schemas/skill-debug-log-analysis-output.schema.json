{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-debug-log-analysis-output",
  "title": "debug-log-analysis Skill Output",
  "description": "Output schema for: Structured debug log analysis for Claude Code sessions — copy log, run reducer, extract error patterns, correlate with full log, produce observability report. Fills 5 identified gaps: hook error body capture, agent identity, file path tracking, stall correlation, success visibility.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status"
    },
    "output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of skill execution"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": ["severity", "message"]
          }
        },
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["summary"]
    }
  },
  "required": ["status", "output"]
}
