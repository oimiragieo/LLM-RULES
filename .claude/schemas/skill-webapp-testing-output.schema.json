{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-webapp-testing-output",
  "title": "webapp-testing Skill Output",
  "description": "Output schema for: Test local web applications using Playwright with Python. Verify frontend functionality, debug UI behavior, capture screenshots, and view browser console logs. Supports static HTML files, dynamic webapps with running servers, and automated test generation.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status"
    },
    "output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of skill execution"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "INFO"
                ]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "message"
            ]
          }
        },
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary"
      ]
    }
  },
  "required": [
    "status",
    "output"
  ]
}
