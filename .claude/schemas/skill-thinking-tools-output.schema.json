{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thinking Tools Output",
  "description": "Output schema for thinking-tools skill",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "output": {
          "type": "object",
          "required": [
            "checkpoint",
            "timestamp",
            "result"
          ],
          "properties": {
            "checkpoint": {
              "type": "string",
              "enum": [
                "collected-information",
                "task-adherence",
                "completion"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "result": {
              "type": "object",
              "required": [
                "passed",
                "findings"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "question",
                      "answer",
                      "concern"
                    ],
                    "properties": {
                      "question": {
                        "type": "string"
                      },
                      "answer": {
                        "type": "string"
                      },
                      "concern": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "action": {
                  "type": "string",
                  "description": "What to do based on checkpoint result"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "output"
      ]
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-thinking-tools-output.schema.json"
}
