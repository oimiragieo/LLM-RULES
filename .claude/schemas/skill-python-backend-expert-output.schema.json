{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Python Backend Expert Output",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "python-backend-expert"
    },
    "version": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "const": "Python"
        },
        "framework": {
          "type": "string",
          "enum": [
            "Django",
            "FastAPI",
            "Flask",
            "Other"
          ]
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string",
                "description": "Generated Python code"
              },
              "typeHints": {
                "type": "boolean",
                "description": "Whether type hints are used"
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test files created"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-python-backend-expert-output.schema.json"
}
