{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "System Architecture Schema",
  "description": "Schema for system architecture documents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentTitle": {
      "type": "string",
      "maxLength": 200,
      "description": "Full document title"
    },
    "version": {
      "type": "string",
      "maxLength": 50,
      "description": "Document version"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation date"
    },
    "author": {
      "type": "string",
      "maxLength": 100,
      "description": "Document author"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved"],
      "description": "Document status"
    },
    "introduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "maxLength": 2000
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        },
        "references": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "systemOverview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "businessContext": {
          "type": "string",
          "maxLength": 2000
        },
        "goals": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "stakeholders": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "architecturePrinciples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designPrinciples": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "technologyPrinciples": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "operationalPrinciples": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "systemArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "highLevelArchitecture": {
          "type": "string",
          "maxLength": 5000
        },
        "components": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "responsibilities": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "interfaces": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "required": ["name"]
          }
        },
        "interfaces": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "flows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "componentArchitecture": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "purpose": {
            "type": "string",
            "maxLength": 500
          },
          "responsibilities": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "interfaces": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "required": ["name"]
      }
    },
    "dataArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataModel": {
          "type": "string",
          "maxLength": 5000
        },
        "dataStorage": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "dataFlow": {
          "type": "string",
          "maxLength": 5000
        },
        "dataSecurity": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "securityArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principles": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "authentication": {
          "type": "string",
          "maxLength": 2000
        },
        "authorization": {
          "type": "string",
          "maxLength": 2000
        },
        "dataProtection": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "deploymentArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "infrastructure": {
          "type": "string",
          "maxLength": 2000
        },
        "strategy": {
          "type": "string",
          "maxLength": 2000
        },
        "configurationManagement": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "scalability": {
          "type": "string",
          "maxLength": 2000
        },
        "monitoring": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logging": {
          "type": "string",
          "maxLength": 2000
        },
        "monitoring": {
          "type": "string",
          "maxLength": 2000
        },
        "alerting": {
          "type": "string",
          "maxLength": 2000
        },
        "troubleshooting": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  },
  "required": ["documentTitle", "introduction", "systemOverview"]
}
