{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-advanced-elicitation-output.schema.json",
  "title": "Advanced Elicitation Output",
  "description": "Schema for advanced elicitation skill output using meta-cognitive reasoning methods",
  "type": "object",
  "required": [
    "methodsApplied",
    "analysis",
    "improvements",
    "confidenceLevel"
  ],
  "properties": {
    "methodsApplied": {
      "type": "array",
      "description": "List of elicitation methods applied",
      "items": {
        "type": "string",
        "enum": [
          "first-principles",
          "pre-mortem",
          "socratic",
          "red-team-blue-team",
          "inversion",
          "second-order",
          "swot",
          "opportunity-cost",
          "analogical",
          "constraint-relaxation",
          "fmea",
          "bias-check",
          "base-rate",
          "steelmanning",
          "time-horizon-shift"
        ]
      },
      "minItems": 1,
      "maxItems": 5
    },
    "analysis": {
      "type": "object",
      "description": "Analysis results by method",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "findings",
            "verdict"
          ],
          "properties": {
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key findings from this method"
            },
            "verdict": {
              "type": "string",
              "description": "Outcome of applying this method"
            },
            "evidence": {
              "type": "string",
              "description": "Supporting evidence for findings"
            }
          }
        }
      }
    },
    "improvements": {
      "type": "array",
      "description": "Concrete improvements identified",
      "items": {
        "type": "object",
        "required": [
          "change",
          "rationale",
          "impact"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "sourceMethod": {
            "type": "string"
          }
        }
      }
    },
    "confidenceLevel": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "Overall confidence after elicitation"
    },
    "originalContent": {
      "type": "string",
      "description": "Original content before elicitation"
    },
    "revisedContent": {
      "type": "string",
      "description": "Improved content after elicitation"
    },
    "costEstimate": {
      "type": "object",
      "properties": {
        "tokensUsed": {
          "type": "number"
        },
        "estimatedCostUSD": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false
}
