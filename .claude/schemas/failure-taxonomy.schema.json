{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude-code.anthropic.com/schemas/failure-taxonomy",
  "title": "Failure Taxonomy",
  "description": "10-category failure taxonomy for classifying agent failures. Used by reflection-agent rubric, session-gap-log, and guardrail system.",
  "type": "object",
  "required": ["category", "severity"],
  "properties": {
    "category": {
      "type": "string",
      "description": "Failure category classification",
      "enum": [
        "tool-misuse",
        "scope-drift",
        "hallucination",
        "incomplete-output",
        "wrong-agent",
        "timeout",
        "context-overflow",
        "dependency-failure",
        "test-failure",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "description": "Failure severity level",
      "enum": ["low", "medium", "high", "critical"]
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Human-readable description of the failure"
    },
    "taskId": {
      "type": "string",
      "maxLength": 100,
      "description": "Task ID where the failure occurred"
    },
    "agentType": {
      "type": "string",
      "maxLength": 100,
      "description": "Agent type that experienced the failure"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of the failure (e.g. 2026-03-18T10:00:00Z)"
    }
  },
  "additionalProperties": false
}
