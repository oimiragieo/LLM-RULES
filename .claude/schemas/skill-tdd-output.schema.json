{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-tdd-output.schema.json",
  "title": "TDD Skill Output",
  "description": "Validates output from tdd skill invocation with Canon TDD evidence requirements",
  "type": "object",
  "required": ["output", "status"],
  "properties": {
    "output": {
      "type": "object",
      "description": "TDD cycle execution results",
      "required": ["redGreenRefactorCycle", "testResults"],
      "properties": {
        "testResults": {
          "type": "object",
          "required": ["total", "passed", "failed", "skipped"],
          "properties": {
            "total": {
              "type": "number",
              "minimum": 0
            },
            "passed": {
              "type": "number",
              "minimum": 0
            },
            "failed": {
              "type": "number",
              "minimum": 0
            },
            "skipped": {
              "type": "number",
              "minimum": 0
            },
            "testFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Test files executed"
            }
          }
        },
        "redGreenRefactorCycle": {
          "type": "object",
          "required": ["redPhaseVerified", "greenPhaseVerified", "refactorPhaseCompleted"],
          "properties": {
            "redPhaseVerified": {
              "type": "boolean",
              "description": "Test failed before implementation"
            },
            "greenPhaseVerified": {
              "type": "boolean",
              "description": "Test passed after minimal implementation"
            },
            "refactorPhaseCompleted": {
              "type": "boolean",
              "description": "Code refactored while keeping tests green"
            },
            "cycleCount": {
              "type": "number",
              "minimum": 1,
              "description": "Number of TDD cycles completed"
            }
          }
        },
        "scenarioBacklog": {
          "type": "object",
          "required": ["total", "completed"],
          "properties": {
            "total": {
              "type": "number",
              "minimum": 0
            },
            "completed": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "redCommand": {
              "type": "string"
            },
            "redFailureSummary": {
              "type": "string"
            },
            "greenCommand": {
              "type": "string"
            },
            "greenPassSummary": {
              "type": "string"
            }
          }
        },
        "repairAttempts": {
          "type": "number",
          "minimum": 0
        },
        "testHackingChecks": {
          "type": "object",
          "required": ["passed"],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "memoryProfileUpdated": {
          "type": "boolean",
          "description": "True when tdd-memory-profile was updated."
        },
        "memoryProfilePath": {
          "type": "string",
          "description": "Path to the tdd-memory-profile JSON."
        },
        "lintAndFormatPassed": {
          "type": "boolean",
          "description": "Configured lint and format commands completed successfully"
        },
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Production files created/modified"
        },
        "filesCreated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test files created"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false
}
