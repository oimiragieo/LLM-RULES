{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude-code.anthropic.com/schemas/agent-config",
  "title": "Agent Config",
  "description": "Per-agent default tools and thinking levels",
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "version": { "type": "string", "maxLength": 50 },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "maxLength": 100 }
          },
          "thinkingDefault": { "type": "string", "maxLength": 100 },
          "phase": { "type": "string", "maxLength": 100 },
          "model": { "type": "string", "maxLength": 100 }
        },
        "additionalProperties": false
      }
    },
    "thinkingBudgetMap": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "integer" }, { "type": "null" }] }
    }
  },
  "additionalProperties": false
}
