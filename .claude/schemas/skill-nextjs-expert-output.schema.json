{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Next.js Expert Output",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "nextjs-expert"
    },
    "version": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "const": "TypeScript"
        },
        "framework": {
          "const": "Next.js"
        },
        "nextVersion": {
          "type": "string",
          "description": "Next.js version (e.g., '14', '15')"
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content",
              "componentType"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "componentType": {
                "type": "string",
                "enum": [
                  "page",
                  "layout",
                  "server-component",
                  "client-component",
                  "api-route"
                ]
              },
              "rendering": {
                "type": "string",
                "enum": [
                  "SSR",
                  "SSG",
                  "ISR",
                  "CSR"
                ]
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routing": {
          "type": "object",
          "properties": {
            "appRouter": {
              "type": "boolean"
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
