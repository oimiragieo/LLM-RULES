{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkpoint Taxonomy Schema",
  "description": "Standardized checkpoint types for multi-wave pipeline execution",
  "type": "object",
  "properties": {
    "checkpoint_id": { "type": "string", "pattern": "^CP-[0-9]+$" },
    "type": {
      "type": "string",
      "enum": ["wave_complete", "phase_gate", "quality_gate", "rollback_point", "review_gate"]
    },
    "wave": { "type": "integer", "minimum": 1 },
    "tasks_completed": { "type": "array", "items": { "type": "string" } },
    "tasks_remaining": { "type": "array", "items": { "type": "string" } },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "gate_passed": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "required": ["checkpoint_id", "type", "wave", "timestamp", "gate_passed"]
}
