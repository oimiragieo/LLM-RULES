{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-insecure-defaults-output.schema.json",
  "title": "Insecure Defaults Skill Output",
  "description": "Verifiable output from the insecure-defaults skill proving credential detection and configuration auditing occurred",
  "type": "object",
  "required": ["status", "output"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Domain-specific output for insecure-defaults",
      "required": ["scan_scope", "findings_summary", "findings"],
      "properties": {
        "scan_scope": {
          "type": "object",
          "required": ["directories_scanned"],
          "properties": {
            "directories_scanned": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Directories that were scanned"
            },
            "file_types_checked": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "File extensions included in scan"
            },
            "config_files_audited": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Configuration files specifically audited"
            }
          },
          "additionalProperties": false
        },
        "findings_summary": {
          "type": "object",
          "required": ["total", "categories"],
          "properties": {
            "total": {
              "type": "number",
              "minimum": 0
            },
            "critical": {
              "type": "number",
              "minimum": 0
            },
            "high": {
              "type": "number",
              "minimum": 0
            },
            "medium": {
              "type": "number",
              "minimum": 0
            },
            "low": {
              "type": "number",
              "minimum": 0
            },
            "categories": {
              "type": "object",
              "properties": {
                "hardcoded_credentials": {
                  "type": "number",
                  "minimum": 0
                },
                "fail_open_patterns": {
                  "type": "number",
                  "minimum": 0
                },
                "insecure_config": {
                  "type": "number",
                  "minimum": 0
                },
                "weak_crypto": {
                  "type": "number",
                  "minimum": 0
                },
                "missing_security_headers": {
                  "type": "number",
                  "minimum": 0
                },
                "default_credentials": {
                  "type": "number",
                  "minimum": 0
                },
                "disabled_security_features": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "description": "Individual insecure default findings",
          "items": {
            "type": "object",
            "required": ["category", "severity", "description", "file"],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "hardcoded_credentials",
                  "fail_open",
                  "insecure_config",
                  "weak_crypto",
                  "missing_security_headers",
                  "default_credentials",
                  "disabled_security_features",
                  "overly_permissive"
                ]
              },
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
              },
              "description": {
                "type": "string",
                "description": "Description of the finding"
              },
              "file": {
                "type": "string",
                "description": "File path"
              },
              "line": {
                "type": "number",
                "minimum": 1,
                "description": "Line number (if applicable)"
              },
              "cwe": {
                "type": "string",
                "description": "CWE identifier"
              },
              "owasp": {
                "type": "string",
                "description": "OWASP category"
              },
              "current_value": {
                "type": "string",
                "description": "Current insecure value (redacted if credential)"
              },
              "recommended_value": {
                "type": "string",
                "description": "Secure alternative value or approach"
              },
              "remediation": {
                "type": "string",
                "description": "How to fix the finding"
              }
            },
            "additionalProperties": false
          }
        },
        "configuration_audit": {
          "type": "object",
          "description": "Configuration audit checklist results",
          "properties": {
            "credentials_clean": {
              "type": "boolean"
            },
            "network_secure": {
              "type": "boolean"
            },
            "auth_secure": {
              "type": "boolean"
            },
            "error_handling_secure": {
              "type": "boolean"
            },
            "infrastructure_secure": {
              "type": "boolean"
            },
            "checklist_items_passed": {
              "type": "number",
              "minimum": 0
            },
            "checklist_items_total": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
