{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "checklist-generator Output Schema",
  "description": "Output structure for checklist-generator skill",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "checklistMarkdown": {
          "type": "string",
          "description": "Complete checklist in markdown format with checkboxes"
        },
        "detectedContext": {
          "type": "object",
          "properties": {
            "framework": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "language": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "totalItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "ieeeBaseCount": {
          "type": "integer",
          "description": "Number of IEEE 1028 base items"
        },
        "contextualCount": {
          "type": "integer",
          "description": "Number of contextual AI-generated items"
        },
        "contextualPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 25,
          "description": "Percentage of contextual items (should be 10-20%)"
        },
        "generated": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "checklistMarkdown",
        "detectedContext",
        "totalItems",
        "ieeeBaseCount",
        "contextualCount"
      ]
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-checklist-generator-output.schema.json"
}
