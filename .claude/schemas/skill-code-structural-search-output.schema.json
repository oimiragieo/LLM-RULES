{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-code-structural-search-output.schema.json",
  "title": "Code Structural Search Skill Output",
  "description": "Validates output from code-structural-search skill - AST-based pattern matching",
  "type": "object",
  "required": [
    "output",
    "status"
  ],
  "properties": {
    "output": {
      "type": "object",
      "description": "Structural search results",
      "required": [
        "matches",
        "patterns",
        "astNodes"
      ],
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "lineStart",
              "pattern",
              "code"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "lineStart": {
                "type": "number",
                "minimum": 1
              },
              "lineEnd": {
                "type": "number",
                "minimum": 1
              },
              "column": {
                "type": "number",
                "minimum": 1
              },
              "pattern": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "nodeType": {
                "type": "string"
              },
              "context": {
                "type": "string"
              }
            }
          },
          "description": "Structural pattern matches found"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "matchCount"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "matchCount": {
                "type": "number",
                "minimum": 0
              },
              "description": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Patterns searched and their match counts"
        },
        "astNodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nodeType",
              "count"
            ],
            "properties": {
              "nodeType": {
                "type": "string",
                "description": "AST node type (e.g., FunctionDeclaration, ClassDeclaration)"
              },
              "count": {
                "type": "number",
                "minimum": 0
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "line"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "number",
                      "minimum": 1
                    },
                    "snippet": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "description": "AST node types found"
        },
        "searchMetadata": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "tool": {
              "type": "string",
              "enum": [
                "ast-grep",
                "tree-sitter",
                "babel"
              ]
            },
            "filesScanned": {
              "type": "number",
              "minimum": 0
            },
            "searchDurationMs": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "totalMatches",
            "filesMatched"
          ],
          "properties": {
            "totalMatches": {
              "type": "number",
              "minimum": 0
            },
            "filesMatched": {
              "type": "number",
              "minimum": 0
            },
            "patternsMatched": {
              "type": "number",
              "minimum": 0
            },
            "uniqueNodeTypes": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false
}
