{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-static-analysis-output.schema.json",
  "title": "Static Analysis Skill Output",
  "description": "Verifiable output from the static-analysis skill proving CodeQL/Semgrep scanning occurred with SARIF-structured results",
  "type": "object",
  "required": [
    "skill_name",
    "tools_used",
    "languages_scanned",
    "findings_summary",
    "findings",
    "timestamp"
  ],
  "properties": {
    "skill_name": {
      "type": "string",
      "const": "static-analysis",
      "description": "Must be 'static-analysis' to verify correct skill was used"
    },
    "tools_used": {
      "type": "array",
      "description": "Static analysis tools that were executed",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "rule_sets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "codeql",
              "semgrep"
            ],
            "description": "Tool name"
          },
          "version": {
            "type": "string",
            "description": "Tool version used"
          },
          "rule_sets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Rule sets or query suites executed"
          }
        },
        "additionalProperties": false
      }
    },
    "languages_scanned": {
      "type": "array",
      "description": "Programming languages analyzed",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "javascript",
          "typescript",
          "python",
          "java",
          "go",
          "c",
          "cpp",
          "csharp",
          "ruby",
          "swift",
          "php",
          "kotlin"
        ]
      }
    },
    "findings_summary": {
      "type": "object",
      "required": [
        "total",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0
        },
        "critical": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        },
        "medium": {
          "type": "number",
          "minimum": 0
        },
        "low": {
          "type": "number",
          "minimum": 0
        },
        "informational": {
          "type": "number",
          "minimum": 0
        },
        "false_positives": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "description": "Individual security findings",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "message",
          "file",
          "line"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "Rule or query identifier"
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFORMATIONAL"
            ]
          },
          "message": {
            "type": "string",
            "description": "Finding description"
          },
          "file": {
            "type": "string",
            "description": "File path where finding occurs"
          },
          "line": {
            "type": "number",
            "minimum": 1,
            "description": "Line number"
          },
          "column": {
            "type": "number",
            "minimum": 1,
            "description": "Column number"
          },
          "cwe": {
            "type": "string",
            "description": "CWE identifier (e.g., CWE-089)"
          },
          "owasp": {
            "type": "string",
            "description": "OWASP category (e.g., A03:2021)"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "remediation": {
            "type": "string",
            "description": "Suggested fix"
          },
          "false_positive": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "sarif_output_path": {
      "type": "string",
      "description": "Path to generated SARIF file"
    },
    "scan_metadata": {
      "type": "object",
      "properties": {
        "files_scanned": {
          "type": "number",
          "minimum": 0
        },
        "scan_duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "rules_evaluated": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of scan execution"
    }
  },
  "additionalProperties": false
}
