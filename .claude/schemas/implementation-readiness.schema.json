{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Implementation Readiness Schema",
  "description": "Schema for implementation readiness assessment",
  "type": "object",
  "properties": {
    "component": { "type": "string" },
    "readiness": { "type": "string", "enum": ["not-ready", "partially-ready", "ready"] },
    "issues": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["component", "readiness"]
}
