{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planning with Files Output",
  "description": "Output schema for planning-with-files skill",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "planning-with-files"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "output": {
      "type": "object",
      "required": [
        "taskId",
        "planFile",
        "findingsFile",
        "progressFile"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "planFile": {
          "type": "object",
          "required": [
            "path",
            "status",
            "lastUpdated",
            "steps"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to task_plan.md"
            },
            "status": {
              "type": "string",
              "enum": [
                "in_progress",
                "blocked",
                "complete"
              ]
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time"
            },
            "objective": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "number",
                  "description",
                  "status"
                ],
                "properties": {
                  "number": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "not_started",
                      "in_progress",
                      "done",
                      "blocked"
                    ]
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "blocker": {
                    "type": "string"
                  },
                  "needs": {
                    "type": "string"
                  }
                }
              }
            },
            "nextAction": {
              "type": "string",
              "description": "Single immediate next step"
            }
          }
        },
        "findingsFile": {
          "type": "object",
          "required": [
            "path",
            "lastUpdated",
            "findings"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to findings.md"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "context",
                  "finding",
                  "impact"
                ],
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  },
                  "finding": {
                    "type": "string"
                  },
                  "impact": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "progressFile": {
          "type": "object",
          "required": [
            "path",
            "lastUpdated",
            "completed"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to progress.md"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time"
            },
            "completed": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "step",
                  "duration",
                  "evidence"
                ],
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "step": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "percentComplete": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "totalSteps": {
              "type": "integer"
            },
            "completedSteps": {
              "type": "integer"
            },
            "blockedSteps": {
              "type": "integer"
            },
            "findingsCount": {
              "type": "integer"
            },
            "estimatedCompletion": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://agent-studio.dev/schemas/skill-planning-with-files-output.schema.json"
}
