{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Brief Schema",
  "description": "Schema for project brief documents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Name of the project",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "description": "Document version",
      "maxLength": 50
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation date"
    },
    "author": {
      "type": "string",
      "description": "Document author",
      "maxLength": 100
    },
    "executiveSummary": {
      "type": "string",
      "description": "High-level project summary",
      "maxLength": 2000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inScope": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "description": "What's included in the project"
        },
        "outOfScope": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "description": "What's not included in the project"
        }
      }
    },
    "objectives": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "Project objectives"
    },
    "stakeholders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productOwner": {
          "type": "string",
          "maxLength": 100
        },
        "technicalLead": {
          "type": "string",
          "maxLength": 100
        },
        "teamMembers": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "keyStakeholders": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "keyMilestones": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "successCriteria": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "How success will be measured"
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "mitigation": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "Key assumptions"
    },
    "resourcesRequired": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": {
          "type": "string",
          "description": "Team size and composition",
          "maxLength": 500
        },
        "technology": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "description": "Required technologies"
        },
        "budget": {
          "type": "string",
          "description": "Estimated budget",
          "maxLength": 200
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "Immediate next actions"
    }
  },
  "required": ["projectName", "executiveSummary", "objectives"]
}
