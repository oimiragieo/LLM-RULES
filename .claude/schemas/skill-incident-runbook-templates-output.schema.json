{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-incident-runbook-templates-output.schema.json",
  "title": "Incident Runbook Templates Skill Output",
  "description": "Output schema for incident response runbooks with procedures, escalation paths, and recovery actions",
  "type": "object",
  "required": ["status", "output"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "author": {
              "type": "string"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "string"
            },
            "agent": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
