{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-code-analyzer-output.schema.json",
  "title": "Code Analyzer Skill Output",
  "description": "Validates output from code-analyzer skill - Static analysis and metrics",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "timestamp",
    "output"
  ],
  "properties": {
    "skillName": {
      "type": "string",
      "const": "code-analyzer",
      "description": "Must be 'code-analyzer' to verify correct skill was used"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Skill version (semantic versioning)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of execution"
    },
    "output": {
      "type": "object",
      "description": "Code analysis results",
      "required": [
        "metrics",
        "complexity",
        "issues",
        "recommendations"
      ],
      "properties": {
        "metrics": {
          "type": "object",
          "required": [
            "loc",
            "filesAnalyzed"
          ],
          "properties": {
            "loc": {
              "type": "object",
              "required": [
                "total",
                "source",
                "comments"
              ],
              "properties": {
                "total": {
                  "type": "number",
                  "minimum": 0
                },
                "source": {
                  "type": "number",
                  "minimum": 0
                },
                "comments": {
                  "type": "number",
                  "minimum": 0
                },
                "blank": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "filesAnalyzed": {
              "type": "number",
              "minimum": 0
            },
            "maintainabilityIndex": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall maintainability score"
            }
          }
        },
        "complexity": {
          "type": "object",
          "required": [
            "average",
            "hotspots"
          ],
          "properties": {
            "average": {
              "type": "number",
              "minimum": 0,
              "description": "Average cyclomatic complexity"
            },
            "maximum": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum cyclomatic complexity found"
            },
            "hotspots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "function",
                  "complexity"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "function": {
                    "type": "string"
                  },
                  "line": {
                    "type": "number",
                    "minimum": 1
                  },
                  "complexity": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "description": "High-complexity functions requiring attention"
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "severity",
              "file",
              "description"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "complexity",
                  "duplication",
                  "smell",
                  "antipattern",
                  "vulnerability"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "number",
                "minimum": 1
              },
              "description": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              }
            }
          },
          "description": "Issues found during analysis"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "priority",
              "action"
            ],
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "action": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Recommended actions for improvement"
        },
        "duplicates": {
          "type": "object",
          "properties": {
            "blocksFound": {
              "type": "number",
              "minimum": 0
            },
            "percentageDuplicated": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
