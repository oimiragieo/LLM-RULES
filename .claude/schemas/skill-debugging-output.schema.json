{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-debugging-output.schema.json",
  "title": "Debugging Skill Output",
  "description": "Validates output from debugging skill invocation - Systematic debugging process verification",
  "type": "object",
  "required": ["output", "status"],
  "properties": {
    "output": {
      "type": "object",
      "description": "Debugging investigation results",
      "required": ["rootCause", "investigation", "fix", "verification"],
      "properties": {
        "rootCause": {
          "type": "object",
          "required": ["identified", "description"],
          "properties": {
            "identified": {
              "type": "boolean",
              "description": "Whether root cause was identified"
            },
            "description": {
              "type": "string",
              "minLength": 10,
              "description": "Root cause description"
            },
            "location": {
              "type": "string",
              "description": "File:line where root cause originates"
            },
            "symptom": {
              "type": "string",
              "description": "Original symptom observed"
            }
          }
        },
        "investigation": {
          "type": "object",
          "required": ["phasesCompleted"],
          "properties": {
            "phasesCompleted": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["root_cause", "pattern_analysis", "hypothesis", "implementation"]
              },
              "description": "Debugging phases completed"
            },
            "evidenceGathered": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "description"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["logs", "traces", "diffs", "diagnostics"]
                  },
                  "description": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  }
                }
              },
              "description": "Evidence gathered during investigation"
            },
            "hypothesesTested": {
              "type": "number",
              "minimum": 1,
              "description": "Number of hypotheses tested"
            }
          }
        },
        "fix": {
          "type": "object",
          "required": ["applied", "description"],
          "properties": {
            "applied": {
              "type": "boolean",
              "description": "Whether fix was applied"
            },
            "description": {
              "type": "string",
              "description": "Description of fix"
            },
            "filesModified": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files modified to fix issue"
            },
            "testAdded": {
              "type": "boolean",
              "description": "Whether regression test was added"
            }
          }
        },
        "verification": {
          "type": "object",
          "required": ["verified", "method"],
          "properties": {
            "verified": {
              "type": "boolean",
              "description": "Whether fix was verified"
            },
            "method": {
              "type": "string",
              "enum": ["test", "manual", "both"],
              "description": "Verification method used"
            },
            "testsPassing": {
              "type": "boolean",
              "description": "All tests passing after fix"
            },
            "symptomResolved": {
              "type": "boolean",
              "description": "Original symptom no longer occurs"
            }
          }
        },
        "architecturalIssue": {
          "type": "boolean",
          "description": "Whether 3+ fixes failed indicating architectural problem"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status of the skill"
    }
  },
  "additionalProperties": false
}
