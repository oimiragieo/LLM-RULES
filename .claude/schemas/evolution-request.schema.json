{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evolution Request",
  "description": "Standard payload for proposed ecosystem evolution requests.",
  "type": "object",
  "required": [
    "timestamp",
    "source",
    "trigger",
    "evidence",
    "suggestedArtifactType",
    "summary",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 4
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["reflection-agent", "recommend-evolution", "planner", "architect", "router", "other"]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "repeated_error",
        "no_agent",
        "integration_gap",
        "user_request",
        "rubric_regression",
        "stale_skill",
        "other"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 8
    },
    "suggestedArtifactType": {
      "type": ["string", "null"],
      "enum": ["skill", "agent", "workflow", "hook", "schema", "command", null]
    },
    "summary": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "type": "string",
      "enum": ["proposed"]
    },
    "targetArtifact": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["skill", "agent", "workflow", "hook", "schema", "command", "unknown"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
