{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-github-mcp-output",
  "title": "github-mcp Skill Output",
  "description": "Output schema for: GitHub API operations - repositories, issues, pull requests, actions, code security, discussions, gists, and more. Use for GitHub-related tasks like managing PRs, issues, searching code, and monitoring workflows.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Execution status"
    },
    "output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of skill execution"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": ["severity", "message"]
          }
        },
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["summary"]
    }
  },
  "required": ["status", "output"]
}
