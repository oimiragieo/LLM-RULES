{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-code-quality-expert-output.schema.json",
  "title": "Code Quality Expert Skill Output",
  "description": "Validates output from code-quality-expert skill - Code quality assessment and improvement suggestions",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "timestamp",
    "output"
  ],
  "properties": {
    "skillName": {
      "type": "string",
      "const": "code-quality-expert",
      "description": "Must be 'code-quality-expert' to verify correct skill was used"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Skill version (semantic versioning)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of execution"
    },
    "output": {
      "type": "object",
      "description": "Code quality assessment results",
      "required": [
        "score",
        "issues",
        "refactoringSuggestions"
      ],
      "properties": {
        "score": {
          "type": "object",
          "required": [
            "overall",
            "categories"
          ],
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall code quality score"
            },
            "categories": {
              "type": "object",
              "required": [
                "readability",
                "maintainability",
                "consistency"
              ],
              "properties": {
                "readability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "maintainability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "consistency": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "testability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "modularity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "severity",
              "description",
              "file"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "naming",
                  "structure",
                  "duplication",
                  "coupling",
                  "complexity",
                  "style"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "major",
                  "minor",
                  "info"
                ]
              },
              "description": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "number",
                "minimum": 1
              },
              "suggestion": {
                "type": "string"
              },
              "autoFixable": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "description": "Quality issues found"
        },
        "refactoringSuggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "priority",
              "type",
              "description"
            ],
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "extract_method",
                  "rename",
                  "reduce_complexity",
                  "remove_duplication",
                  "improve_naming",
                  "simplify_conditional"
                ]
              },
              "description": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "lineStart": {
                "type": "number",
                "minimum": 1
              },
              "lineEnd": {
                "type": "number",
                "minimum": 1
              },
              "rationale": {
                "type": "string"
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          },
          "description": "Suggested refactorings"
        },
        "bestPracticesViolations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "practice",
              "file",
              "description"
            ],
            "properties": {
              "practice": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "number",
                "minimum": 1
              },
              "description": {
                "type": "string"
              },
              "reference": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "description": "Best practice violations"
        },
        "filesAnalyzed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files included in analysis"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
