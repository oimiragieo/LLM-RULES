{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Go Expert Output",
  "type": "object",
  "required": [
    "skillName",
    "version",
    "output"
  ],
  "properties": {
    "skillName": {
      "const": "go-expert"
    },
    "version": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "language",
        "codeGenerated"
      ],
      "properties": {
        "language": {
          "const": "Go"
        },
        "goVersion": {
          "type": "string",
          "description": "Go version (e.g., '1.22')"
        },
        "codeGenerated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "content"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "exports": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concurrency": {
          "type": "object",
          "properties": {
            "goroutines": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
