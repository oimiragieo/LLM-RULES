{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-skill-creator-output.schema.json",
  "title": "Skill Creator Output",
  "description": "Schema for skill creation artifacts",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "skillPath": {
          "type": "string",
          "description": "Path to skill directory",
          "pattern": "^\\.claude/skills/[a-z][a-z0-9-]*/$"
        },
        "artifactsCreated": {
          "type": "object",
          "required": [
            "skillMd",
            "rules",
            "schema",
            "command"
          ],
          "properties": {
            "skillMd": {
              "type": "boolean",
              "description": "SKILL.md created"
            },
            "rules": {
              "type": "boolean",
              "description": "Rules file created"
            },
            "schema": {
              "type": "boolean",
              "description": "Output schema created"
            },
            "command": {
              "type": "boolean",
              "description": "Command file created"
            }
          }
        },
        "integrationsCompleted": {
          "type": "object",
          "required": [
            "catalogUpdated",
            "agentAssigned",
            "claudeMdUpdated"
          ],
          "properties": {
            "catalogUpdated": {
              "type": "boolean",
              "description": "Skill catalog entry added"
            },
            "agentAssigned": {
              "type": "boolean",
              "description": "At least one agent assigned"
            },
            "claudeMdUpdated": {
              "type": "boolean",
              "description": "CLAUDE.md routing updated (if applicable)"
            }
          }
        },
        "assignedAgents": {
          "type": "array",
          "description": "List of agents assigned this skill",
          "items": {
            "type": "string"
          }
        },
        "routingKeywords": {
          "type": "array",
          "description": "Keywords that route to this skill",
          "items": {
            "type": "string"
          }
        },
        "companionsNeeded": {
          "type": "array",
          "description": "Companion artifacts needed (hooks, templates, etc.)",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
