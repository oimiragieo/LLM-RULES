{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-definition.schema.json",
  "title": "Skill Definition Schema",
  "description": "Schema for validating Claude Code SKILL.md YAML frontmatter fields",
  "type": "object",
  "required": [],
  "additionalProperties": true,
  "anyOf": [
    {
      "required": ["name", "description"]
    },
    {
      "required": ["output"],
      "properties": {
        "output": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
            "description": { "type": "string", "minLength": 10, "maxLength": 1000 }
          }
        }
      }
    }
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Skill name in lowercase-with-hyphens format",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Clear description of what the skill does and when to invoke it"
    },
    "version": {
      "type": ["string", "number"],
      "description": "Skill version (e.g., '1.0.0' or 1.2)"
    },
    "model": {
      "type": "string",
      "enum": ["sonnet", "opus", "haiku", "inherit"],
      "default": "sonnet",
      "description": "Preferred model for this skill"
    },
    "invoked_by": {
      "type": "string",
      "enum": ["user", "agent", "both"],
      "default": "both",
      "description": "Who can invoke this skill"
    },
    "user_invocable": {
      "type": "boolean",
      "default": true,
      "description": "Whether users can invoke directly via /skill-name"
    },
    "tools": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "description": "Tools this skill is allowed to use"
    },
    "allowed-tools": {
      "type": "string",
      "description": "Comma-separated list of allowed tools (alternative to tools array)",
      "maxLength": 1000
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Alternative names for this skill"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "description": "Categorization tags for skill discovery"
    },
    "best_practices": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "Key best practices for this skill"
    },
    "error_handling": {
      "type": "string",
      "enum": ["graceful", "strict", "warn"],
      "default": "graceful",
      "description": "How errors are handled"
    },
    "streaming": {
      "type": "string",
      "enum": ["supported", "required", "disabled"],
      "default": "supported",
      "description": "Streaming output support"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the skill has been verified by the creator/updater workflow"
    },
    "lastVerifiedAt": {
      "type": "string",
      "description": "ISO timestamp of when the skill was last verified or updated"
    },
    "source": {
      "type": "string",
      "description": "Origin of skill (e.g., mcp-npm, custom, converted)",
      "maxLength": 200
    },
    "original_server": {
      "type": "string",
      "description": "Original MCP server name if converted from MCP tool",
      "maxLength": 200
    },
    "disable-model-invocation": {
      "type": "boolean",
      "description": "If true, the skill content is injected directly without LLM invocation"
    }
  }
}
