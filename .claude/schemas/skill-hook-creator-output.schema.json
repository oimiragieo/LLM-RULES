{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-studio.dev/schemas/skill-hook-creator-output.json",
  "title": "Hook Creator Output",
  "description": "Schema for hook creation artifacts",
  "type": "object",
  "required": [
    "hookName",
    "hookPath",
    "hookMode",
    "artifactsCreated",
    "integrationsCompleted"
  ],
  "properties": {
    "hookName": {
      "type": "string",
      "description": "Name of created hook",
      "pattern": "^[a-z][a-z0-9-]*\\.cjs$"
    },
    "hookPath": {
      "type": "string",
      "description": "Path to hook file",
      "pattern": "^\\.claude/hooks/[a-z]+/[a-z][a-z0-9-]*\\.cjs$"
    },
    "hookMode": {
      "type": "string",
      "enum": [
        "PreToolUse",
        "PostToolUse"
      ],
      "description": "Hook execution phase"
    },
    "priority": {
      "type": "number",
      "description": "Hook execution priority",
      "minimum": 1,
      "maximum": 100
    },
    "enforcementMode": {
      "type": "string",
      "enum": [
        "block",
        "warn",
        "off"
      ],
      "default": "warn",
      "description": "Hook enforcement level"
    },
    "artifactsCreated": {
      "type": "object",
      "required": [
        "hookFile",
        "settingsRegistration",
        "documentation"
      ],
      "properties": {
        "hookFile": {
          "type": "boolean"
        },
        "settingsRegistration": {
          "type": "boolean"
        },
        "documentation": {
          "type": "boolean"
        }
      }
    },
    "integrationsCompleted": {
      "type": "object",
      "required": [
        "enforcementHooksMdUpdated",
        "tested",
        "performanceValidated"
      ],
      "properties": {
        "enforcementHooksMdUpdated": {
          "type": "boolean"
        },
        "tested": {
          "type": "boolean"
        },
        "performanceValidated": {
          "type": "boolean"
        }
      }
    },
    "executionTimeMs": {
      "type": "number",
      "description": "Measured execution time in milliseconds",
      "maximum": 100
    }
  },
  "additionalProperties": false
}
