{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.dev/schemas/skill-workflow-creator-output.schema.json",
  "title": "Workflow Creator Output",
  "description": "Schema for workflow creation artifacts",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "properties": {
        "workflowName": {
          "type": "string",
          "description": "Name of created workflow (kebab-case)",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "workflowPath": {
          "type": "string",
          "description": "Path to workflow file",
          "pattern": "^\\.claude/workflows/[a-z]+/[a-z][a-z0-9-]*\\.md$"
        },
        "phases": {
          "type": "array",
          "description": "Workflow phases",
          "items": {
            "type": "object",
            "required": [
              "name",
              "agents",
              "outputs"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "artifactsCreated": {
          "type": "object",
          "required": [
            "workflowFile",
            "documentationUpdated",
            "agentMapUpdated"
          ],
          "properties": {
            "workflowFile": {
              "type": "boolean"
            },
            "documentationUpdated": {
              "type": "boolean"
            },
            "agentMapUpdated": {
              "type": "boolean"
            }
          }
        },
        "integrationsCompleted": {
          "type": "object",
          "required": [
            "enterpriseWorkflowsUpdated",
            "qualityGatesDefined",
            "tested"
          ],
          "properties": {
            "enterpriseWorkflowsUpdated": {
              "type": "boolean"
            },
            "qualityGatesDefined": {
              "type": "boolean"
            },
            "tested": {
              "type": "boolean"
            }
          }
        },
        "participatingAgents": {
          "type": "array",
          "description": "Agents participating in workflow",
          "items": {
            "type": "string"
          }
        },
        "qualityGates": {
          "type": "array",
          "description": "Quality gates defined",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "workflowName",
        "workflowPath",
        "phases",
        "artifactsCreated",
        "integrationsCompleted"
      ]
    }
  },
  "additionalProperties": false
}
