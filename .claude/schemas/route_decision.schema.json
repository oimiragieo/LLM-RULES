{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route Decision Schema",
  "description": "Schema for routing decisions",
  "type": "object",
  "properties": {
    "input": {"type": "string"},
    "decision": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reasoning": {"type": "string"},
    "agent": {"type": "string"}
  },
  "required": ["input", "decision", "agent"]
}
