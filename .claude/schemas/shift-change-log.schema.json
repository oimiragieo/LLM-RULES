{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "handoffId", "generation", "status", "sessionId", "timestamp"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "handoffId": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["WRITING", "READY", "CLAIMED", "SUPERSEDED", "FAILED"]
    },
    "sessionId": {
      "type": "string"
    },
    "activePid": {
      "type": "integer"
    },
    "currentObjective": {
      "type": "string"
    },
    "contextPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "contextSummary": {
      "type": "string"
    },
    "memoryPointers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": ["file", "key", "summary"]
      }
    },
    "pendingActions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["taskId", "description", "priority"]
      }
    },
    "subagentStates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "agentType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "outputFile": {
            "type": "string"
          }
        },
        "required": ["taskId", "agentType", "status", "outputFile"]
      }
    },
    "resumeInstructions": {
      "type": "string"
    },
    "pendingMemoryWrites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallbackInstruction": {
      "type": "string"
    },
    "drainDeadline": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
