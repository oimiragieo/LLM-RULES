{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://claude-code.anthropic.com/schemas/skillcatalog-response",
  "title": "SkillCatalog Response",
  "description": "Schema for validating skill catalog query responses",
  "type": "object",
  "required": ["success"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the query executed successfully (true even if 0 results)"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillResult"
      },
      "description": "Array of matching skills"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of skills returned"
    },
    "query": {
      "$ref": "skillcatalog-query.schema.json",
      "description": "Echo of the original query for reference"
    },
    "suggestions": {
      "$ref": "#/$defs/Suggestions",
      "description": "Alternative queries when count is 0 or error occurred"
    },
    "metadata": {
      "$ref": "#/$defs/ResponseMetadata",
      "description": "Query execution metadata"
    },
    "error": {
      "type": "string",
      "description": "Error message when success is false"
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_DOMAIN",
        "INVALID_CATEGORY",
        "INVALID_LIMIT",
        "INVALID_AGENT_TYPE",
        "INVALID_TAGS",
        "SKILL_INDEX_ERROR",
        "QUERY_TIMEOUT",
        "UNKNOWN_ERROR"
      ],
      "description": "Error code for programmatic handling"
    }
  },
  "if": {
    "properties": {
      "success": { "const": true }
    }
  },
  "then": {
    "required": ["success", "skills", "count", "query"]
  },
  "else": {
    "required": ["success", "error", "code"]
  },
  "$defs": {
    "SkillResult": {
      "type": "object",
      "required": ["name", "domain", "category", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Skill name in kebab-case (e.g., 'tdd', 'security-architect')"
        },
        "domain": {
          "type": "string",
          "description": "Skill domain for categorization"
        },
        "category": {
          "type": "string",
          "description": "Skill category for fine-grained grouping"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Brief description of what the skill does"
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools required by this skill (Read, Write, Bash, etc.)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Categorization tags for filtering"
        },
        "recommended": {
          "type": "boolean",
          "description": "Whether this skill is recommended for the querying agent type"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Related skill names for discovery"
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "Whether this skill is deprecated"
        },
        "supersededBy": {
          "type": "string",
          "description": "If deprecated, the skill that supersedes this one"
        }
      },
      "additionalProperties": false
    },
    "Suggestions": {
      "type": "object",
      "required": ["message", "alternatives"],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable explanation of why no results were found"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "skillcatalog-query.schema.json"
          },
          "maxItems": 3,
          "description": "Alternative queries that may return results"
        }
      },
      "additionalProperties": false
    },
    "ResponseMetadata": {
      "type": "object",
      "properties": {
        "fromCache": {
          "type": "boolean",
          "description": "Whether result was served from cache"
        },
        "queryTimeMs": {
          "type": "number",
          "minimum": 0,
          "description": "Query execution time in milliseconds"
        },
        "cacheAge": {
          "type": "integer",
          "minimum": 0,
          "description": "Age of cached result in milliseconds (if fromCache is true)"
        },
        "totalSkillsSearched": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of skills searched before filtering"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "success": true,
      "skills": [
        {
          "name": "tdd",
          "domain": "testing",
          "category": "core-development",
          "description": "Test-Driven Development with Iron Laws enforcement",
          "requiredTools": ["Read", "Write", "Edit", "Bash", "Glob", "Grep"],
          "tags": ["testing", "tdd", "quality"],
          "recommended": true
        }
      ],
      "count": 1,
      "query": {
        "domain": "testing",
        "limit": 5
      },
      "metadata": {
        "fromCache": false,
        "queryTimeMs": 45.2
      }
    },
    {
      "success": true,
      "skills": [],
      "count": 0,
      "query": {
        "domain": "nonexistent"
      },
      "suggestions": {
        "message": "No skills found for domain: 'nonexistent'",
        "alternatives": [
          { "domain": "testing" },
          { "domain": "security" },
          { "category": "core-development" }
        ]
      }
    },
    {
      "success": false,
      "error": "Invalid option: limit must be between 1 and 50 (got 100)",
      "code": "INVALID_LIMIT",
      "suggestions": {
        "message": "Adjust your query parameters",
        "alternatives": [
          { "limit": 50 }
        ]
      }
    }
  ]
}
