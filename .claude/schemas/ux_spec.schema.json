{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UX Specification Schema",
  "description": "Schema for user experience specification documents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentTitle": {
      "type": "string",
      "description": "Full document title",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "description": "Document version",
      "maxLength": 50
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation date"
    },
    "author": {
      "type": "string",
      "description": "Document author",
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved"],
      "description": "Document status"
    },
    "featureDescription": {
      "type": "string",
      "description": "Brief description of the feature/page",
      "maxLength": 2000
    },
    "userStories": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "Related user stories"
    },
    "acceptanceCriteria": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "Acceptance criteria for the UI"
    },
    "userExperience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userJourney": {
          "type": "string",
          "description": "Describe the user flow",
          "maxLength": 2000
        },
        "keyInteractions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "description": "Primary user interactions and behaviors"
        },
        "errorStates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "description": "How errors are handled and displayed"
        },
        "loadingStates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "description": "Loading indicators and states"
        }
      }
    },
    "visualDesign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designSystem": {
          "type": "string",
          "description": "Reference to design system or style guide",
          "maxLength": 500
        },
        "colorPalette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "maxLength": 100
            },
            "secondary": {
              "type": "string",
              "maxLength": 100
            },
            "accent": {
              "type": "string",
              "maxLength": 100
            },
            "neutral": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headings": {
              "type": "string",
              "maxLength": 200
            },
            "bodyText": {
              "type": "string",
              "maxLength": 200
            },
            "labels": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "spacing": {
          "type": "string",
          "description": "Spacing scale and guidelines",
          "maxLength": 500
        },
        "icons": {
          "type": "string",
          "description": "Icon set and usage guidelines",
          "maxLength": 500
        }
      }
    },
    "componentSpecifications": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "states": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default": {
                "type": "string",
                "maxLength": 200
              },
              "hover": {
                "type": "string",
                "maxLength": 200
              },
              "active": {
                "type": "string",
                "maxLength": 200
              },
              "disabled": {
                "type": "string",
                "maxLength": 200
              },
              "error": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "size": {
                "type": "string",
                "maxLength": 100
              },
              "variant": {
                "type": "string",
                "maxLength": 100
              },
              "content": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "interactions": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "required": ["name"]
      }
    },
    "responsiveDesign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breakpoints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mobile": {
              "type": "string",
              "maxLength": 100
            },
            "tablet": {
              "type": "string",
              "maxLength": 100
            },
            "desktop": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "layoutAdaptations": {
          "type": "string",
          "description": "How the layout changes across breakpoints",
          "maxLength": 2000
        },
        "touchTargets": {
          "type": "string",
          "description": "Minimum touch target sizes for mobile",
          "maxLength": 500
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wcagCompliance": {
          "type": "string",
          "description": "WCAG level targeted",
          "maxLength": 100
        },
        "keyboardNavigation": {
          "type": "string",
          "description": "Keyboard navigation requirements",
          "maxLength": 1000
        },
        "screenReaderSupport": {
          "type": "string",
          "description": "Screen reader announcements and labels",
          "maxLength": 1000
        },
        "colorContrast": {
          "type": "string",
          "description": "Contrast ratio requirements",
          "maxLength": 500
        },
        "focusManagement": {
          "type": "string",
          "description": "Focus indicators and management",
          "maxLength": 1000
        }
      }
    },
    "implementationNotes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technicalConsiderations": {
          "type": "string",
          "maxLength": 2000
        },
        "browserSupport": {
          "type": "string",
          "maxLength": 500
        },
        "performanceConsiderations": {
          "type": "string",
          "maxLength": 2000
        },
        "testingChecklist": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "wireframes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "screenName": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "imagePath": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  },
  "required": ["documentTitle", "featureDescription"]
}
