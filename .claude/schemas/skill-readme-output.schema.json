{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-studio.dev/schemas/skill-readme-output.json",
  "title": "README Generator Output",
  "description": "Validation schema for readme skill output",
  "type": "object",
  "required": [
    "status",
    "output"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Execution status of the skill"
    },
    "output": {
      "type": "object",
      "description": "Skill-specific output data",
      "required": [
        "readmeFile",
        "sectionsIncluded"
      ],
      "properties": {
        "readmeFile": {
          "type": "string",
          "description": "Path to generated/updated README.md file"
        },
        "sectionsIncluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "title",
              "description",
              "installation",
              "usage",
              "features",
              "configuration",
              "examples",
              "api-reference",
              "contributing",
              "license",
              "troubleshooting",
              "badges",
              "screenshots",
              "prerequisites",
              "development",
              "deployment",
              "faq"
            ]
          },
          "description": "README sections that were generated"
        },
        "badgesIncluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "build",
                  "coverage",
                  "version",
                  "license",
                  "downloads",
                  "dependencies"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          },
          "description": "Status badges included in README"
        },
        "codeExamples": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of code examples included"
        },
        "installationMethods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "npm",
              "pnpm",
              "yarn",
              "pip",
              "cargo",
              "go-get",
              "docker",
              "binary-download",
              "source-build"
            ]
          },
          "description": "Installation methods documented"
        },
        "linksValidated": {
          "type": "boolean",
          "description": "Whether all links in README are valid"
        },
        "tocGenerated": {
          "type": "boolean",
          "description": "Whether table of contents was generated"
        },
        "projectMetadata": {
          "type": "object",
          "properties": {
            "projectName": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "framework": {
              "type": "string"
            },
            "license": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "qualityChecks": {
          "type": "object",
          "properties": {
            "hasInstallInstructions": {
              "type": "boolean"
            },
            "hasUsageExamples": {
              "type": "boolean"
            },
            "hasContributing": {
              "type": "boolean"
            },
            "hasLicense": {
              "type": "boolean"
            },
            "allLinksValid": {
              "type": "boolean"
            },
            "codeBlocksSyntaxValid": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "generated": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
