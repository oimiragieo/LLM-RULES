{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codebaseExplorationInput",
  "description": "Input schema for codebase-exploration skill",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "repoPath": {
      "type": "string",
      "description": "Path to repository root"
    },
    "question": {
      "type": "string",
      "description": "Specific question to answer about the codebase"
    },
    "tokenBudget": {
      "type": "integer",
      "description": "Maximum tokens to use (default 34000)"
    },
    "outputPath": {
      "type": "string",
      "description": "Path to write the exploration report"
    }
  }
}
