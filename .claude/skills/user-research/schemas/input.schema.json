{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "userResearchInput",
  "description": "Input schema for user-research skill",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "target": {
      "type": "string",
      "description": "Target product, feature, or interface for research"
    },
    "method": {
      "type": "string",
      "description": "Research method (heuristic-evaluation, interview, usability-test, survey)"
    },
    "options": {
      "type": "object",
      "description": "Research options",
      "additionalProperties": true
    }
  }
}
