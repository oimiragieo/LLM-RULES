{
  "metadata": {
    "level": "error",
    "requiredFields": ["name", "description", "author", "version", "license"],
    "allowedLicenses": [
      "MIT",
      "Apache-2.0",
      "ISC",
      "BSD-3-Clause",
      "GPL-3.0",
      "LGPL-3.0",
      "MPL-2.0"
    ],
    "requireMetadataSection": true
  },
  "structure": {
    "level": "error",
    "requiredSections": ["Explanation"],
    "requiredExamples": ["Wrong", "Right", "Bad", "Good", "Incorrect", "Correct"],
    "minCodeBlocks": 2,
    "minLength": 50
  },
  "duplicates": {
    "level": "error",
    "checkTitles": true,
    "checkFilenames": true
  }
}
