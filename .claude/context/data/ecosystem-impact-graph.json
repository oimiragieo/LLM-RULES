{
  "version": "1.1.0",
  "description": "Ecosystem impact graph mapping artifact types to their required downstream integrations",
  "lastUpdated": "2026-02-08",
  "companionMatrix": {
    "agent": {
      "required": [
        {
          "type": "registry-entry",
          "check": "json-key-exists",
          "target": ".claude/context/agent-registry.json",
          "pattern": "{name}",
          "description": "Agent must be registered in agent-registry.json"
        },
        {
          "type": "routing-keywords",
          "check": "grep-in-file",
          "target": ".claude/lib/routing/routing-table.cjs",
          "pattern": "{name}",
          "description": "Agent must have routing keywords in routing-table.cjs"
        }
      ],
      "recommended": [
        {
          "type": "skill-assignment",
          "check": "glob-match",
          "target": ".claude/skills/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Agent should have assigned skills"
        },
        {
          "type": "claude-md-entry",
          "check": "grep-in-file",
          "target": ".claude/CLAUDE.md",
          "pattern": "{name}",
          "description": "Agent should be referenced in CLAUDE.md routing table"
        }
      ],
      "optional": [
        {
          "type": "command",
          "check": "file-exists",
          "target": ".claude/commands/{name}.md",
          "pattern": "{name}",
          "description": "Agent may have a slash command"
        },
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Agent may have behavior tests"
        }
      ]
    },
    "skill": {
      "required": [
        {
          "type": "catalog-entry",
          "check": "grep-in-file",
          "target": ".claude/context/artifacts/catalogs/skill-catalog.md",
          "pattern": "{name}",
          "description": "Skill must be cataloged in skill-catalog.md"
        },
        {
          "type": "agent-assignment",
          "check": "grep-in-file",
          "target": ".claude/agents/**/*.md",
          "pattern": "{name}",
          "description": "Skill must be assigned to at least one agent"
        }
      ],
      "recommended": [
        {
          "type": "command",
          "check": "file-exists",
          "target": ".claude/commands/{name}.md",
          "pattern": "{name}",
          "description": "Skill should have a user-invocable command"
        }
      ],
      "optional": [
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Skill may have behavior tests"
        },
        {
          "type": "schema",
          "check": "file-exists",
          "target": ".claude/schemas/skill-{name}.json",
          "pattern": "skill-{name}",
          "description": "Skill may have a JSON schema"
        }
      ]
    },
    "hook": {
      "required": [
        {
          "type": "settings-registration",
          "check": "settings-registered",
          "target": ".claude/settings.json",
          "pattern": "{name}",
          "description": "Hook must be registered in settings.json hooks array"
        },
        {
          "type": "enforcement-docs",
          "check": "grep-in-file",
          "target": ".claude/docs/@ENFORCEMENT_HOOKS.md",
          "pattern": "{name}",
          "description": "Hook must be documented in ENFORCEMENT_HOOKS.md"
        }
      ],
      "recommended": [
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Hook should have behavior tests"
        }
      ],
      "optional": [
        {
          "type": "hook-agent-map",
          "check": "grep-in-file",
          "target": ".claude/docs/@HOOK_AGENT_MAP.md",
          "pattern": "{name}",
          "description": "Hook may be mapped to agents"
        }
      ]
    },
    "workflow": {
      "required": [
        {
          "type": "workflow-registry",
          "check": "grep-in-file",
          "target": ".claude/docs/@ENTERPRISE_WORKFLOWS.md",
          "pattern": "{name}",
          "description": "Workflow must be registered in ENTERPRISE_WORKFLOWS.md"
        }
      ],
      "recommended": [
        {
          "type": "agent-map",
          "check": "grep-in-file",
          "target": ".claude/docs/@WORKFLOW_AGENT_MAP.md",
          "pattern": "{name}",
          "description": "Workflow should be mapped to responsible agents"
        },
        {
          "type": "triggering-conditions",
          "check": "grep-in-file",
          "target": ".claude/workflows/core/router-decision.md",
          "pattern": "{name}",
          "description": "Workflow should have triggering conditions in router-decision.md"
        }
      ],
      "optional": [
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Workflow may have behavior tests"
        }
      ]
    },
    "command": {
      "required": [
        {
          "type": "skill-linkage",
          "check": "grep-in-file",
          "target": ".claude/commands/{name}.md",
          "pattern": "skill",
          "description": "Command must reference a backing skill"
        },
        {
          "type": "catalog-entry",
          "check": "grep-in-file",
          "target": ".claude/context/artifacts/catalogs/command-catalog.md",
          "pattern": "{name}",
          "description": "Command must be cataloged in command-catalog.md"
        }
      ],
      "recommended": [
        {
          "type": "claude-md-entry",
          "check": "grep-in-file",
          "target": ".claude/CLAUDE.md",
          "pattern": "{name}",
          "description": "Command should be referenced in CLAUDE.md Section 7.1"
        }
      ],
      "optional": [
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Command may have invocation tests"
        }
      ]
    },
    "rule": {
      "required": [
        {
          "type": "rules-directory",
          "check": "file-exists",
          "target": ".claude/rules/{name}.md",
          "pattern": "{name}",
          "description": "Rule must exist in .claude/rules/ directory"
        }
      ],
      "recommended": [
        {
          "type": "agent-acknowledgment",
          "check": "grep-in-file",
          "target": ".claude/agents/**/*.md",
          "pattern": "{name}",
          "description": "Rule should be acknowledged by relevant agents"
        },
        {
          "type": "enforcement-hook",
          "check": "grep-in-file",
          "target": ".claude/hooks/**/*.cjs",
          "pattern": "{name}",
          "description": "Rule should have an enforcement hook"
        }
      ],
      "optional": [
        {
          "type": "claude-md-entry",
          "check": "grep-in-file",
          "target": ".claude/CLAUDE.md",
          "pattern": "{name}",
          "description": "Rule may be referenced in CLAUDE.md"
        }
      ]
    },
    "tool": {
      "required": [
        {
          "type": "tool-catalog-entry",
          "check": "grep-in-file",
          "target": ".claude/context/artifacts/catalogs/tool-catalog.md",
          "pattern": "{name}",
          "description": "Tool must be cataloged in tool-catalog.md"
        }
      ],
      "recommended": [
        {
          "type": "agent-awareness",
          "check": "grep-in-file",
          "target": ".claude/agents/**/*.md",
          "pattern": "{name}",
          "description": "Tool should be known to relevant agents"
        },
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Tool should have behavior tests"
        }
      ],
      "optional": [
        {
          "type": "documentation",
          "check": "grep-in-file",
          "target": ".claude/docs/**/*.md",
          "pattern": "{name}",
          "description": "Tool may have reference documentation"
        }
      ]
    },
    "template": {
      "required": [
        {
          "type": "template-catalog-entry",
          "check": "grep-in-file",
          "target": ".claude/context/artifacts/catalogs/template-catalog.md",
          "pattern": "{name}",
          "description": "Template must be cataloged in template-catalog.md"
        }
      ],
      "recommended": [
        {
          "type": "consuming-skill",
          "check": "grep-in-file",
          "target": ".claude/skills/**/SKILL.md",
          "pattern": "{name}",
          "description": "Template should be consumed by at least one skill"
        }
      ],
      "optional": [
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Template may have rendering tests"
        }
      ]
    },
    "schema": {
      "required": [
        {
          "type": "schema-catalog-entry",
          "check": "grep-in-file",
          "target": ".claude/context/artifacts/catalogs/schema-catalog.md",
          "pattern": "{name}",
          "description": "Schema must be cataloged in schema-catalog.md"
        }
      ],
      "recommended": [
        {
          "type": "validating-hook",
          "check": "grep-in-file",
          "target": ".claude/hooks/**/*.cjs",
          "pattern": "{name}",
          "description": "Schema should have a validation hook"
        },
        {
          "type": "consuming-skill",
          "check": "grep-in-file",
          "target": ".claude/skills/**/SKILL.md",
          "pattern": "{name}",
          "description": "Schema should be consumed by at least one skill"
        }
      ],
      "optional": [
        {
          "type": "tests",
          "check": "glob-match",
          "target": "tests/**/*{name}*",
          "pattern": "**/*{name}*",
          "description": "Schema may have validation tests"
        }
      ]
    }
  },
  "artifactTypes": {
    "agent": {
      "mustHave": [
        {
          "action": "update-routing-table",
          "target": ".claude/lib/routing/routing-table.cjs",
          "description": "Add routing keywords for new agent"
        },
        {
          "action": "update-agent-registry",
          "target": ".claude/context/agent-registry.json",
          "description": "Register agent in agent-registry.json"
        },
        {
          "action": "update-agent-config",
          "target": ".claude/context/runtime/agent-config.json",
          "description": "Add agent to runtime config"
        },
        {
          "action": "update-claude-md",
          "target": ".claude/CLAUDE.md",
          "description": "Add agent to routing table in CLAUDE.md Section 3"
        }
      ],
      "shouldHave": [
        {
          "action": "assign-skills",
          "trigger": "skill-creator",
          "condition": "Agent needs specialized skills"
        },
        {
          "action": "create-hooks",
          "trigger": "hook-creator",
          "condition": "Agent needs custom enforcement hooks"
        },
        {
          "action": "create-workflows",
          "trigger": "workflow-creator",
          "condition": "Agent needs custom workflows"
        },
        {
          "action": "create-commands",
          "trigger": "command-creator",
          "condition": "Agent should be invocable via slash command"
        }
      ],
      "niceToHave": [
        {
          "action": "add-identity",
          "target": ".claude/templates/spawn/agent-identity-integration.md",
          "description": "Add personality frontmatter"
        },
        {
          "action": "add-test",
          "target": "tests/agents/",
          "description": "Add agent behavior tests"
        }
      ]
    },
    "skill": {
      "mustHave": [
        {
          "action": "update-claude-md",
          "target": ".claude/CLAUDE.md",
          "description": "Reference skill in CLAUDE.md Section 7 or 8.5"
        },
        {
          "action": "update-skill-catalog",
          "target": ".claude/context/artifacts/catalogs/skill-catalog.md",
          "description": "Add entry to skill catalog"
        },
        {
          "action": "assign-to-agent",
          "target": ".claude/context/agent-registry.json",
          "description": "Assign skill to at least one agent"
        },
        {
          "action": "update-skill-index",
          "target": ".claude/context/artifacts/catalogs/skill-index.md",
          "description": "Add to skill index if it exists"
        }
      ],
      "shouldHave": [
        {
          "action": "create-command",
          "trigger": "command-creator",
          "condition": "Skill should be user-invocable via /command"
        },
        {
          "action": "validate-schema",
          "target": ".claude/schemas/skill-definition.schema.json",
          "description": "Validate frontmatter against schema"
        }
      ],
      "niceToHave": [
        {
          "action": "add-test",
          "target": "tests/skills/",
          "description": "Add skill behavior tests"
        },
        {
          "action": "update-memory",
          "target": ".claude/context/memory/learnings.md",
          "description": "Record skill creation in learnings"
        }
      ]
    },
    "hook": {
      "mustHave": [
        {
          "action": "register-in-settings",
          "target": ".claude/settings.json",
          "description": "Register hook in settings.json hooks array"
        },
        {
          "action": "update-hook-agent-map",
          "target": ".claude/docs/@HOOK_AGENT_MAP.md",
          "description": "Add hook to hook-agent mapping"
        },
        {
          "action": "add-test",
          "target": "tests/hooks/",
          "description": "Create test file for the hook"
        }
      ],
      "shouldHave": [
        {
          "action": "update-enforcement-hooks",
          "target": ".claude/docs/@ENFORCEMENT_HOOKS.md",
          "description": "Document in enforcement hooks reference"
        },
        {
          "action": "update-hooks-reference",
          "target": ".claude/docs/HOOKS_REFERENCE.md",
          "description": "Add to hooks reference documentation"
        }
      ],
      "niceToHave": [
        {
          "action": "update-memory",
          "target": ".claude/context/memory/learnings.md",
          "description": "Record hook creation pattern"
        }
      ]
    },
    "workflow": {
      "mustHave": [
        {
          "action": "update-claude-md",
          "target": ".claude/CLAUDE.md",
          "description": "Reference workflow in CLAUDE.md Section 8.6"
        },
        {
          "action": "update-workflow-agent-map",
          "target": ".claude/docs/@WORKFLOW_AGENT_MAP.md",
          "description": "Map workflow to responsible agents"
        }
      ],
      "shouldHave": [
        {
          "action": "update-agent-workflows",
          "trigger": "agent-creator",
          "condition": "Agents need workflow section updates"
        },
        {
          "action": "create-command",
          "trigger": "command-creator",
          "condition": "Workflow should be user-invocable"
        }
      ],
      "niceToHave": [
        {
          "action": "add-diagram",
          "target": ".claude/context/artifacts/diagrams/",
          "description": "Create workflow diagram"
        },
        {
          "action": "update-memory",
          "target": ".claude/context/memory/decisions.md",
          "description": "Record workflow design decisions"
        }
      ]
    },
    "template": {
      "mustHave": [
        {
          "action": "update-template-catalog",
          "target": ".claude/context/artifacts/catalogs/template-catalog.md",
          "description": "Add entry to template catalog"
        },
        {
          "action": "add-readme",
          "target": "README.md in template directory",
          "description": "Document template usage"
        },
        {
          "action": "verify-consumers",
          "target": "consuming skills/workflows",
          "description": "Ensure at least one consumer references the template"
        }
      ],
      "shouldHave": [
        { "action": "add-placeholders-doc", "description": "Document all placeholder variables" }
      ],
      "niceToHave": [
        {
          "action": "add-test",
          "target": "tests/templates/",
          "description": "Add template rendering tests"
        }
      ]
    },
    "schema": {
      "mustHave": [
        {
          "action": "update-schema-catalog",
          "target": ".claude/context/artifacts/catalogs/schema-catalog.md",
          "description": "Add entry to schema catalog"
        }
      ],
      "shouldHave": [
        {
          "action": "wire-validator",
          "description": "Wire schema to a validation hook or creator"
        },
        {
          "action": "add-test",
          "target": "tests/schemas/",
          "description": "Add schema validation tests"
        }
      ],
      "niceToHave": [
        {
          "action": "update-memory",
          "target": ".claude/context/memory/learnings.md",
          "description": "Record schema design decisions"
        }
      ]
    },
    "command": {
      "mustHave": [
        {
          "action": "update-command-catalog",
          "target": ".claude/context/artifacts/catalogs/command-catalog.md",
          "description": "Add entry to command catalog"
        },
        {
          "action": "verify-backing-skill",
          "description": "Ensure backing skill exists in .claude/skills/"
        }
      ],
      "shouldHave": [
        {
          "action": "update-claude-md",
          "target": ".claude/CLAUDE.md",
          "description": "Add to CLAUDE.md Section 7.1 key commands list"
        }
      ],
      "niceToHave": [
        {
          "action": "add-test",
          "target": "tests/commands/",
          "description": "Add command invocation tests"
        }
      ]
    },
    "rule": {
      "mustHave": [
        {
          "action": "validate-content-structure",
          "description": "Ensure rule has heading, bullet points, and actionable items"
        }
      ],
      "shouldHave": [
        {
          "action": "check-conflict",
          "description": "Check for conflicts with existing rules in .claude/rules/"
        }
      ],
      "niceToHave": [
        {
          "action": "update-memory",
          "target": ".claude/context/memory/decisions.md",
          "description": "Record rule rationale as ADR"
        }
      ]
    },
    "tool": {
      "mustHave": [
        {
          "action": "update-tool-catalog",
          "target": ".claude/context/artifacts/catalogs/tool-catalog.md",
          "description": "Add entry to tool catalog"
        }
      ],
      "shouldHave": [
        {
          "action": "add-package-script",
          "target": "package.json",
          "description": "Add npm script for CLI-invocable tools"
        },
        {
          "action": "wire-to-skill",
          "trigger": "skill-creator",
          "condition": "Tool should be skill-backed"
        }
      ],
      "niceToHave": [
        {
          "action": "add-test",
          "target": "tests/tools/",
          "description": "Add tool behavior tests"
        },
        {
          "action": "update-memory",
          "target": ".claude/context/memory/learnings.md",
          "description": "Record tool creation pattern"
        }
      ]
    }
  }
}
